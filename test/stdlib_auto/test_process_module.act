# The process module stays for programs that still import it, next to
# env.process. Both process.Process and process.RunProcess must keep working.
import process

actor main(env):
    var left = 2

    def done():
        left -= 1
        if left == 0:
            env.exit(0)

    def on_stdout(p, data: ?bytes):
        if data == b"HELLO\n":
            done()
        elif data is not None:
            print("Unexpected output from process.Process:", data)
            env.exit(1)

    def on_stderr(p, data: ?bytes):
        pass

    def on_exit(p, exit_code: int, term_signal: int):
        if exit_code != 0:
            print("process.Process exited with", exit_code, term_signal)
            env.exit(1)

    def on_run_exit(p, exit_code: int, term_signal: int, stdout_buf: bytes, stderr_buf: bytes):
        if exit_code != 0 or stdout_buf != b"HELLO\n":
            print("process.RunProcess got", exit_code, term_signal, stdout_buf)
            env.exit(1)
        done()

    def on_error(p, error: str):
        print("Error from process:", error)
        env.exit(1)

    def timeout():
        print("Timeout waiting for the processes")
        env.exit(1)

    pc = process.ProcessCap(env.cap)
    process.Process(pc, ["echo", "HELLO"], on_stdout, on_stderr, on_exit, on_error)
    process.RunProcess(pc, ["echo", "HELLO"], on_run_exit, on_error)
    after 10: timeout()
