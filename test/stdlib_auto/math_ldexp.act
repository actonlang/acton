import std.math

actor main(env):
    large_positive = 2147483648
    large_negative = -2147483649
    infinity = float("inf")
    nan = float("nan")

    assert std.math.ldexp(0.75, 2) == 3.0
    assert std.math.ldexp(1.0, -1074) > 0.0
    assert std.math.ldexp(1.0, -1075) == 0.0
    assert std.math.ldexp(1.0, large_positive) == infinity
    assert std.math.ldexp(1.0, large_negative) == 0.0
    assert std.math.ldexp(0.0, large_positive) == 0.0
    assert 1.0 / std.math.ldexp(-0.0, large_negative) < 0.0
    assert std.math.ldexp(infinity, large_negative) == infinity
    assert std.math.ldexp(nan, large_positive) != std.math.ldexp(nan, large_positive)
    env.exit(0)
