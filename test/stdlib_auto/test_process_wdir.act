actor main(env):
    var done = False

    def finish(code: int):
        if done:
            return
        done = True
        env.exit(code)

    def on_exit(p, exit_code, term_signal, stdout, stderr):
        if done:
            return
        if exit_code != 0 or term_signal != 0:
            print("Process exited with code:", exit_code, "terminated with signal:", term_signal)
            finish(1)
        elif stdout == b"/\n" and stderr == b"":
            print("Working directory as expected, yay")
            finish(0)
        else:
            print("Unexpected process output:", stdout, stderr)
            finish(1)

    def on_error(p, error):
        if done:
            return
        print("Error from process:", error)
        finish(1)

    def test():
        print("Starting process..")
        p = env.process.run(["pwd"], on_exit, on_error, "/")

    def ex():
        if done:
            return
        print("Test timeout, exiting with error")
        finish(1)

    test()
    after 3: ex()
