import testing


# Each helper uses two levels of collection witnesses three times. Their
# identity is unobservable, so all three comparisons can share the same recipe.
def compare_concrete(xs: list[list[int]], ys: list[list[int]]) -> bool:
    return xs == ys and xs == ys and xs == ys


def compare_generic[A(Eq)](xs: list[list[A]], ys: list[list[A]]) -> bool:
    return xs == ys and xs == ys and xs == ys


def _test_concrete_nested_equality(t: testing.SyncT):
    xs = [[1, 2, 3], [4, 5, 6]]
    ys = [[1, 2, 3], [4, 5, 6]]
    result = True
    for _ in t.loop():
        result = compare_concrete(xs, ys)
    testing.assertEqual(result, True)


def _test_generic_nested_equality(t: testing.SyncT):
    xs = [[1, 2, 3], [4, 5, 6]]
    ys = [[1, 2, 3], [4, 5, 6]]
    result = True
    for _ in t.loop():
        result = compare_generic(xs, ys)
    testing.assertEqual(result, True)


# Elaborated default arguments contain inline Eq[list[A]] constructions at
# separate call sites. Share those witnesses within one helper invocation;
# each default must still construct a distinct user object.
class _DefaultBucket[A(Eq)](object):
    def __init__(self):
        pass

    def same(self, xs: A, ys: A) -> bool:
        return xs == ys


def _take_default(b: _DefaultBucket[list[int]] = _DefaultBucket()) -> _DefaultBucket[list[int]]:
    return b


def compare_inline_defaults(xs: list[int], ys: list[int]) -> bool:
    return _take_default().same(xs, ys) and _take_default().same(xs, ys)


def _take_generic_default[A(Eq)](b: _DefaultBucket[list[A]] = _DefaultBucket()) -> _DefaultBucket[list[A]]:
    return b


def compare_generic_inline_defaults[A(Eq)](xs: list[A], ys: list[A]) -> bool:
    return _take_generic_default().same(xs, ys) and _take_generic_default().same(xs, ys)


def _test_inline_defaults(t: testing.SyncT):
    xs = [1, 2, 3]
    ys = [1, 2, 3]
    result = True
    for _ in t.loop():
        result = compare_inline_defaults(xs, ys)
    testing.assertEqual(result, True)


def _test_generic_inline_defaults(t: testing.SyncT):
    xs = [1, 2, 3]
    ys = [1, 2, 3]
    result = True
    for _ in t.loop():
        result = compare_generic_inline_defaults(xs, ys)
    testing.assertEqual(result, True)
