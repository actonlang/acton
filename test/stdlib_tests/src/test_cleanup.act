import acton.rts
import testing

actor Foo(cb):
    action def __cleanup__():
        cb()


actor _test_Cleanup(t: testing.EnvT):
    """Unreachable actors get their __cleanup__ called when the GC collects them
    """
    var cleaned_up = 0
    var done = False

    def _count_cleanup():
        cleaned_up += 1
        if cleaned_up > 80 and not done:
            done = True
            t.success()

    for i in range(100):
        Foo(_count_cleanup)

    def _collect():
        if done:
            return
        acton.rts.gc(t.env.syscap)
        after 0.1: _collect()
    after 0: _collect()
