import net
import std.syslog as syslog
import test_net_tls_auth as certs
import testing


def frame(data: bytes) -> bytes:
    return str(len(data)).encode() + b" " + data


actor _test_SyslogTLSServerWire(t: testing.EnvT):
    """A verified independent TLS peer sends binary and coalesced frames."""
    cap = net.TCPCap(net.NetCap(t.env.cap))
    first = frame(b'<14>1 - host app - - [meta@32473 n="one"] first\n\x00\xff')
    second = frame(b"<14>1 - host app - - - \xef\xbb\xbf" + "räksmörgås 🫡".encode())
    var server: ?syslog.StreamServer = None
    var sender: ?net.TLSConnection = None
    var source_port = 0
    var messages = 0
    var malformed = 0
    var closing = False
    var done = False

    def finish(error: ?str):
        if done:
            return
        done = True
        if sender is not None:
            sender.close(lambda c: None)
        if server is not None:
            server.close()
        if error is not None:
            t.failure(AssertionError(error))
        else:
            t.success()

    def progress():
        if not done and not closing and messages == 2 and malformed == 1:
            closing = True
            if server is not None:
                server.close()
                server.close()

    def received(s: syslog.StreamServer, message: syslog.Message, peer: str, port: int):
        if done:
            return
        try:
            testing.assertEqual(peer, "127.0.0.1")
            testing.assertEqual(port, source_port)
            testing.assertEqual(message.hostname, "host")
            if messages == 0:
                testing.assertEqual(message.message, b"first\n\x00\xff")
                testing.assertEqual(message.structured_data["meta@32473"], [(name="n", value="one")])
            elif messages == 1:
                testing.assertEqual(message.message, b"\xef\xbb\xbf" + "räksmörgås 🫡".encode())
            else:
                finish("TLS server delivered an extra message")
                return
        except AssertionError as error:
            finish(error.error_message)
            return
        messages += 1
        progress()

    def server_failed(s: syslog.StreamServer, error: str):
        if done:
            return
        if malformed != 0 or "Invalid syslog message" not in error:
            finish("Unexpected TLS server error: {error}")
            return
        malformed += 1
        progress()

    def connected(c: net.TLSConnection):
        if done:
            c.close(lambda c: None)
            return
        ep = c.endpoints()
        source_port = ep.local_port
        if source_port <= 0 or ep.remote_address != "127.0.0.1" or c.tls_info().verify_result != 0:
            finish("Independent TLS sender did not verify the expected endpoint")
            return
        # TLS/TCP can regroup writes. Pure StreamDecoder tests cover exact
        # read splits; here the same frame spans writes and later frames share one.
        c.write(first[:1])
        c.write(first[1:9])
        c.write(first[9:] + frame(b"bad") + second)

    def sender_received(c: net.TLSConnection, data: bytes):
        finish("Syslog TLS server unexpectedly replied")

    def sender_failed(c: net.TLSConnection, error: str):
        finish("Independent TLS sender failed: {error}")

    def sender_closed(c: net.TLSConnection):
        if not closing:
            finish("Syslog TLS server closed a valid stream early")
        else:
            finish(None)

    def bound(s: syslog.StreamServer, error: ?str):
        if done:
            s.close()
            return
        if error is not None:
            finish("TLS server bind failed: {error}")
            return
        if s.local_address() != "127.0.0.1" or s.local_port() <= 0:
            finish("TLS server did not report its listening endpoint")
            return
        sender = net.TLSConnection(net.TCPConnectCap(cap), "127.0.0.1", s.local_port(), connected,
                                   sender_received, sender_failed, sender_closed,
                                   ca_pem=certs.CA_PEM, server_name="localhost")

    server = syslog.StreamServer(net.TCPListenCap(cap), "127.0.0.1", 0, bound, received, server_failed,
                                 cert_pem=certs.SERVER_CERT_PEM, key_pem=certs.SERVER_KEY_PEM)
    after 10: finish("TLS server wire test timed out")


actor mutual_auth_recovery(t: testing.EnvT, reject_callback: bool):
    """An authentication failure reaches on_error; the listener accepts a trusted replacement."""
    cap = net.TCPCap(net.NetCap(t.env.cap))
    var server: ?syslog.StreamServer = None
    var rejected_client: ?syslog.StreamClient = None
    var sender: ?net.TLSConnection = None
    var port = 0
    var source_port = 0
    var client_failed_once = False
    var server_failed_once = False
    var recovering = False
    var authenticated = False
    var closing = False
    var done = False

    def finish(error: ?str):
        if done:
            return
        done = True
        if rejected_client is not None:
            rejected_client.close()
        if sender is not None:
            sender.close(lambda c: None)
        if server is not None:
            server.close()
        if error is not None:
            t.failure(AssertionError(error))
        else:
            t.success()

    def verified(chain: list[bytes], result: int) -> bool:
        if result != 0 or chain != [certs.pem_to_der(certs.CLIENT_CERT_PEM)]:
            finish("Server verifier received unexpected client certificate information")
            return False
        if recovering:
            authenticated = True
            return True
        return False

    def start_replacement():
        if done or recovering or not client_failed_once or not server_failed_once:
            return
        recovering = True
        sender = net.TLSConnection(net.TCPConnectCap(cap), "127.0.0.1", port, connected,
                                   sender_received, sender_failed, sender_closed, ca_pem=certs.CA_PEM,
                                   cert_pem=certs.CLIENT_CERT_PEM, key_pem=certs.CLIENT_KEY_PEM)

    def rejected_connected(c: syslog.StreamClient):
        # TLS 1.3 can report connection on the client before the server checks
        # its certificate. Only the server may deliver authenticated messages.
        pass

    def rejected_failed(c: syslog.StreamClient, error: str):
        if done:
            return
        if client_failed_once or error == "":
            finish("Unexpected rejected-client error: {error}")
            return
        client_failed_once = True
        start_replacement()

    def server_failed(s: syslog.StreamServer, error: str):
        if done:
            return
        expected = "rejected by verify_peer" if reject_callback else "client did not present a certificate"
        if server_failed_once or expected not in error:
            finish("Unexpected mutual TLS server error: {error}")
            return
        server_failed_once = True
        start_replacement()

    def connected(c: net.TLSConnection):
        if done:
            c.close(lambda c: None)
            return
        source_port = c.endpoints().local_port
        c.write(frame(b"<14>1 - host app - - - authenticated"))

    def sender_received(c: net.TLSConnection, data: bytes):
        finish("Mutual TLS syslog server unexpectedly replied")

    def sender_failed(c: net.TLSConnection, error: str):
        finish("Authenticated TLS replacement failed: {error}")

    def sender_closed(c: net.TLSConnection):
        if not closing:
            finish("Authenticated TLS replacement closed early")
        else:
            finish(None)

    def received(s: syslog.StreamServer, message: syslog.Message, peer: str, peer_port: int):
        if done:
            return
        if not recovering or not authenticated or closing or message.message != b"authenticated" or peer != "127.0.0.1" or peer_port != source_port:
            finish("Mutual TLS server delivered unauthenticated or unexpected data")
            return
        closing = True
        s.close()

    def bound(s: syslog.StreamServer, error: ?str):
        if done:
            s.close()
            return
        if error is not None or port != 0:
            finish("Mutual TLS server repeated or failed its initial bind callback")
            return
        port = s.local_port()
        client_cert = certs.CLIENT_CERT_PEM if reject_callback else None
        client_key = certs.CLIENT_KEY_PEM if reject_callback else None
        c = syslog.StreamClient(net.TCPConnectCap(cap), "127.0.0.1", port, rejected_connected, rejected_failed,
                                 tls=True, ca_pem=certs.CA_PEM, cert_pem=client_cert, key_pem=client_key)
        rejected_client = c
        c.send(syslog.Message(b"must not be delivered"))

    server = syslog.StreamServer(net.TCPListenCap(cap), "127.0.0.1", 0, bound, received, server_failed,
                                 cert_pem=certs.SERVER_CERT_PEM, key_pem=certs.SERVER_KEY_PEM,
                                 client_auth=True, ca_pem=certs.CA_PEM, verify_peer=verified)
    after 10: finish("Mutual TLS syslog recovery timed out")


actor _test_SyslogTLSMissingClientCertificate(t: testing.EnvT):
    mutual_auth_recovery(t, False)


actor _test_SyslogTLSClientVerifierRecovery(t: testing.EnvT):
    mutual_auth_recovery(t, True)


actor _test_SyslogTLSHandshakeTimeoutRecovery(t: testing.EnvT):
    """A peer that never starts TLS times out, then a verified client succeeds."""
    cap = net.TCPCap(net.NetCap(t.env.cap))
    var server: ?syslog.StreamServer = None
    var stalled: ?net.TCPConnection = None
    var sender: ?net.TLSConnection = None
    var port = 0
    var stalled_port = 0
    var timed_out = False
    var stalled_closed = False
    var recovering = False
    var done = False

    def finish(error: ?str):
        if done:
            return
        done = True
        if stalled is not None:
            stalled.close(lambda c: None)
        if sender is not None:
            sender.close(lambda c: None)
        if server is not None:
            server.close()
        if error is not None:
            t.failure(AssertionError(error))
        else:
            t.success()

    def start_replacement():
        if done or recovering or not timed_out or not stalled_closed:
            return
        recovering = True
        sender = net.TLSConnection(net.TCPConnectCap(cap), "127.0.0.1", port,
                                   connected, sender_received, sender_failed,
                                   ca_pem=certs.CA_PEM)

    def stalled_connected(c: net.TCPConnection):
        stalled_port = c.endpoints().local_port
        # Send nothing: the server owns the handshake deadline.

    def stalled_received(c: net.TCPConnection, data: bytes):
        finish("TLS server replied before receiving a ClientHello")

    def stalled_failed(c: net.TCPConnection, error: str):
        if "reset" not in error.lower():
            finish("Stalled TCP peer failed unexpectedly: {error}")
            return
        stalled_closed = True
        start_replacement()

    def stalled_ended(c: net.TCPConnection):
        stalled_closed = True
        start_replacement()

    def server_failed(s: syslog.StreamServer, error: str):
        if done:
            return
        expected = "TLS handshake with client 127.0.0.1:{stalled_port} timed out"
        if timed_out or error != expected:
            finish("Unexpected TLS server deadline error: {error}")
            return
        timed_out = True
        start_replacement()

    def connected(c: net.TLSConnection):
        if done:
            c.close(lambda c: None)
        else:
            c.write(frame(b"<14>1 - - - - - - after timeout"))

    def sender_received(c: net.TLSConnection, data: bytes):
        finish("Recovered TLS syslog server unexpectedly replied")

    def sender_failed(c: net.TLSConnection, error: str):
        finish("TLS replacement after timeout failed: {error}")

    def received(s: syslog.StreamServer, message: syslog.Message, peer: str, peer_port: int):
        if not recovering or message.message != b"after timeout" or peer != "127.0.0.1" or peer_port <= 0:
            finish("TLS server delivered unexpected data after timeout")
        else:
            finish(None)

    def bound(s: syslog.StreamServer, error: ?str):
        if done:
            s.close()
            return
        if error is not None or port != 0:
            finish("TLS deadline server repeated or failed its initial bind callback")
            return
        port = s.local_port()
        stalled = net.TCPConnection(net.TCPConnectCap(cap), "127.0.0.1", port,
                                    stalled_connected, stalled_received, stalled_failed, stalled_ended)

    server = syslog.StreamServer(net.TCPListenCap(cap), "127.0.0.1", 0, bound, received, server_failed,
                                 cert_pem=certs.SERVER_CERT_PEM, key_pem=certs.SERVER_KEY_PEM,
                                 handshake_timeout=1.0)
    after 10: finish("TLS server handshake deadline recovery timed out")


actor _test_SyslogTLSServerConfiguration(t: testing.EnvT):
    cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))

    def bound(s: syslog.StreamServer, error: ?str):
        s.close()

    def received(s: syslog.StreamServer, message: syslog.Message, peer: str, port: int):
        s.close()

    def failed(s: syslog.StreamServer, error: str):
        s.close()

    var server: ?syslog.StreamServer = None

    def run():
        for kind in ["cert", "key", "ca", "auth", "verify"]:
            certificate = certs.SERVER_CERT_PEM if kind == "cert" else None
            key = certs.SERVER_KEY_PEM if kind == "key" else None
            ca = certs.CA_PEM if kind == "ca" else None
            expected = "Syslog TLS requires both cert_pem and key_pem" if kind in ["cert", "key"] else "Syslog TLS options require TLS"
            server = None
            try:
                server = syslog.StreamServer(cap, "127.0.0.1", 0, bound, received, failed,
                                             cert_pem=certificate, key_pem=key, ca_pem=ca,
                                             client_auth=kind == "auth", verify_tls=kind != "verify")
            except ValueError as error:
                if error.error_message != expected:
                    t.failure(AssertionError("Unexpected TLS server configuration error: {error.error_message}"))
                    return
            else:
                if server is not None:
                    server.close()
                t.failure(AssertionError("Invalid TLS server configuration was accepted: {kind}"))
                return

        for timeout in [-1.0, float("nan"), float("inf"), float("-inf")]:
            server = None
            try:
                server = syslog.StreamServer(cap, "127.0.0.1", 0, bound, received, failed,
                                             cert_pem=certs.SERVER_CERT_PEM, key_pem=certs.SERVER_KEY_PEM,
                                             handshake_timeout=timeout)
            except ValueError as error:
                if error.error_message != "Syslog handshake_timeout must be finite and nonnegative":
                    t.failure(AssertionError("Unexpected TLS server timeout error: {error.error_message}"))
                    return
            else:
                if server is not None:
                    server.close()
                t.failure(AssertionError("Invalid TLS server timeout was accepted: {timeout}"))
                return
        t.success()

    run()
