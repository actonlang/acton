def _requests_from(chunks: list[bytes]) -> (list[http.Request], ?str):
    p = http.MessageParser()
    reqs = []
    for c in chunks:
        for m in p.feed(c):
            reqs.append(http.request_from_message(m))
    return reqs, p.error

def _test_http_parser(st: testing.SyncT):
    """Requests parse to the same Request whether fed whole or byte by byte"""
    tests = [
        (query = b"GET / HTTP/1.1\r\nHost: 127.0.0.1:8000\r\nUser-Agent: curl/7.85.0\r\nAccept: */*\r\n\r\n",
         expected = http.Request("GET", "/", b"1.1", {"host": "127.0.0.1:8000", "user-agent": "curl/7.85.0", "accept": "*/*"}, b"")),
        (query = b"GET / HTTP/1.1\r\nHost: 127.0.0.1:8000\r\nUser-Agent: curl/7.85.0\r\nAccept: */*\r\nContent-Length: 5\r\n\r\nhello",
         expected = http.Request("GET", "/", b"1.1", {"host": "127.0.0.1:8000", "user-agent": "curl/7.85.0", "accept": "*/*", "content-length": "5"}, b"hello")),
        (query = b"GET / HTTP/1.1\r\nHost: 127.0.0.1:8000\r\nUser-Agent: curl/7.85.0\r\nAccept: */*\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\n\r\n",
         expected = http.Request("GET", "/", b"1.1", {"host": "127.0.0.1:8000", "user-agent": "curl/7.85.0", "accept": "*/*", "transfer-encoding": "chunked"}, b"Wikipedia in\r\n\r\nchunks.")),
        (query = b"GET / HTTP/1.1\r\nHost: loca\xe8\x03o-Length\r\n\r\n",
         expected = None),
    ]
    for t in tests:
        query = t.query
        byte_by_byte = [query[i:i+1] for i in range(len(query))]
        for chunks in [[query], byte_by_byte]:
            reqs, err = _requests_from(chunks)
            expected = t.expected
            if expected is not None:
                testing.assertEqual([expected], reqs, "Parsed request does not match expected")
                testing.assertNone(err, "No parse error")
            else:
                testing.assertEqual([], reqs, "Malformed request gives no request")
                testing.assertNotNone(err, "Malformed request sets error")

def _test_http_message_parser_pipelined_responses(st: testing.SyncT):
    """Pipelined responses in one feed all come out, in order, byte for byte"""
    def responses(p: http.MessageParser, data: bytes) -> list[http.Response]:
        return [http.response_from_message(m) for m in p.feed(data)]

    # Content-Length framed
    first = b"HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\nresponse-one"
    second = b"HTTP/1.1 404 Not Found\r\nContent-Length: 12\r\n\r\nresponse-two"
    testing.assertEqual([http.Response(b"1.1", 200, {"content-length": "12"}, b"response-one"),
                         http.Response(b"1.1", 404, {"content-length": "12"}, b"response-two")],
                        responses(http.MessageParser(), first + second), "Content-Length framed pair")

    # chunked Transfer-Encoding
    first = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n"
    second = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nfoo\r\n0\r\n\r\n"
    testing.assertEqual([http.Response(b"1.1", 200, {"transfer-encoding": "chunked"}, b"Wikipedia"),
                         http.Response(b"1.1", 200, {"transfer-encoding": "chunked"}, b"foo")],
                        responses(http.MessageParser(), first + second), "Chunked pair")

    # A 204 carries neither body nor framing headers, it ends at the empty line
    first = b"HTTP/1.1 204 No Content\r\n\r\n"
    second = b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"
    testing.assertEqual([http.Response(b"1.1", 204, {}, b""),
                         http.Response(b"1.1", 200, {"content-length": "2"}, b"ok")],
                        responses(http.MessageParser(), first + second), "Bodyless response first")

    # An incomplete second response completes with the next feed
    first = b"HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\nresponse-one"
    partial = b"HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\nrespon"
    p = http.MessageParser()
    testing.assertEqual([http.Response(b"1.1", 200, {"content-length": "12"}, b"response-one")],
                        responses(p, first + partial), "Response ahead of a partial one")
    testing.assertEqual([http.Response(b"1.1", 200, {"content-length": "12"}, b"response-two")],
                        responses(p, b"se-two"), "Partial response completed")

def _hexlen(n: int) -> bytes:
    digits = "0123456789abcdef"
    if n == 0:
        return b"0"
    s = ""
    while n > 0:
        s = digits[n % 16] + s
        n = n // 16
    return s.encode()

def _chunked(body: bytes, chunk_size: int) -> bytes:
    """Encode body as chunked transfer coding with chunks of chunk_size bytes"""
    parts = []
    pos = 0
    while pos < len(body):
        end = pos + chunk_size
        if end > len(body):
            end = len(body)
        parts.append(_hexlen(end - pos) + b"\r\n" + body[pos:end] + b"\r\n")
        pos = end
    parts.append(b"0\r\n\r\n")
    return b"".join(parts)

def _filler(size: int) -> bytes:
    """size bytes of JSON-ish text"""
    parts = []
    total = 0
    n = 0
    while total < size:
        rec = b'{"key":"k' + str(n).encode() + b'","value":"v' + str(n).encode() + b'"},'
        parts.append(rec)
        total += len(rec)
        n += 1
    return b"".join(parts)[:size]

def _bodies(msgs: list[http.Message]) -> list[bytes]:
    return [m.body for m in msgs]

def _test_http_message_parser_split_points(st: testing.SyncT):
    """MessageParser gives the same messages no matter how the bytes are split into reads

    Every message below is fed to a fresh parser split at every possible
    boundary (prefix in one feed, the remainder in the next), and byte by
    byte to a single parser, and must come out identical to a single feed:
    headers, Content-Length bodies, chunked bodies with chunk extensions and
    trailers, bodyless messages and pipelined pairs.
    """
    hdr = {"transfer-encoding": "chunked"}
    cases = [
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\nresponse-one",
         expected = [http.Message(b"HTTP/1.1 200 OK", {"content-length": "12"}, b"response-one")]),
        (data = b"HTTP/1.1 204 No Content\r\n\r\n",
         expected = [http.Message(b"HTTP/1.1 204 No Content", {}, b"")]),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n",
         expected = [http.Message(b"HTTP/1.1 200 OK", {"content-length": "0"}, b"")]),
        (data = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\n\r\n",
         expected = [http.Message(b"HTTP/1.1 200 OK", hdr, b"Wikipedia in\r\n\r\nchunks.")]),
        # chunk extension on a size line and trailer fields after the last chunk
        (data = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4;name=value\r\nWiki\r\n5\r\npedia\r\n0\r\nExpires: never\r\nX-Checksum: 1\r\n\r\n",
         expected = [http.Message(b"HTTP/1.1 200 OK", hdr, b"Wikipedia")]),
        # pipelined pair, Content-Length then chunked
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nfooHTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nbar\r\n0\r\n\r\n",
         expected = [http.Message(b"HTTP/1.1 200 OK", {"content-length": "3"}, b"foo"),
                     http.Message(b"HTTP/1.1 200 OK", hdr, b"bar")]),
        # pipelined pair, bodyless then Content-Length
        (data = b"HTTP/1.1 204 No Content\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok",
         expected = [http.Message(b"HTTP/1.1 204 No Content", {}, b""),
                     http.Message(b"HTTP/1.1 200 OK", {"content-length": "2"}, b"ok")]),
    ]
    for c in cases:
        data = c.data
        expected_bodies = _bodies(c.expected)
        expected_headers = [m.headers for m in c.expected]
        expected_start = [m.start_line for m in c.expected]

        # everything in one feed
        p = http.MessageParser()
        msgs = p.feed(data)
        testing.assertEqual(expected_bodies, _bodies(msgs), "Bodies from a single feed")
        testing.assertEqual(expected_headers, [m.headers for m in msgs], "Headers from a single feed")
        testing.assertEqual(expected_start, [m.start_line for m in msgs], "Start lines from a single feed")

        # split at every boundary
        for i in range(len(data) + 1):
            p = http.MessageParser()
            got = p.feed(data[:i])
            got.extend(p.feed(data[i:]))
            testing.assertEqual(expected_bodies, _bodies(got), "Bodies with a split at " + str(i))
            testing.assertEqual(expected_headers, [m.headers for m in got], "Headers with a split at " + str(i))

        # one byte at a time
        p = http.MessageParser()
        got = []
        for i in range(len(data)):
            got.extend(p.feed(data[i:i+1]))
        testing.assertEqual(expected_bodies, _bodies(got), "Bodies fed byte by byte")
        testing.assertEqual(expected_start, [m.start_line for m in got], "Start lines fed byte by byte")

def _test_http_message_parser_large_chunked(st: testing.SyncT):
    """A large chunked body arriving in many small reads parses correctly and fast

    1 MB body in 8 KB chunks fed in 4 KB reads: chunk data, chunk-size lines
    and chunk-ending CRLFs all straddle read boundaries. Each read costs work
    proportional to its own size, so parsing takes tens of milliseconds even
    in a debug build. The limit of 1 s stays clear of that and below the
    test runner's own time limit.
    """
    body = _filler(1024 * 1024)
    data = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n" + _chunked(body, 8192)
    sw = time.Stopwatch()
    p = http.MessageParser()
    got = []
    pos = 0
    reads = 0
    while pos < len(data):
        got.extend(p.feed(data[pos:pos + 4096]))
        pos += 4096
        reads += 1
    elapsed = sw.elapsed().to_float()
    testing.assertEqual(1, len(got), "One message from " + str(reads) + " reads")
    testing.assertEqual(len(body), len(got[0].body), "Body length")
    testing.assertEqual(body, got[0].body, "Body content", print_vals=False, print_diff=False)
    testing.assertTrue(elapsed < 1.0, "Parsing took " + str(elapsed) + " s")

    # The same body in a Content-Length message, fed in 4 KB reads
    data = b"HTTP/1.1 200 OK\r\nContent-Length: " + str(len(body)).encode() + b"\r\n\r\n" + body
    p = http.MessageParser()
    got = []
    pos = 0
    while pos < len(data):
        got.extend(p.feed(data[pos:pos + 4096]))
        pos += 4096
    testing.assertEqual(1, len(got), "One Content-Length message")
    testing.assertEqual(body, got[0].body, "Content-Length body content", print_vals=False, print_diff=False)

def _test_http_message_parser_malformed(st: testing.SyncT):
    """Malformed input sets error, keeps the messages before it and ends parsing"""
    def error_of(data: bytes) -> ?str:
        p = http.MessageParser()
        p.feed(data)
        return p.error

    chunked = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
    bad = [
        (data = chunked + b"zz\r\n", what = "Chunk size that is not hex"),
        (data = chunked + b"+a\r\n", what = "Chunk size with a sign"),
        (data = chunked + b"0x5\r\n", what = "Chunk size with a radix prefix"),
        (data = chunked + b" 5\r\n", what = "Chunk size with leading whitespace"),
        (data = chunked + b"5 \r\n", what = "Chunk size with trailing whitespace and no extension"),
        (data = chunked + b"3\r\nfooXX\r\n", what = "Missing CRLF after chunk data"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: many\r\n\r\n", what = "Content-Length that is not a number"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: -1\r\n\r\n", what = "Negative Content-Length"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: +5\r\n\r\nhello", what = "Content-Length with a sign"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: 0x5\r\n\r\nhello", what = "Content-Length with a radix prefix"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: 5, 6\r\n\r\nhello", what = "Content-Length list with different values"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello", what = "Repeated Content-Length with different values"),
        (data = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\n\r\n", what = "Transfer-Encoding without chunked"),
        (data = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n0\r\n\r\n", what = "Transfer coding other than chunked"),
        (data = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 3\r\n\r\n0\r\n\r\n", what = "Transfer-Encoding and Content-Length"),
        (data = b"HTTP/1.0 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n", what = "Transfer-Encoding in an HTTP/1.0 response"),
        (data = b"POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n", what = "Transfer-Encoding in an HTTP/1.0 request"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length : 5\r\n\r\nhello", what = "Whitespace before the colon"),
        (data = b"HTTP/1.1 200 OK\r\nX-A: 1\r\n folded\r\nContent-Length: 0\r\n\r\n", what = "Folded field line"),
        (data = b"HTTP/1.1 200 OK\r\nno colon here\r\nContent-Length: 0\r\n\r\n", what = "Field line without a colon"),
        (data = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chun\xe2\x84\xaaed\r\n\r\n5\r\nhello\r\n0\r\n\r\n", what = "Coding with a Kelvin sign for k"),
        (data = b"HTTP/1.1 200 OK\r\nTransfer-Encod\xc4\xb0ng: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n", what = "Field name that is not a token"),
    ]
    for b in bad:
        testing.assertNotNone(error_of(b.data), b.what)

    good = [
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: 5, 5\r\n\r\nhello", what = "Content-Length list with equal values"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\nhello", what = "Repeated Content-Length with equal values"),
        (data = b"HTTP/1.1 200 OK\r\nContent-Length:\t5\t\r\n\r\nhello", what = "Tabs around a field value"),
        (data = b"HTTP/1.1 200 Not HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n", what = "Reason phrase that ends like a version"),
        (data = b"HTTP/1.1 200 OK\r\nTransfer-Encoding:\tChunked\r\n\r\n5 ;ext=1\r\nhello\r\n0\r\n\r\n", what = "Whitespace before a chunk extension"),
    ]
    for g in good:
        p = http.MessageParser()
        msgs = p.feed(g.data)
        testing.assertNone(p.error, g.what)
        testing.assertEqual([b"hello"], _bodies(msgs), g.what)

    # Field values lose surrounding tabs, and repeated fields are joined
    p = http.MessageParser()
    msgs = p.feed(b"HTTP/1.1 200 OK\r\nX-A:\tv\t\r\nConnection: close\r\nConnection: te\r\nContent-Length: 0\r\n\r\n")
    testing.assertNone(p.error, "Repeated and tab-wrapped fields")
    testing.assertEqual("v", msgs[0].headers["x-a"], "Tabs around a value are removed")
    testing.assertEqual("close, te", msgs[0].headers["connection"], "Repeated field lines are joined")

    # Empty lines before a request line are ignored
    p = http.MessageParser()
    msgs = p.feed(b"\r\n\r\nGET / HTTP/1.1\r\nHost: a\r\n\r\n")
    testing.assertNone(p.error, "Empty lines before a request")
    testing.assertEqual([b"GET / HTTP/1.1"], [m.start_line for m in msgs], "Request after empty lines")

    # Messages completed before the malformed one are returned, in one feed
    # and when the malformed one comes in a later feed, and nothing after it
    ok = b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"
    broken = b"HTTP/1.1 200 OK\r\nContent-Length: many\r\n\r\n"
    p = http.MessageParser()
    testing.assertEqual([b"ok"], _bodies(p.feed(ok + broken)), "Message before the malformed one")
    testing.assertNotNone(p.error, "Error set after the malformed message")
    testing.assertEqual([], _bodies(p.feed(ok)), "No messages after an error")
    p = http.MessageParser()
    testing.assertEqual([b"ok"], _bodies(p.feed(ok)), "Message in its own feed")
    testing.assertEqual([], _bodies(p.feed(broken + ok)), "Malformed message in a later feed")
    testing.assertNotNone(p.error, "Error set by the later feed")

actor _test_HttpClientServer(t: testing.EnvT):
    """HTTP client/server roundtrip over TCP"""
    log = logging.Logger(t.log_handler)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_http_accept(server):
        server.cb_install(_on_http_server_request, _on_http_server_error)

    def _on_http_server_request(server, request, respond):
        respond(200, {}, "Hello, world!")

    def _on_http_server_error(server, error):
        _finish_failure("HTTP server error: " + error)

    def _on_http_listen_error(listener, error):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_http_connect(c):
        c.get("/", _on_http_receive)

    def _on_http_receive(c, data):
        if data.status != 200:
            _finish_failure("Unexpected status: " + str(data.status))
            return
        if data.body != b"Hello, world!":
            _finish_failure("Unexpected body: " + str(data.body))
            return
        _finish_success()

    def _on_http_error(c, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("HTTP client error: " + errmsg)

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_http_connect, _on_http_error, scheme="http", port=port)

    def _start_listener():
        server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _timeout():
        _finish_failure("timeout")

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpClientPipelinedResponses(t: testing.EnvT):
    """Client delivers pipelined responses that arrive in one TCP read

    The client pipelines: it writes each request as soon as it is issued and
    matches responses to callbacks in order. A raw TCP server waits for both
    requests and then writes both responses in a single write, so they reach
    the client in one receive event. Both callbacks must fire, in order; a
    client that discards what follows the first parsed response loses the
    second one and its callback never fires.
    """
    log = logging.Logger(t.log_handler)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var received = b""
    var responded = False
    var got_first = False

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_raw_listen(listener, error):
        if error is not None:
            if listen_attempts < 10:
                listen_attempts += 1
                port = random.randint(20000, 45000)
                _start_listener()
            else:
                _finish_failure("TCP listen failed: " + error)

    def _on_raw_accept(conn):
        received = b""
        responded = False
        conn.cb_install(_on_raw_receive, _on_raw_error, None)

    def _on_raw_receive(conn, data):
        received += data
        if responded:
            return
        # Each GET request ends in an empty line. Once both have arrived,
        # answer both in a single write so the responses coalesce into one
        # receive event on the client side.
        if received.count(b"\r\n\r\n") >= 2:
            responded = True
            responses = b"HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\nresponse-one"
            responses += b"HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\nresponse-two"
            conn.write(responses)

    def _on_raw_error(conn, errmsg):
        _finish_failure("TCP server connection error: " + errmsg)

    def _on_connect(c):
        c.get("/1", _on_response1)
        c.get("/2", _on_response2)

    def _on_response1(c, r):
        if r.status != 200 or r.body != b"response-one":
            _finish_failure("Unexpected first response: " + str(r.status) + " " + str(r.body))
            return
        got_first = True

    def _on_response2(c, r):
        if not got_first:
            _finish_failure("Second response delivered before the first")
            return
        if r.status != 200 or r.body != b"response-two":
            _finish_failure("Unexpected second response: " + str(r.status) + " " + str(r.body))
            return
        _finish_success()

    def _on_client_error(c, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("HTTP client error: " + errmsg)

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_connect, _on_client_error, scheme="http", port=port)

    def _start_listener():
        server = net.TCPListener(serv_cap, "127.0.0.1", port, _on_raw_listen, _on_raw_accept)

    def _timeout():
        _finish_failure("timeout waiting for the second pipelined response, server received: " + str(received))

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpServerPipelinedRequests(t: testing.EnvT):
    """Server answers pipelined requests in order, also when responses are asynchronous

    A raw TCP client sends two GET requests in a single write, so both are
    parsed from one read and dispatched. The request handler responds
    asynchronously, and slower to the first request than to the second, so
    the server has to hold the second response back until the first has been
    sent: the responses must arrive in request order.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var parser = http.MessageParser()
    var bodies: list[bytes] = []

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_http_accept(s):
        s.cb_install(_on_http_request, _on_http_server_error)

    def _on_http_request(s, request, respond):
        if request.path == "/1":
            after 0.1: respond(200, {}, request.path)
        else:
            after 0.01: respond(200, {}, request.path)

    def _on_http_server_error(s, error):
        _finish_failure("HTTP server error: " + error)

    def _on_http_listen_error(listener, error):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_raw_connect(conn):
        conn.write(b"GET /1 HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\nGET /2 HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")

    def _on_raw_receive(conn, data):
        for m in parser.feed(data):
            bodies.append(m.body)
        err = parser.error
        if err is not None:
            _finish_failure("Malformed response from server: " + err)
            return
        if len(bodies) >= 2:
            if bodies[0] != b"/1" or bodies[1] != b"/2":
                _finish_failure("Responses out of order or wrong: " + str(bodies))
                return
            _finish_success()

    def _on_raw_error(conn, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("TCP client error: " + errmsg)

    def _start_client():
        parser = http.MessageParser()
        bodies = []
        net.TCPConnection(conn_cap, "127.0.0.1", port, _on_raw_connect, _on_raw_receive, _on_raw_error, None)

    def _start_listener():
        server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _timeout():
        _finish_failure("timeout, responses received: " + str(bodies))

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpServerConnectionClose(t: testing.EnvT):
    """Server closes the connection after the response to the request that asked for it

    A raw TCP client pipelines three requests in one write. The second one
    carries Connection: close. The handler answers the first request later
    than the second, so the response to the second is held back until the
    first has been sent. The client must receive exactly the first two
    responses, in order, and then see the server close the connection. The
    third request must never reach the handler.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var parser = http.MessageParser()
    var bodies: list[bytes] = []
    var handled: list[str] = []

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_http_accept(s):
        s.cb_install(_on_http_request, _on_http_server_error)

    def _on_http_request(s, request, respond):
        handled.append(request.path)
        if request.path == "/1":
            after 0.1: respond(200, {}, request.path)
        else:
            respond(200, {}, request.path)

    def _on_http_server_error(s, error):
        _finish_failure("HTTP server error: " + error)

    def _on_http_listen_error(listener, error):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_raw_connect(conn):
        conn.write(b"GET /1 HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\nGET /2 HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: keep-alive, Close\r\n\r\nGET /3 HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")

    def _on_raw_receive(conn, data):
        for m in parser.feed(data):
            bodies.append(m.body)
        err = parser.error
        if err is not None:
            _finish_failure("Malformed response from server: " + err)
            return

    def _on_raw_remote_close(conn):
        if bodies != [b"/1", b"/2"]:
            _finish_failure("Expected the responses to /1 and /2 before the close, got: " + str(bodies))
            return
        if handled != ["/1", "/2"]:
            _finish_failure("Expected only /1 and /2 to be handled, handled: " + str(handled))
            return
        _finish_success()

    def _on_raw_error(conn, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("TCP client error: " + errmsg)

    def _start_client():
        parser = http.MessageParser()
        bodies = []
        handled = []
        net.TCPConnection(conn_cap, "127.0.0.1", port, _on_raw_connect, _on_raw_receive, _on_raw_error, _on_raw_remote_close)

    def _start_listener():
        server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _timeout():
        _finish_failure("timeout, responses received: " + str(bodies) + ", handled: " + str(handled))

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


