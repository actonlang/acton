        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_http_accept(s):
        s.cb_install(_on_http_request, _on_http_server_error)

    def _on_http_request(s, request, respond):
        handled.append(request.path)
        if request.path == "/a":
            after 0.1: respond(200, {}, "a")
        else:
            respond(200, {}, "b-first")
            respond(200, {}, "b-second")

    def _on_http_server_error(s, error):
        _finish_failure("HTTP server error: " + error)

    def _on_http_listen_error(listener, error):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_raw_connect(conn):
        conn.write(b"GET /a HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\nGET /b HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")

    def _on_raw_receive(conn, data):
        for m in parser.feed(data):
            bodies.append(m.body)

    def _on_raw_remote_close(conn):
        if bodies != [b"a", b"b-first"]:
            _finish_failure("Expected the first answer to each request, got: " + str(bodies))
            return
        _finish_success()

    def _on_raw_error(conn, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("TCP client error: " + errmsg)

    def _start_client():
        parser = http.MessageParser()
        bodies = []
        handled = []
        net.TCPConnection(conn_cap, "127.0.0.1", port, _on_raw_connect, _on_raw_receive, _on_raw_error, _on_raw_remote_close)

    def _start_listener():
        server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _timeout():
        _finish_failure("timeout, responses received: " + str(bodies) + ", handled: " + str(handled))

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpServerLateCbInstall(t: testing.EnvT):
    """Server answers a request that arrived before its callbacks were installed

    The listener starts reading from the connection as soon as the server is
    created, but on_accept installs the request handler only 0.3 s later, by
    which time the client's request has been received. The server must keep
    the request and dispatch it to the handler once it is installed.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _install(s):
        s.cb_install(_on_http_request, _on_http_server_error)

    def _on_http_accept(s):
        after 0.3: _install(s)

    def _on_http_request(s, request, respond):
        respond(200, {}, "late install")

    def _on_http_server_error(s, error):
        _finish_failure("HTTP server error: " + error)

    def _on_http_listen_error(listener, error):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_connect(c):
        c.get("/", _on_response)

    def _on_response(c, r):
        if r.status != 200 or r.body != b"late install":
            _finish_failure("Unexpected response: " + str(r.status) + " " + str(r.body))
            return
        _finish_success()

    def _on_client_error(c, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("HTTP client error: " + errmsg)

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_connect, _on_client_error, scheme="http", port=port)

    def _start_listener():
        server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _timeout():
        _finish_failure("timeout: the request that arrived before cb_install was not answered")

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpServerHandlerCallsBack(t: testing.EnvT):
    """A request handler may call back into the server synchronously

    The handler answers with respond(...) in value position, which is a
    synchronous call: the handler's actor waits until the server has
    processed it. That only works if the server is not itself parked waiting
    for the handler to return, so the server must invoke the handler
    asynchronously; a server that awaits its handler deadlocks with it here.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_http_accept(s):
        s.cb_install(_on_http_request, _on_http_server_error)

    def _on_http_request(s, request, respond):
        # Calling the action in value position makes this a synchronous call
        # into the server: this actor is parked until the server has run it
        res = respond(200, {}, "called back")

    def _on_http_server_error(s, error):
        _finish_failure("HTTP server error: " + error)

    def _on_http_listen_error(listener, error):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_connect(c):
        c.get("/", _on_response)

    def _on_response(c, r):
        if r.status != 200 or r.body != b"called back":
            _finish_failure("Unexpected response: " + str(r.status) + " " + str(r.body))
            return
        _finish_success()

    def _on_client_error(c, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("HTTP client error: " + errmsg)

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_connect, _on_client_error, scheme="http", port=port)

    def _start_listener():
        server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _timeout():
        _finish_failure("timeout: server and handler deadlocked")

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()



actor _test_HttpClientCallbackCallsBack(t: testing.EnvT):
    """Client callbacks may call back into the client synchronously

    on_connect issues the first request, and the on_response callback of the
    first request issues the next one, both with a call in value position,
    i.e. synchronously: the callback's actor waits until the client has
    processed the call. That only works if the client is not parked waiting
    for the callback to return, so the client must invoke on_connect and
    on_response asynchronously. A client that awaits its callbacks
    deadlocks with them here.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_http_accept(s):
        s.cb_install(_on_http_request, _on_http_server_error)

    def _on_http_request(s, request, respond):
        respond(200, {}, request.path)

    def _on_http_server_error(s, error):
        _finish_failure("HTTP server error: " + error)

    def _on_http_listen_error(listener, error):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_connect(c):
        # A value-position call: this actor is parked until the client has run it
        res = c.get("/1", _on_response1)

    def _on_response1(c, r):
        if r.status != 200 or r.body != b"/1":
            _finish_failure("Unexpected first response: " + str(r.status) + " " + str(r.body))
            return
        # Calling the action in value position makes this a synchronous call
        # into the client: this actor is parked until the client has run it
        res = c.get("/2", _on_response2)

    def _on_response2(c, r):
        if r.status != 200 or r.body != b"/2":
            _finish_failure("Unexpected second response: " + str(r.status) + " " + str(r.body))
            return
        _finish_success()

    def _on_client_error(c, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("HTTP client error: " + errmsg)

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_connect, _on_client_error, scheme="http", port=port)

    def _start_listener():
        server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _timeout():
        _finish_failure("timeout: client and callback deadlocked")

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()



actor _EarlyRequests(t: testing.EnvT, scheme: str):
    """Requests issued before the client has connected are sent exactly once

    200 requests are issued right after the client is created, before it
    has connected. Each one must reach the server once and be answered in
    order, and the client must not report errors for them.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var tls_server = None
    var handled: list[str] = []
    var received: list[bytes] = []
    expected = [("/" + str(i)).encode() for i in range(200)]

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_http_accept(s):
        s.cb_install(_on_http_request, _on_http_server_error)

    def _on_http_request(s, request, respond):
        handled.append(request.path)
        respond(200, {}, request.path)

    def _on_http_server_error(s, error):
        _finish_failure("HTTP server error: " + error)

    def _listen_failed(error: str):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_http_listen_error(listener, error):
        _listen_failed(error)

    def _on_connect(c):
        pass

    def _on_response(c, r):
        received.append(r.body)
        if len(received) == len(expected):
            if received != expected:
                _finish_failure("Responses out of order or wrong: " + str(received))
                return
            # Give duplicate requests time to reach the handler
            after 0.2: _check_handled()

    def _check_handled():
        if handled != [e.decode() for e in expected]:
            _finish_failure("Each request must be handled once, handled: " + str(handled))
            return
        _finish_success()

    def _on_client_error(c, errmsg):
        if len(received) == 0 and len(handled) == 0 and attempts < 5 and "not established" not in errmsg:
            # The listener was not up yet, try again with a new client
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("HTTP client error: " + errmsg)

    def _start_client():
        c = http.Client(conn_cap, "127.0.0.1", _on_connect, _on_client_error, scheme=scheme, port=port, tls_verify=False)
        for i in range(len(expected)):
            c.get("/" + str(i), _on_response)

    def _start_listener():
        if scheme == "https":
            tls_server = http.TLSListener(serv_cap, "127.0.0.1", port, CERT_PEM.encode(), KEY_PEM.encode(), _on_https_accept, _on_https_listen_error)
        else:
            server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _on_https_accept(s):
        s.cb_install(_on_https_request, _on_https_server_error)

    def _on_https_request(s, request, respond):
        handled.append(request.path)
        respond(200, {}, request.path)

    def _on_https_server_error(s, error):
        _finish_failure("HTTPS server error: " + error)

    def _on_https_listen_error(listener, error):
        _listen_failed(error)

    def _timeout():
        _finish_failure("timeout, responses received: " + str(received) + ", handled: " + str(handled))

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpClientEarlyRequests(t: testing.EnvT):
    """HTTP requests issued before the client has connected are sent exactly once"""
    _EarlyRequests(t, "http")


actor _test_HttpsClientEarlyRequests(t: testing.EnvT):
    """HTTPS requests issued before the client has connected are sent exactly once"""
    _EarlyRequests(t, "https")


actor _test_HttpClientLargeChunkedResponse(t: testing.EnvT):
    """Client receives a large chunked response streamed in many small writes

    A raw TCP server answers with a 1 MB body in 64 byte chunks, written to
    the socket in 4 KB pieces so that the client sees many reads with chunk
    boundaries all over the place. The client must deliver the complete body
    within 2 s of the request. It takes a few milliseconds in a release build
    and well under a second in a debug build.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var responded = False
    var sw = time.Stopwatch()

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    body = _filler(1024 * 1024)
    response = b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\n" + _chunked(body, 64)

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_raw_listen(listener, error):
        if error is not None:
            if listen_attempts < 10:
                listen_attempts += 1
                port = random.randint(20000, 45000)
                _start_listener()
            else:
                _finish_failure("TCP listen failed: " + error)

    def _on_raw_accept(conn):
        responded = False
        conn.cb_install(_on_raw_receive, _on_raw_error, None)

    def _on_raw_receive(conn, data):
        if responded:
            return
        responded = True
        pos = 0
        while pos < len(response):
            conn.write(response[pos:pos + 4096])
            pos += 4096

    def _on_raw_error(conn, errmsg):
        _finish_failure("TCP server connection error: " + errmsg)

    def _on_connect(c):
        sw = time.Stopwatch()
        c.get("/", _on_response)

    def _on_response(c, r):
        elapsed = sw.elapsed().to_float()
        if r.status != 200:
            _finish_failure("Unexpected status: " + str(r.status))
            return
        if len(r.body) != len(body):
            _finish_failure("Unexpected body length: " + str(len(r.body)) + " expected " + str(len(body)))
            return
        if r.body != body:
            _finish_failure("Body content differs from what was sent")
            return
        if elapsed > 2.0:
            _finish_failure("The response took " + str(elapsed) + " s")
            return
        _finish_success()

    def _on_client_error(c, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("HTTP client error: " + errmsg)

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_connect, _on_client_error, scheme="http", port=port)

    def _start_listener():
        server = net.TCPListener(serv_cap, "127.0.0.1", port, _on_raw_listen, _on_raw_accept)

    def _timeout():
        _finish_failure("timeout waiting for the large chunked response")

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpClientMalformedResponse(t: testing.EnvT):
    """Client delivers the responses before a malformed one and reports the error once

    A raw TCP server answers two pipelined requests in one write: a valid
    response, then one whose Content-Length is not a number, then more
    bytes. The first callback must get the valid response, on_error must be
    called exactly once, the second callback must not be called, and the
    client must close the connection.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var received = b""
    var responded = False
    var got_first = False
    var errors: list[str] = []
    var closed_by_client = False

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_raw_listen(listener, error):
        if error is not None:
            if listen_attempts < 10:
                listen_attempts += 1
                port = random.randint(20000, 45000)
                _start_listener()
            else:
                _finish_failure("TCP listen failed: " + error)

    def _on_raw_accept(conn):
        conn.cb_install(_on_raw_receive, _on_raw_error, _on_raw_remote_close)

    def _on_raw_remote_close(conn):
        closed_by_client = True

    def _on_raw_receive(conn, data):
        received += data
        if responded:
            return
        if received.count(b"\r\n\r\n") >= 2:
            responded = True
            conn.write(b"HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\none" + b"HTTP/1.1 200 OK\r\nContent-Length: many\r\n\r\n" + b"garbage\r\n\r\n")

    def _on_raw_error(conn, errmsg):
        pass

    def _on_connect(c):
        c.get("/1", _on_response1)
        c.get("/2", _on_response2)

    def _on_response1(c, r):
        if r.status != 200 or r.body != b"one":
            _finish_failure("Unexpected first response: " + str(r.status) + " " + str(r.body))
            return
        got_first = True

    def _on_response2(c, r):
        _finish_failure("The malformed second response reached its callback")

    def _on_client_error(c, errmsg):
        errors.append(errmsg)
        if len(errors) == 1:
            after 0.3: _check()

    def _check():
        if not got_first:
            _finish_failure("The valid first response was not delivered")
            return
        if len(errors) != 1:
            _finish_failure("Expected one error, got: " + str(errors))
            return
        if not errors[0].startswith("Malformed HTTP response"):
            _finish_failure("Unexpected error: " + errors[0])
            return
        if not closed_by_client:
            _finish_failure("The client did not close the connection")
            return
        _finish_success()

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_connect, _on_client_error, scheme="http", port=port)

    def _start_listener():
        server = net.TCPListener(serv_cap, "127.0.0.1", port, _on_raw_listen, _on_raw_accept)

    def _timeout():
        _finish_failure("timeout, errors: " + str(errors))

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _ServerClosesOnMalformed(t: testing.EnvT, request: bytes):
    """Server closes the connection on malformed input without calling the handler"""
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var parser = http.MessageParser()
    var bodies: list[bytes] = []
    var handled: list[str] = []

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_http_accept(s):
        s.cb_install(_on_http_request, _on_http_server_error)

    def _on_http_request(s, request, respond):
        handled.append(request.path)
        respond(200, {}, request.path)

    def _on_http_server_error(s, error):
        _finish_failure("HTTP server error: " + error)

    def _on_http_listen_error(listener, error):
        if listen_attempts < 10:
            listen_attempts += 1
            port = random.randint(20000, 45000)
            _start_listener()
        else:
            _finish_failure("HTTP listen failed: " + error)

    def _on_raw_connect(conn):
        conn.write(request)

    def _on_raw_receive(conn, data):
        for m in parser.feed(data):
            bodies.append(m.body)

    def _on_raw_remote_close(conn):
        if len(bodies) > 0 or len(handled) > 0:
            _finish_failure("Expected a close without responses, got: " + str(bodies) + ", handled: " + str(handled))
            return
        _finish_success()

    def _on_raw_error(conn, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("TCP client error: " + errmsg)

    def _start_client():
        parser = http.MessageParser()
        bodies = []
        handled = []
        net.TCPConnection(conn_cap, "127.0.0.1", port, _on_raw_connect, _on_raw_receive, _on_raw_error, _on_raw_remote_close)

    def _start_listener():
        server = http.Listener(serv_cap, "127.0.0.1", port, _on_http_accept, _on_http_listen_error)

    def _timeout():
        _finish_failure("timeout, the server did not close the connection")

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpServerBadRequestLine(t: testing.EnvT):
    """Server closes the connection on a request line it does not accept"""
    _ServerClosesOnMalformed(t, b"GET / HTTP/2.0\r\nHost: 127.0.0.1\r\n\r\n")


actor _test_HttpServerBadFramingAlone(t: testing.EnvT):
    """Server closes the connection at once on malformed framing with no request pending"""
    _ServerClosesOnMalformed(t, b"GET / HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: many\r\n\r\n")


actor _test_HttpClientReconnect(t: testing.EnvT):
    """Client sends unanswered requests again after a Connection: close response

    The client pipelines three requests. On the first connection a raw TCP
    server answers only the first, with Connection: close and junk bytes
    after the response in the same write, and closes the connection. The
    client must deliver that response, ignore the junk, and send the other
    two requests exactly once on a new connection, where they are answered.
    on_error must not be called.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var accepted = 0
    var parser = http.MessageParser()
    var first_requests = 0
    var second_paths: list[str] = []
    var bodies: list[bytes] = []
    var errors: list[str] = []
    var requested = False

    serv_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _on_raw_listen(listener, error):
        if error is not None:
            if listen_attempts < 10:
                listen_attempts += 1
                port = random.randint(20000, 45000)
                _start_listener()
            else:
                _finish_failure("TCP listen failed: " + error)

    def _on_raw_accept(conn):
        accepted += 1
        parser = http.MessageParser()
        conn.cb_install(_on_raw_receive, _on_raw_error, None)

    def _on_raw_receive(conn, data):
        msgs = parser.feed(data)
        if accepted == 1:
            first_requests += len(msgs)
            if first_requests == 3:
                conn.write(b"HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 2\r\n\r\n/1" + b"junk\r\n\r\n")
                conn.close()
        else:
            for m in msgs:
                path = http.request_from_message(m).path
                second_paths.append(path)
                conn.write(b"HTTP/1.1 200 OK\r\nContent-Length: " + str(len(path)).encode() + b"\r\n\r\n" + path.encode())

    def _on_raw_error(conn, errmsg):
        pass

    def _on_connect(c):
        # on_connect runs again for the new connection
        if not requested:
            requested = True
            c.get("/1", _on_response)
            c.get("/2", _on_response)
            c.get("/3", _on_response)

    def _on_response(c, r):
        bodies.append(r.body)
        if len(bodies) == 3:
            # Give duplicate requests time to arrive
            after 0.2: _check()

    def _check():
        if bodies != [b"/1", b"/2", b"/3"]:
            _finish_failure("Responses out of order or wrong: " + str(bodies))
            return
        if second_paths != ["/2", "/3"]:
            _finish_failure("Expected /2 and /3 once on the new connection, got: " + str(second_paths))
            return
        if len(errors) > 0:
            _finish_failure("Unexpected errors: " + str(errors))
            return
        _finish_success()

    def _on_client_error(c, errmsg):
        errors.append(errmsg)

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_connect, _on_client_error, scheme="http", port=port)

    def _start_listener():
        server = net.TCPListener(serv_cap, "127.0.0.1", port, _on_raw_listen, _on_raw_accept)

    def _timeout():
        _finish_failure("timeout, responses: " + str(bodies) + ", second connection: " + str(second_paths) + ", errors: " + str(errors))

    _start_listener()
    after 0.05: _start_client()
    after 10: _timeout()


actor _test_HttpsClientServer(t: testing.EnvT):
    """HTTPS client/server roundtrip over TLS"""
    log = logging.Logger(t.log_handler)
    var done = False
    var attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    listen_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    conn_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))

    def _finish_success():
        if done:
            return
        done = True
        t.success()

    def _finish_failure(msg: str):
        if done:
            return
        done = True
        t.failure(AssertionError(msg))

    def _finish_error(msg: str):
        if done:
            return
        done = True
        t.error(Exception(msg))

    def _on_https_accept(server):
        server.cb_install(_on_https_request, _on_https_error)

    def _on_https_request(server, request, respond):
        respond(200, {"content-type": "text/plain"}, "Hello, TLS!")

    def _on_https_error(server, error):
        _finish_error("HTTPS server error: " + error)

    def _on_https_connect(c):
        c.get("/", _on_https_receive)

    def _on_https_receive(c, data):
        if data.status != 200:
            _finish_failure("Unexpected status: " + str(data.status))
            return
        if data.body != b"Hello, TLS!":
            _finish_failure("Unexpected body: " + str(data.body))
            return
        _finish_success()

    def _on_https_error_client(c, errmsg):
        if attempts < 5:
            attempts += 1
            after 0.1: _start_client()
        else:
            _finish_failure("HTTPS client error: " + errmsg)

    def _start_client():
        http.Client(conn_cap, "127.0.0.1", _on_https_connect, _on_https_error_client, scheme="https", port=port, tls_verify=False)

    def _timeout():
        _finish_error("timeout")

    server = http.TLSListener(
        listen_cap,
        "127.0.0.1",
        port,
        CERT_PEM.encode(),
        KEY_PEM.encode(),
        _on_https_accept
    )
    after 0.05: _start_client()
    after 10: _timeout()
