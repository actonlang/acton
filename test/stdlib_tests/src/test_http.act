actor _test_HttpServerDuplicateRespond(t: testing.EnvT):
    """A second response to the same request is ignored

    A raw TCP client pipelines two requests, the second with Connection:
    close. The handler answers the first request late and the second one
    twice right away, so both answers to the second are held back while the
    first is outstanding. The client must get the first answer to each
    request, in order, and then see the server close the connection.
    """
    log = logging.Logger(t.log_handler)
    t.timeout(15.0)
    var done = False
    var attempts = 0
    var listen_attempts = 0
    var port = random.randint(20000, 45000)
    var server = None
    var parser = http.MessageParser()
    var bodies: list[bytes] = []
    var handled: list[str] = []

