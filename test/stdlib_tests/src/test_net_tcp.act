import logging
import net
import random
import re
import testing

actor _test_TCPClientSideClose(t: testing.EnvT):
    log = logging.Logger(t.log_handler)
    test_payload = b"Stay a while and listen."
    address = "127.0.0.1"
    var retries = 10
    var port = random.randint(10000, 40000)
    tcp_cap = net.TCPCap(net.NetCap(t.env.cap))

    var recv_buf: list[bytes] = []

    var client = None

    def on_server_receive(s, payload):
        recv_buf.append(payload)

    def on_server_error(s, errmsg):
        log.error(errmsg)
        t.failure(AssertionError("server error: " + errmsg))

    def on_server_remote_close(s):
        try:
            testing.assertEqual(test_payload, bytes([]).join(recv_buf), "Did not receive expected data before remote close event")
        except AssertionError as ex:
            t.failure(ex)
        except Exception as ex:
            t.error(ex)
        else:
            t.success()

    def on_listen(l, error):
        if error is not None:
            m = re.match(r"address already in use", error)
            if m is not None:
                if retries > 0:
                    log.debug("address already in use (%d), retrying..." % port)
                    _start()
                    return
            log.error(error)
            t.failure(AssertionError("listen error: " + error))
        else:
            _connect_client()

    def on_listen_accept(s):
        s.cb_install(on_server_receive, on_server_error, on_server_remote_close)

    def _connect_client():
        client = net.TCPConnection(net.TCPConnectCap(tcp_cap), address, port, on_connect, on_receive, on_error)

    def on_connect(c):
        c.write(test_payload)
        c.close(lambda c: None)

    def on_receive(c, payload):
        pass

    def on_error(c, errmsg):
        # Retry since server might not be up yet
        after 0.1: _connect_client()

    def _start():
        retries -= 1
        port = random.randint(10000, 40000)
        server = net.TCPListener(net.TCPListenCap(tcp_cap), address, port, on_listen, on_listen_accept)
    _start()

actor test_tcp_server_side_close(t: testing.EnvT, test_payload: bytes):
    log = logging.Logger(t.log_handler)
    address = "127.0.0.1"
    var retries = 10
    var port = random.randint(10000, 40000)
    tcp_cap = net.TCPCap(net.NetCap(t.env.cap))

    recv_buf: list[bytes] = []

    var client = None

    def on_server_receive(s, payload):
        pass

    def on_server_error(s, errmsg):
        log.error(errmsg)
        t.failure(AssertionError("server error: " + errmsg))

    def on_listen(l, error):
        if error is not None:
            m = re.match(r"address already in use", error)
            if m is not None:
                if retries > 0:
                    _start()
                    log.info("address already in use, retrying...")
                    return
            log.error(error)
            t.failure(AssertionError("listen error: " + error))
        else:
            _connect_client()

    def on_listen_accept(s):
        s.cb_install(on_server_receive, on_server_error, None)
        s.write(test_payload)
        s.close()

    def _connect_client():
        client = net.TCPConnection(net.TCPConnectCap(tcp_cap), address, port, on_connect, on_receive, on_error, on_remote_close)

    def on_connect(c):
        pass

    def on_receive(c: net.TCPConnection, payload):
        if client is not None and client is c:
            recv_buf.append(payload)

    def on_error(c, errmsg):
        # Retry since server might not be up yet
        after 0.1: _connect_client()

    def on_remote_close(c: net.TCPConnection):
        if client is not None and client is c:
            try:
                recv = bytes([]).join(recv_buf)
                testing.assertEqual(len(test_payload), len(recv), "Did not receive expected %d bytes before remote close event, got %d bytes, retry: %d" % (len(test_payload), len(recv), retries))
                testing.assertEqual(test_payload, recv, "Received data differs from the data the server wrote", print_vals=False, print_diff=False)
            except AssertionError as ex:
                t.failure(ex)
            except Exception as ex:
                t.error(ex)
            else:
                t.success()

    def _start():
        retries -= 1
        port = random.randint(10000, 40000)
        server = net.TCPListener(net.TCPListenCap(tcp_cap), address, port, on_listen, on_listen_accept)
    _start()

actor _test_TCPServerSideClose(t: testing.EnvT):
    test_tcp_server_side_close(t, b"Stay a while and listen.")

actor _test_TCPServerSideCloseLargePayload(t: testing.EnvT):
    """Server-side close delivers a payload larger than the socket send buffer

    The server writes 4 MB and closes the connection in the same step. The
    write is asynchronous. The data that does not fit in the socket send
    buffer stays in the stream write queue. close() must drain that queue
    before it closes the handle, or the client receives a truncated payload.
    http.Listener closes this way on Connection: close and for HTTP/1.0.
    """
    test_tcp_server_side_close(t, ("x" * 4000000).encode())

# The tests below listen on port 0, so they need no retries for ports in use.

actor tcp_test_result(t: testing.EnvT, what: str):
    """The result of one test, for what"""
    var done = False

    def success():
        if not done:
            done = True
            t.success()

    def failure(msg: str):
        if not done:
            done = True
            t.failure(AssertionError(msg))

    def timeout(msg: str):
        if not done:
            done = True
            t.error(Exception("timeout in " + what + ": " + msg))

    def is_done() -> bool:
        return done


actor _test_TCPListenerPortZero(t: testing.EnvT):
    """A listener on port 0 reports the port it listens on"""
    tcp_cap = net.TCPCap(net.NetCap(t.env.cap))
    base = tcp_test_result(t, "listener port zero")
    var listener: ?net.TCPListener = None

    def on_listen(l: net.TCPListener, error: ?str):
        if error is not None:
            base.failure("listen error: " + error)
            return
        listener = l
        port = l.local_port()
        if port <= 0:
            base.failure("listener on port 0 reports port %d" % port)
            return
        if l.local_address() != "127.0.0.1":
            base.failure("listener reports local address " + l.local_address())
            return
        net.TCPConnection(net.TCPConnectCap(tcp_cap), "127.0.0.1", port, on_connect, on_receive, on_error)

    def on_accept(s: net.TCPListenConnection):
        s.close()

    def on_connect(c: net.TCPConnection):
        c.close(lambda c: None)
        if listener is not None:
            listener.close()
        base.success()

    def on_receive(c: net.TCPConnection, data: bytes):
        pass

    def on_error(c: net.TCPConnection, errmsg: str):
        base.failure("client error: " + errmsg)

    after 5: base.timeout("no connection")
    net.TCPListener(net.TCPListenCap(tcp_cap), "127.0.0.1", 0, on_listen, on_accept)


actor _test_TCPListenerClose(t: testing.EnvT):
    """close() stops listening, so a new connection is refused"""
    tcp_cap = net.TCPCap(net.NetCap(t.env.cap))
    base = tcp_test_result(t, "listener close")

    def on_listen(l: net.TCPListener, error: ?str):
        if error is not None:
            base.failure("listen error: " + error)
            return
        port = l.local_port()
        l.close()
        after 0.1: connect(port)

    def connect(port: int):
        net.TCPConnection(net.TCPConnectCap(tcp_cap), "127.0.0.1", port, on_connect, on_receive, on_error)

    def on_accept(s: net.TCPListenConnection):
        base.failure("closed listener accepted a connection")

    def on_connect(c: net.TCPConnection):
        base.failure("connected to a closed listener")

    def on_receive(c: net.TCPConnection, data: bytes):
        pass

    def on_error(c: net.TCPConnection, errmsg: str):
        if errmsg.find("refused") == -1:
            base.failure("expected connection refused, got: " + errmsg)
        else:
            base.success()

    after 5: base.timeout("no result")
    net.TCPListener(net.TCPListenCap(tcp_cap), "127.0.0.1", 0, on_listen, on_accept)
