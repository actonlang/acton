import std.build.derive as derive
import std.json as json

import file
import testing

# The SHA-256 of b"abc" and of no content
ABC = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
EMPTY = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

# Paths that embed takes and paths that it refuses, as JSON.  The compiler
# has the rule for a path of embed in Acton.Embed.pathProblem, and embed_call
# has it in Acton.  The test of pathProblem in compiler/lib/test/ActonSpec.hs
# reads the same file, so the two are run on one list.
EMBED_PATHS = embed("data/embed_paths.json")

# What embed_call says after the path that embed refuses
EMBED_RULE = (". A path of embed is relative, with / between its components. "
              + "It has no empty component, no component . or .., no backslash, no double quote, no brace "
              + "and no control character. Its first component is not out")

def _test_module_names():
    for name in ["schema", "a.b.c", "_private", "v2.layer_0", "Schema"]:
        testing.assertTrue(derive.is_module_name(name), name)
    for name in ["", "a..b", ".a", "a.", "2a", "a.2b", "a/b", "a-b", "a b", "../a"]:
        testing.assertFalse(derive.is_module_name(name), name)

def _test_returned_names():
    # A returned name is a module name
    derive.check_names({"schema": "", "layers.a": "", "layers.a.b": ""})
    derive.check_names({})
    for name in ["schema/x", "schema..x", "../schema", ""]:
        try:
            derive.check_names({name: ""})
            testing.error("accepted " + name)
        except ValueError:
            pass

def _test_manifest():
    # A brace in a string literal is written twice
    m = derive.Manifest.from_json('{{"root": "/p", "out": "/p/out/derived/tmp/schema/src", "modules": ["schema", "a.b"],'
                                  + ' "inputs": [{{"path": "data/a.txt", "size": 3, "sha256": "' + ABC + '"}},'
                                  + ' {{"path": "data/b.bin", "size": 3000000000000, "sha256": "' + EMPTY + '"}}]}}')
    testing.assertEqual(m.root, "/p")
    testing.assertEqual(m.out, "/p/out/derived/tmp/schema/src")
    testing.assertEqual(m.modules, ["schema", "a.b"])
    testing.assertEqual([f.path for f in m.inputs], ["data/a.txt", "data/b.bin"])
    testing.assertEqual([f.size for f in m.inputs], [3, 3000000000000])
    testing.assertEqual([f.sha256 for f in m.inputs], [ABC, EMPTY])
    for text in ['{{"out": "o", "modules": [], "inputs": []}}',
                 '{{"root": 1, "out": "o", "modules": [], "inputs": []}}',
                 '{{"root": "r", "out": "o", "modules": "m", "inputs": []}}',
                 '{{"root": "r", "out": "o", "modules": [1], "inputs": []}}',
                 '{{"root": "r", "out": "o", "modules": [], "inputs": {{}}}}',
                 '{{"root": "r", "out": "o", "modules": []}}',
                 '{{"root": "r", "out": "o", "modules": [], "inputs": ["data/a.txt"]}}',
                 '{{"root": "r", "out": "o", "modules": [], "inputs": [{{"size": 3, "sha256": "' + ABC + '"}}]}}',
                 '{{"root": "r", "out": "o", "modules": [], "inputs": [{{"path": "a", "sha256": "' + ABC + '"}}]}}',
                 '{{"root": "r", "out": "o", "modules": [], "inputs": [{{"path": "a", "size": "3", "sha256": "' + ABC + '"}}]}}',
                 '{{"root": "r", "out": "o", "modules": [], "inputs": [{{"path": "a", "size": 3}}]}}']:
        try:
            derive.Manifest.from_json(text)
            testing.error("accepted " + text)
        except ValueError:
            pass

def _test_input_of():
    """input_of describes the content that it is given"""
    f = derive.input_of("web/app.js", b"abc")
    testing.assertEqual(f.path, "web/app.js")
    testing.assertEqual(f.size, 3)
    testing.assertEqual(f.sha256, ABC)
    testing.assertEqual(f.read(), b"abc")
    empty = derive.input_of("web/empty", b"")
    testing.assertEqual(empty.size, 0)
    testing.assertEqual(empty.sha256, EMPTY)
    testing.assertEqual(empty.read(), b"")

pure def described(path: str, content: bytes) -> (str, int, str):
    """The path, the size and the SHA-256 of the description of the given content"""
    f = derive.input_of(path, content)
    return (f.path, f.size, f.sha256)

def _test_description_without_effect():
    """input_of and the attributes of a description have no effect: a pure function uses them"""
    testing.assertEqual(described("web/app.js", b"abc"), ("web/app.js", 3, ABC))

def _test_read_changed_content():
    """read raises when the content is not the described content"""
    testing.assertEqual(derive.InputFile("data/a.txt", 3, ABC, pure lambda: b"abc").read(), b"abc")
    # Other content of the described size, and content of another size
    for content in [b"abd", b"abcd", b""]:
        try:
            derive.InputFile("data/a.txt", 3, ABC, pure lambda: content).read()
            testing.error("read returned " + str(content))
        except ValueError as exc:
            testing.assertEqual(exc.error_message, "the input file data/a.txt changed while the function ran")

def _test_str_literal():
    testing.assertEqual(derive.str_literal("/index.html"), '"/index.html"')
    testing.assertEqual(derive.str_literal(""), '""')
    testing.assertEqual(derive.str_literal('a"b\\c'), '"a\\"b\\\\c"')
    # A brace in a str literal is written twice
    testing.assertEqual(derive.str_literal("a{{b}}"), '"a{{{{b}}}}"')
    # A character below 32, and 127
    testing.assertEqual(derive.str_literal("a\nb\tc\x00d\x1fe\x7ff"), '"a\\x0ab\\x09c\\x00d\\x1fe\\x7ff"')
    # A space, a tilde and a character above 127 are written as they are
    plain = " ~" + chr(128) + chr(229) + chr(8364)
    testing.assertEqual(derive.str_literal(plain), '"' + plain + '"')

def _test_embed_call():
    """embed_call takes the paths that embed takes and refuses the paths that embed refuses"""
    testing.assertEqual(derive.embed_call("web/app.js"), 'embed("web/app.js")')
    paths = json.decode(EMBED_PATHS.decode())
    taken = derive.manifest_strs("taken", paths.get("taken"))
    refused = derive.manifest_strs("refused", paths.get("refused"))
    # The parser ends the path of embed at a double quote, so embed_call
    # alone meets a path with one.
    testing.assertIn('a"b', refused)
    for path in taken:
        testing.assertEqual(derive.embed_call(path), 'embed("' + path + '")')
    for path in refused:
        try:
            derive.embed_call(path)
            testing.error("embed_call took the path " + derive.str_literal(path))
        except ValueError as exc:
            testing.assertEqual(exc.error_message, 'embed cannot name the file "' + path + '"' + EMBED_RULE)

pure def not_read() -> bytes:
    """The reader of an input file that a function does not read"""
    raise ValueError("an input file was read")

def _test_embed_files():
    """embed_files returns a module with one embed expression for each input file, and reads no input file"""
    inputs = {path: derive.InputFile(path, 3, ABC, not_read) for path in ["web/app.js", "web/img/a b.png", "web/index.html"]}
    testing.assertEqual(derive.embed_files(inputs, strip="web"),
                        "# Derived by std.build.derive.embed_files.\n"
                        + "\n"
                        + "files: dict[str, bytes] = {{\n"
                        + '    "/app.js": embed("web/app.js"),\n'
                        + '    "/img/a b.png": embed("web/img/a b.png"),\n'
                        + '    "/index.html": embed("web/index.html"),\n'
                        + "}}\n")
    # Without strip a path is written as it is.  strip is a prefix of
    # characters, not of components.
    one = {"web/app.js": derive.InputFile("web/app.js", 3, ABC, not_read)}
    testing.assertEqual(derive.embed_files(one),
                        '# Derived by std.build.derive.embed_files.\n\nfiles: dict[str, bytes] = {{\n    "web/app.js": embed("web/app.js"),\n}}\n')
    testing.assertEqual(derive.embed_files(one, strip="web/a"),
                        '# Derived by std.build.derive.embed_files.\n\nfiles: dict[str, bytes] = {{\n    "pp.js": embed("web/app.js"),\n}}\n')
    testing.assertEqual(derive.embed_files({}), "# Derived by std.build.derive.embed_files.\n\nfiles: dict[str, bytes] = {{\n}}\n")

def _test_embed_files_refusals():
    """embed_files raises for a path that does not start with strip and for a path that embed refuses"""
    inputs = {path: derive.InputFile(path, 3, ABC, not_read) for path in ["web/app.js", "www/index.html"]}
    # A prefix of the other path, a prefix of no path, a text that is longer
    # than the path that it starts with, and another spelling of a prefix
    for strip, path in [("web", "www/index.html"), ("data", "web/app.js"), ("web/app.js.map", "web/app.js"), ("Web", "web/app.js")]:
        try:
            derive.embed_files(inputs, strip=strip)
            testing.error("embed_files took strip=" + strip)
        except ValueError as exc:
            testing.assertEqual(exc.error_message, 'the path of the input file "' + path + '" does not start with the prefix strip="' + strip + '"')
    # A brace in a str literal is written twice
    try:
        derive.embed_files({"web/a{{b}}.txt": derive.InputFile("web/a{{b}}.txt", 3, ABC, not_read)}, strip="web")
        testing.error("embed_files took a path that embed refuses")
    except ValueError as exc:
        testing.assertEqual(exc.error_message, 'embed cannot name the file "web/a{{b}}.txt"' + EMBED_RULE)

def page_table(inputs: dict[str, derive.InputFile]) -> str:
    """The source of a module with the content of each input file and a tag from its SHA-256

    A function of a project for an entry, as the guide page on embed shows it.
    """
    lines = ["table: dict[str, (body: bytes, etag: str)] = {{"]
    for path, f in inputs.items():
        etag = derive.str_literal('"' + f.sha256[:32] + '"')
        lines.append("    " + derive.str_literal(path)
                     + ": (body=" + derive.embed_call(path) + ", etag=" + etag + "),")
    lines.append("}}")
    return "\n".join(lines) + "\n"

def _test_function_with_embed_call():
    """A function of a project writes an embed expression and str literals for each input file"""
    inputs = {path: derive.input_of(path, b"abc") for path in ["web/app.js", "web/index.html"]}
    testing.assertEqual(page_table(inputs),
                        "table: dict[str, (body: bytes, etag: str)] = {{\n"
                        + '    "web/app.js": (body=embed("web/app.js"), etag="\\"' + ABC[:32] + '\\""),\n'
                        + '    "web/index.html": (body=embed("web/index.html"), etag="\\"' + ABC[:32] + '\\""),\n'
                        + "}}\n")

actor _test_input_files(t: testing.EnvT):
    """input_files opens no file, and read returns the content of the file of its description"""

    proc def __startup__():
        try:
            fc = file.FileCap(t.env.cap)
            fs = file.FS(fc)
            tmpdir = fs.mktmpdir()
            try:
                for name, content in [("kept", b"abc"), ("written", b"abd")]:
                    wf = file.WriteFile(file.WriteFileCap(fc), tmpdir + "/" + name)
                    await async wf.write(content)
                    await async wf.close()
                # The manifest describes the content abc for each file.  The
                # file written holds other content, and there is no file
                # missing: a description is made without opening its file.
                m = derive.Manifest(tmpdir, tmpdir, [], [(path=name, size=3, sha256=ABC) for name in ["kept", "missing", "written"]])
                inputs = derive.input_files(derive.Files(t.env), m)
                testing.assertEqual(list(inputs.keys()), ["kept", "missing", "written"])
                testing.assertEqual([f.path for f in inputs.values()], ["kept", "missing", "written"])
                testing.assertEqual([f.size for f in inputs.values()], [3, 3, 3])
                testing.assertEqual([f.sha256 for f in inputs.values()], [ABC, ABC, ABC])
                testing.assertEqual(inputs["kept"].read(), b"abc")
                try:
                    inputs["written"].read()
                    testing.error("read returned content that is not the described content")
                except ValueError as exc:
                    testing.assertEqual(exc.error_message, "the input file written changed while the function ran")
            finally:
                await async fs.rmtree(tmpdir)
            t.success()
        except AssertionError as exc:
            t.failure(exc)
        except Exception as exc:
            t.error(exc)

actor _test_read_closes_files(t: testing.EnvT):
    """read leaves no input file open"""

    proc def __startup__():
        try:
            fc = file.FileCap(t.env.cap)
            fs = file.FS(fc)
            tmpdir = fs.mktmpdir()
            try:
                names = ["f" + str(i) for i in range(32)]
                for name in names:
                    wf = file.WriteFile(file.WriteFileCap(fc), tmpdir + "/" + name)
                    await async wf.write(name.encode())
                    await async wf.close()
                described = [derive.input_of(name, name.encode()) for name in names]
                m = derive.Manifest(tmpdir, tmpdir, [], [(path=f.path, size=f.size, sha256=f.sha256) for f in described])
                inputs = derive.input_files(derive.Files(t.env), m)
                open_before = t.env.rts.fd_stats().open
                contents = {name: f.read() for name, f in inputs.items()}
                open_after = t.env.rts.fd_stats().open
                testing.assertEqual(contents, {name: name.encode() for name in names})
                # fd_stats counts every descriptor of the process, and other
                # actors open and close descriptors meanwhile.  A read that
                # left its input file open would add len(names).
                if open_before is not None and open_after is not None:
                    testing.assertTrue(int(open_after) < int(open_before) + len(names),
                                       "%d descriptors open before the reads and %d after" % (int(open_before), int(open_after)))
            finally:
                await async fs.rmtree(tmpdir)
            t.success()
        except AssertionError as exc:
            t.failure(exc)
        except Exception as exc:
            t.error(exc)

actor _test_write_modules_mkdir_error(t: testing.EnvT):
    """write_modules raises the error of a directory that it cannot create"""

    proc def __startup__():
        try:
            fs = file.FS(file.FileCap(t.env.cap))
            tmpdir = fs.mktmpdir()
            try:
                files = derive.Files(t.env)
                # The directory out is missing, so no directory can be
                # created in it.
                m = derive.Manifest(tmpdir, tmpdir + "/out", [], [])
                try:
                    await async files.write_modules(m, {"layers.a": ""})
                    testing.error("wrote a module to a directory that is missing")
                except OSError as exc:
                    testing.assertTrue(exc.error_message.startswith("Error creating directory"), exc.error_message)
            finally:
                await async fs.rmtree(tmpdir)
            t.success()
        except AssertionError as exc:
            t.failure(exc)
        except Exception as exc:
            t.error(exc)
