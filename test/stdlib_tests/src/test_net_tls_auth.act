# TLS certificate verification, client certificates and handshake errors
#
# The certificates were made with openssl for these tests, valid for 100
# years: a test CA, a server certificate for localhost, 127.0.0.1 and ::1 and
# a client certificate both from the test CA, and an unrelated other CA.

import base64
import net
import testing


