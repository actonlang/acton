def pem_to_der(pem: bytes) -> bytes:
    body = [line for line in pem.splitlines() if not line.startswith(b"-----")]
    return base64.decode(b"".join(body))


actor tls_handshake(t: testing.EnvT, what: str,
                    check: action(tls_handshake, ?net.TLSConnection, ?net.TLSListenConnection, list[str], list[str]) -> None,
                    client_auth: bool=False, server_ca_pem: ?bytes=None, server_protocols: list[str]=[],
                    ca_pem: ?bytes=None, cert_pem: ?bytes=None, key_pem: ?bytes=None,
                    server_name: ?str=None, protocols: list[str]=[]):
    """A TLS handshake between a listener and a client with the given settings

    Calls check with the connected client and the accepted connection, None
    for those that failed, and the errors of the client and the listener.
    """
    listen_cap = net.TCPListenCap(net.TCPCap(net.NetCap(t.env.cap)))
    connect_cap = net.TCPConnectCap(net.TCPCap(net.NetCap(t.env.cap)))
    var done = False
    var listener: ?net.TLSListener = None
    var client: ?net.TLSConnection = None
    var server_conn: ?net.TLSListenConnection = None
    var client_errors: list[str] = []
    var server_errors: list[str] = []
    var port = 0

    def finish():
        if done:
            return
        done = True
        check(self, client, server_conn, client_errors, server_errors)

    def success():
        _close()
        t.success()

    def failure(msg: str):
        _close()
        t.failure(AssertionError(what + ": " + msg))

    def _close():
        if listener is not None:
            listener.close()
        if server_conn is not None:
            server_conn.close()
        if client is not None:
            client.close(lambda c: None)

    def on_listen(l: net.TLSListener, error: ?str):
        if error is not None:
            if listener is None:
                failure("listen error: " + error)
            else:
                # A failed handshake
                server_errors.append(error)
            return
        listener = l
        port = l.local_port()
        net.TLSConnection(connect_cap, "127.0.0.1", port, on_connect, on_receive, on_error, None,
                          protocols=protocols, ca_pem=ca_pem, cert_pem=cert_pem, key_pem=key_pem,
                          server_name=server_name)

    def on_accept(s: net.TLSListenConnection):
        server_conn = s
        s.cb_install(on_server_receive, on_server_error, None)

    def on_server_receive(s: net.TLSListenConnection, data: bytes):
        pass

    def on_server_error(s: net.TLSListenConnection, error: str):
        server_errors.append(error)

    def on_connect(c: net.TLSConnection):
        client = c
        # Let the listener side settle. With TLS 1.3 the server checks a
        # client certificate after the client completed the handshake, so
        # a rejection arrives as on_error after on_connect.
        after 0.5: finish()

    def on_receive(c: net.TLSConnection, data: bytes):
        pass

    def on_error(c: net.TLSConnection, error: str):
        client_errors.append(error)
        after 0.3: finish()

    after 8: finish()
    net.TLSListener(listen_cap, "127.0.0.1", 0, SERVER_CERT_PEM, SERVER_KEY_PEM, on_listen, on_accept,
                    client_auth=client_auth, ca_pem=server_ca_pem, protocols=server_protocols)


def find_error(errors: list[str], text: str) -> bool:
    for e in errors:
        if e.find(text) != -1:
            return True
    return False


actor _test_TLSMutualAuth(t: testing.EnvT):
    """Both ends present a certificate from a private CA and see the other's"""
    def check(h: tls_handshake, c: ?net.TLSConnection, s: ?net.TLSListenConnection, client_errors: list[str], server_errors: list[str]):
        if c is not None and s is not None:
            mutual_auth_check(h, c, s, server_errors)
        else:
            h.failure("handshake failed: %s %s" % (str(client_errors), str(server_errors)))

    tls_handshake(t, "mutual TLS", check, client_auth=True, server_ca_pem=CA_PEM, server_protocols=["h2", "http/1.1"],
                  ca_pem=CA_PEM, cert_pem=CLIENT_CERT_PEM, key_pem=CLIENT_KEY_PEM, protocols=["http/1.1"])


def mutual_auth_check(h: tls_handshake, c: net.TLSConnection, s: net.TLSListenConnection, server_errors: list[str]):
    client_tls = c.tls_info()
    server_tls = s.tls_info()
    client_ep = c.endpoints()
    server_ep = s.endpoints()
    try:
        testing.assertEqual(client_tls.verify_result, 0, "client verify result")
        testing.assertEqual(client_tls.peer_certificates, [pem_to_der(SERVER_CERT_PEM)], "server certificate chain")
        testing.assertEqual(server_tls.verify_result, 0, "server verify result")
        testing.assertEqual(server_tls.peer_certificates, [pem_to_der(CLIENT_CERT_PEM)], "client certificate chain")
        testing.assertEqual(client_tls.alpn, "http/1.1", "client ALPN")
        testing.assertEqual(server_tls.alpn, "http/1.1", "server ALPN")
        testing.assertEqual(client_tls.version, "TLSv1.3", "client TLS version")
        testing.assertEqual(server_tls.version, "TLSv1.3", "server TLS version")
        testing.assertEqual(server_ep.remote_address, "127.0.0.1", "accepted connection remote address")
        testing.assertEqual(server_ep.remote_port, client_ep.local_port, "accepted connection remote port")
        testing.assertEqual(client_ep.remote_port, server_ep.local_port, "client remote port")
        testing.assertEqual(server_errors, [], "server errors")
    except AssertionError as e:
        h.failure(str(e))
        return
    h.success()


actor _test_TLSMissingClientCert(t: testing.EnvT):
    """A client without a certificate is rejected when the server requires one"""
    def check(h: tls_handshake, c: ?net.TLSConnection, s: ?net.TLSListenConnection, client_errors: list[str], server_errors: list[str]):
        if s is not None:
            h.failure("server accepted a client without a certificate")
        elif len(client_errors) != 1 or len(server_errors) != 1:
            h.failure("errors: %s %s" % (str(client_errors), str(server_errors)))
        else:
            h.success()

    tls_handshake(t, "missing client certificate", check, client_auth=True, server_ca_pem=CA_PEM, ca_pem=CA_PEM)


actor _test_TLSClientCertUnknownCA(t: testing.EnvT):
    """A client certificate from a CA the server does not trust is rejected"""
    def check(h: tls_handshake, c: ?net.TLSConnection, s: ?net.TLSListenConnection, client_errors: list[str], server_errors: list[str]):
        if s is not None:
            h.failure("server accepted an untrusted client certificate")
        elif len(client_errors) != 1 or len(server_errors) != 1:
            h.failure("errors: %s %s" % (str(client_errors), str(server_errors)))
        else:
            h.success()

    tls_handshake(t, "untrusted client certificate", check, client_auth=True, server_ca_pem=OTHER_CA_PEM,
                  ca_pem=CA_PEM, cert_pem=CLIENT_CERT_PEM, key_pem=CLIENT_KEY_PEM)


actor _test_TLSServerCertUnknownCA(t: testing.EnvT):
    """A server certificate from a CA the client does not trust is rejected"""
    def check(h: tls_handshake, c: ?net.TLSConnection, s: ?net.TLSListenConnection, client_errors: list[str], server_errors: list[str]):
        if c is not None:
            h.failure("client connected to an untrusted server")
        elif len(client_errors) != 1:
            h.failure("client errors: " + str(client_errors))
        else:
            h.success()

    tls_handshake(t, "untrusted server certificate", check, ca_pem=OTHER_CA_PEM)


actor _test_TLSServerNameMismatch(t: testing.EnvT):
    """A server certificate that does not match server_name is rejected"""
    def check(h: tls_handshake, c: ?net.TLSConnection, s: ?net.TLSListenConnection, client_errors: list[str], server_errors: list[str]):
        if c is not None:
            h.failure("client connected to a server with the wrong name")
        elif len(client_errors) != 1:
            h.failure("client errors: " + str(client_errors))
        else:
            h.success()

    tls_handshake(t, "server name mismatch", check, ca_pem=CA_PEM, server_name="wrong.example")


actor tls_server_name_ok(t: testing.EnvT, server_name: str):
    """The server certificate verifies with server_name"""
    def check(h: tls_handshake, c: ?net.TLSConnection, s: ?net.TLSListenConnection, client_errors: list[str], server_errors: list[str]):
        if c is not None:
            result = c.tls_info().verify_result
            if result != 0:
                h.failure("verify result %d" % result)
            else:
                h.success()
        else:
            h.failure("client errors: " + str(client_errors))

    tls_handshake(t, "server name '" + server_name + "'", check, ca_pem=CA_PEM, server_name=server_name)


actor _test_TLSServerNameLocalhost(t: testing.EnvT):
    tls_server_name_ok(t, "localhost")


actor _test_TLSServerNameNone(t: testing.EnvT):
    tls_server_name_ok(t, "")
