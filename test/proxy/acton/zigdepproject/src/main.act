import zlib.lib as z

# Using the dependency forces acton to link acton-zlib's zig artifact, which pulls
# in deps/zlib and its transitive zlib_upstream .url. Acton must fetch that archive
# through the proxy before zig uses the seeded cache during final compilation.
actor main(env):
    c = z.compress(b"hello world")
    d = z.decompress(c)
    print("roundtrip ok:", d == b"hello world")
    env.exit(0)
