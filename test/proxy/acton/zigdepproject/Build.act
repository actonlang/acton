name = "zigdeptest"
fingerprint = 0x0f2654ba77f95769

# A real Acton package dependency (actonlang/acton-zlib) that itself carries a
# *transitive* zig package dependency. acton-zlib wraps the C zlib via a
# zig_dependency whose deps/zlib/build.zig.zon declares:
#
#   .zlib_upstream = .{ .url = "https://github.com/madler/zlib/.../v1.3.1.tar.gz",
#                       .hash = "...", .lazy = false }
#
# Acton must fetch both acton-zlib and the nested zlib_upstream archive through
# its proxy-aware HTTP client before invoking Zig. Building the project checks
# that the prefetched transitive dependency is available during compilation.
dependencies = {
    "zlib": (
        url="https://github.com/actonlang/acton-zlib/archive/ef6fa1c75631b92ebee3cf01e9b6ace326a2db47.tar.gz",
        hash="N-V-__8AANAWAADerAg0qsvk6lkPK5j6I59zQv_vbZ2WAOvy",
        repo_url="https://github.com/actonlang/acton-zlib"
    )
}

zig_dependencies = {}
