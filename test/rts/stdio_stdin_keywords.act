# The keyword forms of env.stdio.set_stdin and env.stdio.stdin_install, with
# the other arguments left to their defaults. This is only built, not run,
# since the calls change the terminal settings when stdin is a terminal.
actor main(env: Env):
    def on_stdin(s: str):
        pass

    def on_stdin_bytes(b: bytes):
        pass

    env.stdio.set_stdin(canonical=False)
    env.stdio.set_stdin(echo=False)
    env.stdio.stdin_install(on_stdin)
    env.stdio.stdin_install(on_stdin_bytes=on_stdin_bytes)
    env.exit(0)
