# The RTS tests in compiler/acton/test.hs run this program with stdin on a
# pseudo terminal, read the settings of the terminal and type keys into it.
#
# It prints whether stdin and stdout are terminals, installs a stdin handler,
# puts stdin in raw mode and prints "ready". The handler collects the bytes up
# to a carriage return and prints them, then the program leaves raw mode,
# prints "cooked" and exits.
actor main(env: Env):
    var got: list[int] = []

    def on_key(b: bytes):
        for c in b:
            got.append(c)
        if 13 in got:
            print("got", got)
            await async env.stdio.set_stdin(raw=False)
            print("cooked")
            env.exit(0)

    print("stdin_is_tty", env.stdio.stdin_is_tty(), "is_tty", env.stdio.is_tty())
    await async env.stdio.stdin_install(on_stdin_bytes=on_key)
    await async env.stdio.set_stdin(raw=True)
    print("ready")
