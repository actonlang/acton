# The Computer Language Benchmarks Game
# Adapted from 1.go.

import math

def multiply(u: list[float], v: list[float], transpose: bool):
    n = len(u)
    for i in range(n):
        total = 0.0
        # Advancing the denominator avoids an integer multiply per element.
        denominator = i * (i + 1) // 2 + (1 if transpose else i + 1)
        for j in range(n):
            total += u[j] / float(denominator)
            denominator += i + j + (2 if transpose else 1)
        v[i] = total

def multiply_ata(u: list[float], v: list[float], scratch: list[float]):
    multiply(u, scratch, False)
    multiply(scratch, v, True)

actor main(env):
    n = int(env.argv[1]) if len(env.argv) > 1 else 100
    u = [1.0 for _ in range(n)]
    v = [0.0 for _ in range(n)]
    scratch = [0.0 for _ in range(n)]
    for _ in range(10):
        multiply_ata(u, v, scratch)
        multiply_ata(v, u, scratch)
    uv = 0.0
    vv = 0.0
    for i in range(n):
        uv += u[i] * v[i]
        vv += v[i] * v[i]
    print("%.9f" % math.sqrt(uv / vv))
    env.exit(0)
