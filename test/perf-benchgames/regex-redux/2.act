# The Computer Language Benchmarks Game
# Adapted from 1.py by Dominique Wahli, Ahmad Syukri, and Justin Peel.

import file
import re

actor main(env):
    path = env.argv[1] if len(env.argv) > 1 else "25000_in"
    source = file.ReadFile(file.ReadFileCap(file.FileCap(env.cap)), path)
    text = source.read().decode()
    source.close()
    original_length = len(text)
    text = re.replace(">.*\n|\n", text, "")
    clean_length = len(text)
    variants = [
        "agggtaaa|tttaccct",
        "[cgt]gggtaaa|tttaccc[acg]",
        "a[act]ggtaaa|tttacc[agt]t",
        "ag[act]gtaaa|tttac[agt]ct",
        "agg[act]taaa|ttta[agt]cct",
        "aggg[acg]aaa|ttt[cgt]ccct",
        "agggt[cgt]aa|tt[acg]accct",
        "agggta[cgt]a|t[acg]taccct",
        "agggtaa[cgt]|[acg]ttaccct"
    ]
    for pattern in variants:
        print("%s %d" % (pattern, re.count(pattern, text)))
    for pattern, replacement in [("tHa[Nt]", "<4>"), ("aND|caN|Ha[DS]|WaS", "<3>"),
                                 ("a[NSt]|BY", "<2>"), ("<[^>]*>", "|")]:
        text = re.replace(pattern, text, replacement)
    text = re.replace(r"\|[^|][^|]*\|", text, "-")
    print("\n%d\n%d\n%d" % (original_length, clean_length, len(text)))
    env.exit(0)
