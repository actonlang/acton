# The Computer Language Benchmarks Game
# Compute the packed bitmap and hash it, as in 1.go.

import crypto.hash.md5

def bitmap_row(size: int, ci: float, real: list[float]) -> bytes:
    row = []
    for x in range(0, size, 8):
        bits = 0
        for offset in range(8):
            cr = real[x + offset]
            zr = 0.0
            zi = 0.0
            tr = 0.0
            ti = 0.0
            iteration = 0
            while iteration < 50 and tr + ti <= 4.0:
                imaginary_product = (zr + zr) * zi
                zi = imaginary_product + ci
                real_difference = tr - ti
                zr = real_difference + cr
                tr = zr * zr
                ti = zi * zi
                iteration += 1
            bits = (bits << 1) | (1 if tr + ti <= 4.0 else 0)
        row.append(bits)
    return bytes(row)

actor main(env):
    size = int(env.argv[1]) if len(env.argv) > 1 else 200
    size = (size + 7) // 8 * 8
    inv = 2.0 / float(size)
    real = [float(x) * inv for x in range(size)]
    imaginary = [float(y) * inv for y in range(size)]
    # Separate passes preserve the reference's rounding at the axis boundary.
    for i in range(size):
        real[i] -= 1.5
        imaginary[i] -= 1.0
    pixels = []
    for y in range(size):
        pixels.append(bitmap_row(size, imaginary[y], real))
    print("P4\n%d %d" % (size, size))
    print(crypto.hash.md5.hash(b"".join(pixels)).hex())
    env.exit(0)
