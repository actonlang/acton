# Acton port of https://github.com/actonlang/Programming-Language-Benchmarks/blob/main/bench/algorithm/pidigits/4.py
actor main(env):
    n = int(env.argv[1])

    var tmp1 = bigint(0)
    var tmp2 = bigint(0)

    var acc = bigint(0)
    var den = bigint(1)
    var num = bigint(1)

    def extract_Digit(nth):
        tmp1 = num * nth
        tmp2 = tmp1 + acc
        tmp1 = tmp2 // den

        return tmp1

    def eliminate_Digit(d):
        acc = acc - den * d
        acc = acc * 10
        num = num * 10

    def next_Term(k):
        k2=bigint(k*2+1)
        acc = acc + num * 2
        acc = acc * k2
        den = den * k2
        num = num * bigint(k)

    var i=0
    var k=0
    var res = ""
    while i<n:
        k+=1
        next_Term(k)

        if num > acc:
            continue

        d=extract_Digit(3)
        if d!=extract_Digit(4):
            continue

        res += chr(48+int(d))
        i += 1
        if i % 10 == 0:
            print("%s\t:%d" % (res, i))
            res = ""
        eliminate_Digit(d)
    remainder = i % 10
    if remainder != 0:
        spaces = ""
        for j in range(0, (10-(len(res))), 1):
            spaces += " "
        print("%s%s\t:%d" % (res, spaces, i))
    env.exit(0)
