    "test_bytearray_partition_new_objects": test_bytearray_partition_new_objects,
    "test_bytearray_del_slice_steps": test_bytearray_del_slice_steps,
    "test_bytearray_byte_range": test_bytearray_byte_range,
    "test_bytearray_istitle": test_bytearray_istitle,
