    print("empty bytearray.upper(): {result}")
    return result == bytearray(b"")

def test_empty_bytearray_zfill():
    result = bytearray(b"").zfill(5)
    print("empty bytearray.zfill(5): {result}")
    return result == bytearray(b"00000")

def test_bytearray_startswith_same_length():
    result = bytearray(b"foo").startswith(bytearray(b"foo"))
    print("bytearray(b'foo').startswith(bytearray(b'foo')): {result}")
    return result == True

def test_bytearray_startswith_prefix():
    result = bytearray(b"hello world").startswith(bytearray(b"hello"))
    print("bytearray(b'hello world').startswith(bytearray(b'hello')): {result}")
    return result == True

def test_bytearray_startswith_not_prefix():
    result = bytearray(b"hello world").startswith(bytearray(b"world"))
    print("bytearray(b'hello world').startswith(bytearray(b'world')): {result}")
    return result == False

def test_bytearray_startswith_empty():
    result = bytearray(b"hello world").startswith(bytearray(b""))
    print("bytearray(b'hello world').startswith(bytearray(b'')): {result}")
    return result == True

def test_bytearray_startswith_single_char():
    result = bytearray(b"a").startswith(bytearray(b"a"))
    print("bytearray(b'a').startswith(bytearray(b'a')): {result}")
    return result == True

def test_bytearray_startswith_longer_prefix():
    result = bytearray(b"foo").startswith(bytearray(b"foobar"))
    print("bytearray(b'foo').startswith(bytearray(b'foobar')): {result}")
    return result == False

def test_bytearray_compare_nul():
    # NUL is an ordinary byte, comparisons must look at all bytes
    a = bytearray(bytes([97, 0, 98]))
    b = bytearray(bytes([97, 0, 99]))
    prefix = bytearray(bytes([97, 0]))
    print("bytearray comparisons with NUL bytes")
    return (a != b and not a == b and a < b and a <= b and b > a and b >= a
            and prefix < a and a > prefix and prefix != a
            and a == bytearray(bytes([97, 0, 98])) and not a < a and a <= a)

def test_bytearray_endswith_nul():
    s = bytearray(bytes([97, 0]))
    print("bytearray endswith with NUL bytes")
    return (s.endswith(bytearray(bytes([0])))
            and s.endswith(bytearray(bytes([97, 0])))
            and not s.endswith(bytearray(bytes([97, 0])), 1)
            and not bytearray(b"a").endswith(bytearray(b"ba")))

def test_empty_bytearray_hex():
    result = bytearray(b"\xde\xad\xbe\xef").hex()
    print("empty bytearray.hex(): '{result}'")
    return result == "deadbeef"

def test_empty_bytearray_from_hex():
    result = bytearray.from_hex("deadbeef").hex()
    print("empty bytearray.from_hex(''): {result}")
    return result == "deadbeef"

def test_bytearray_hex():
    ba = bytearray(b"\xde\xad\xbe\xef")
    result = ba.hex()
    print("bytearray.hex(): {result}")
    return result == "deadbeef"

def test_bytearray_lower_upper():
    # Only ASCII letters change case, all other bytes are copied unchanged
    rest = bytes([0xc4, 0xe4, 0xd6, 0xf6, 0, 0x7f, 0xff])
    source = bytearray(b"Hello, World! 123 " * 10 + rest)
    lower = source.lower()
    upper = source.upper()
    print("bytearray lower: {lower}")
    print("bytearray upper: {upper}")
    return (lower == bytearray(b"hello, world! 123 " * 10 + rest)
            and upper == bytearray(b"HELLO, WORLD! 123 " * 10 + rest)
            and bytearray(b"").lower() == bytearray(b"")
            and bytearray(b"").upper() == bytearray(b""))

def test_bytearray_capitalize():
    source = bytearray(bytes([0xe4]) + b"ABC dEF")
    print("bytearray capitalize: {source.capitalize()}")
    return (bytearray(b"hello WORLD").capitalize() == bytearray(b"Hello world")
            and source.capitalize() == bytearray(bytes([0xe4]) + b"abc def"))

def test_bytearray_isupper():
    print("bytearray isupper")
    return (bytearray(b"ABC").isupper() and bytearray(b"A1 B!").isupper()
            and not bytearray(b"AbC").isupper() and not bytearray(b"123").isupper()
            and not bytearray(b"").isupper() and not bytearray(bytes([0xc4])).isupper())

def test_bytearray_expandtabs():
    # bytearray has no encoding, so every byte takes one column
    high = bytearray(bytes([0xe0, 0x41, 0x09, 0x42]))
    print("bytearray expandtabs: {high.expandtabs(4)}")
    return (bytearray(b"a\tb").expandtabs(4) == bytearray(b"a   b")
            and bytearray(b"ab\ncd\te\rf\tg").expandtabs(4) == bytearray(b"ab\ncd  e\rf   g")
            and bytearray(b"\t").expandtabs(0) == bytearray(b" ")
            and bytearray(b"").expandtabs(4) == bytearray(b"")
            and high.expandtabs(4) == bytearray(bytes([0xe0, 0x41, 0x20, 0x20, 0x42])))

def test_bytearray_expandtabs_high_bytes():
    # Bytes from 0xc0 up used to be copied as UTF-8 sequences, which read
    # past the data and wrote past the result buffer on the stack
    source = bytearray(bytes([0xf0, 0xf0, 0xf0, 0xf0]) * 4096)
    result = source.expandtabs(1)
    print("bytearray expandtabs of 0xf0 bytes: {len(result)} bytes")
    return result == source

def test_bytearray_expandtabs_default():
    result = bytearray(b"a\tb").expandtabs()
    print("bytearray expandtabs(): {result}")
    return result == bytearray(b"a       b")

def test_bytearray_expandtabs_wide():
    # The result is as long as the input, whatever the tab size
    result = bytearray(b"x" * 100).expandtabs(1000000)
    print("bytearray expandtabs(1000000) without tabs: {len(result)} bytes")
    return result == bytearray(b"x" * 100)

def test_bytearray_from_hex():
    result = bytearray.from_hex("deadbeef").hex()
    print("bytearray.from_hex('deadbeef').hex(): {result}")
    return result == "deadbeef"

tests = {
    "test_bytearray_basic_len": test_bytearray_basic_len,
    "test_bytearray_basic_indexing": test_bytearray_basic_indexing,
    "test_bytearray_basic_modification": test_bytearray_basic_modification,
    "test_bytearray_basic_slicing": test_bytearray_basic_slicing,
