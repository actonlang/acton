def check_int_strings():
    cases: list[(str, int)] = [
        ("0", 0), ("-0", 0), ("-1", -1), ("-27294", -27294),
        ("2147483648", 2147483648), ("-2147483649", -2147483649),
        ("4294967296", 4294967296), ("-4294967296", -4294967296),
        ("9223372036854775807", 9223372036854775807),
        ("-9223372036854775808", -9223372036854775807 - 1),
        ("-0x6a9e", -27294), ("-0o65236", -27294),
        ("-0b110101010011110", -27294),
        ("-0x8000000000000000", -9223372036854775807 - 1),
    ]
    for text, expected in cases:
        assert int(text) == expected, "int(" + text + ")"
        b = bigint(text)
        assert b == bigint(expected), "bigint(" + text + ")"
        assert int(b) == expected, "int(bigint(" + text + "))"
        assert str(b) == str(expected), "str(bigint(" + text + "))"
    assert int("-6a9e", 16) == -27294
    assert int("-1000000000000000", 16) == -1152921504606846976

def check_out_of_range():
    # int is bounded; these strings remain exact as bigints and must be
    # rejected by int both directly and after parsing them as bigints.
    cases: list[(str, bigint)] = [
        ("9223372036854775808", bigint(9223372036854775807) + 1),
        ("-9223372036854775809", -bigint(9223372036854775807) - 2),
        ("18446744073709551615", bigint(18446744073709551615)),
        ("18446744073709551616", 18446744073709551616),
        ("-18446744073709551616", -18446744073709551616),
        ("-18446744073709551617", -18446744073709551617),
        ("-123456789012345678901234567890", -123456789012345678901234567890),
    ]
    for text, expected in cases:
        b = bigint(text)
        assert b == expected, "bigint(" + text + ")"
        assert str(b) == text, "str(bigint(" + text + "))"
        try:
            int(text)
        except ValueError:
            pass
        else:
            raise ValueError("int accepted " + text)
        try:
            int(b)
        except ValueError:
            pass
        else:
            raise ValueError("int accepted bigint " + text)

def check_scalar_conversions():
    assert bigint(4294967296) == bigint("4294967296")
    assert bigint(-4294967296) == bigint("-4294967296")
    assert bigint(18446744073709551615) == bigint("18446744073709551615")
    assert u64("18446744073709551615") == 18446744073709551615
    assert bigint(4294967296.0) == bigint("4294967296")
    assert bigint(-4294967296.0) == bigint("-4294967296")
    assert bigint(9007199254740992.0) == bigint("9007199254740992")
    assert int(-4294967296.0) == -4294967296
    assert i32("-2147483648") == -2147483648
    assert i16("-32768") == -32768
    assert i8("-128") == -128
    # A wide magnitude must not truncate to a value that fits a small type.
    for text in ["4294967297", "-4294967297"]:
        try:
            i8(text)
        except ValueError:
            pass
        else:
            raise ValueError("i8 accepted " + text)
    for base in [4294967298, -4294967294]:
        try:
            int("1", base)
        except ValueError:
            pass
        else:
            raise ValueError("int accepted base " + str(base))

actor main(env):
    try:
        check_int_strings()
        check_out_of_range()
        check_scalar_conversions()
        env.exit(0)
    except Exception as e:
        print(e)
        env.exit(1)
