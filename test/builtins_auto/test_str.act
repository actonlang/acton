    "test_empty_str_isdecimal": test_empty_str_isdecimal,
    "test_empty_str_islower": test_empty_str_islower,
    "test_empty_str_isprintable": test_empty_str_isprintable,
    "test_empty_str_isspace": test_empty_str_isspace,
