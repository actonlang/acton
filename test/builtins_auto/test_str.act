
def test_str_find():
    s = "hello, world!"
    print("Testing str.find()")
    return (s.find("hello, world!") == 0 and
            s.find("world") == 7 and
            s.find("world", 0) == 7 and
            s.find("world", 8) == -1 and
            s.find("world", 0, 5) == -1 and
            s.find("world", 0, 7) == -1 and
            s.find("crap") == -1)

def test_str_expandtabs_chars():
    # Columns count characters, whatever their UTF-8 length
    print("str expandtabs: {repr("é\tx".expandtabs(4))} {repr("€\tx".expandtabs(4))}")
    return ("é\tx".expandtabs(4) == "é   x"
            and "€\tx".expandtabs(4) == "€   x"
            and "𝄞\tx".expandtabs(4) == "𝄞   x"
            and "ab\tc\nd\te".expandtabs(4) == "ab  c\nd   e"
            and "a\tb".expandtabs() == "a       b"
            and "\t".expandtabs(0) == " "
            and len("é\t".expandtabs(8)) == 8)

def test_str_expandtabs_large():
    # The result is built on the heap, not in a stack buffer sized by the
    # input and the tab size
    wide = ("x" * 100).expandtabs(1000000)
    many = ("é" * 5000 + "\t").expandtabs(1)
    print("str expandtabs of large inputs: {len(wide)} {len(many)}")
    return wide == "x" * 100 and many == "é" * 5000 + " "

def test_str_case_utf8_length():
    # Case mapping can change the UTF-8 length of a character
    print("str case mapping with length changes: {"ɐı".upper()} {"ɐBC".capitalize()}")
    return ("ɐı".upper() == "ⱯI" and "ⱯI".lower() == "ɐi"
            and "ɐBC".capitalize() == "Ɐbc" and "hELLO wORLD".capitalize() == "Hello world")

def test_str_upper_large():
    # upper builds its result on the heap, not in a stack array of four bytes
    # per character
    u = ("a" * 30000000).upper()
    print("str upper of 30000000 chars: {len(u)}")
    return len(u) == 30000000 and u.count("A") == 30000000

def test_str_slice_steps():
    s = "aéb€c𝄞d"
    print("str slices with steps: {s[::2]} {s[::-1]} {s[::-2]} {s[5:0:-2]} {s[1:6:2]}")
    return (s[::2] == "abcd" and s[::-1] == "d𝄞c€béa" and s[::-2] == "dcba"
            and s[5:0:-2] == "𝄞€é" and s[1:6:2] == "é€𝄞" and s[1:3] == "éb"
            and s[3:] == "€c𝄞d" and s[:0] == "" and s[6:0:-3] == "d€")

def test_str_slice_large():
    # A slice is built on the heap, not in a stack array of four bytes per
    # character
    r = ("a" * 30000000)[1:]
    print("str slice of 30000000 chars: {len(r)}")
    return len(r) == 29999999 and r.count("a") == 29999999

def test_str_split_sep():
    parts = ("ab," * 20000).split(",")
    print("str split with a separator: {len(parts)} parts")
    return ("a,b,c".split(",", 0) == ["a,b,c"]
            and "a,b,c".split(",", 1) == ["a", "b,c"]
            and "a,b,c".split(",", -1) == ["a", "b", "c"]
            and "a,,b,".split(",") == ["a", "", "b", ""]
            and "".split(",") == [""]
            and "abc".split("xyz") == ["abc"]
            and "é€::𝄞::".split("::", 5) == ["é€", "𝄞", ""]
            and [len(x) for x in "é€,𝄞a,".split(",")] == [2, 2, 0]
            and len(parts) == 20001 and parts[0] == "ab" and parts[20000] == "")

def test_str_empty_substring():
    # The empty string occurs before every character and at the end
    print("str count and replace of the empty string: {"é€".count("")} {"é€".replace("", "-")}")
    return ("é€".count("") == 3 and "abc".count("") == 4 and "abc".count("", 1, 2) == 2
            and "abc".count("", 2, 1) == 0 and "abc".count("", 3) == 1 and "abc".count("", 4) == 0
            and "é€".replace("", "-") == "-é-€-" and len("é€".replace("", "-")) == 5
            and "é€".replace("", "-", 2) == "-é-€" and "abc".replace("", "-") == "-a-b-c-")

def test_empty_str_capitalize():
    result = "".capitalize()
    print("empty str.capitalize(): '{result}'")
    return result == ""

def test_empty_str_center():
    result = "".center(5)
    print("empty str.center(5): '{result}'")
    return result == "     "

def test_empty_str_count():
    result = "".count("a")
    print("empty str.count('a'): {result}")
    return result == 0

def test_empty_str_encode():
    result = "".encode()
    print("empty str.encode(): {result}")
    return result == b""

def test_empty_str_endswith():
    result = "".endswith("")
    print("empty str.endswith(''): {result}")
    return result

def test_empty_str_expandtabs():
    result = "".expandtabs()
