# Slice indices below -len point before the first element. With a backward
# step a start there gives an empty slice, and a stop there runs the slice
# through the first element, as in Python.

def check(what: str, ok: bool) -> bool:
    if not ok:
        print("FAILED: " + what)
    return ok

actor main(env):
    try:
        ok = True
        l = [0, 1, 2, 3, 4, 5]
        ok = check("list stop below -len", l[4:-100:-2] == [4, 2, 0]) and ok
        ok = check("list stop below -len, no start", l[:-100:-1] == [5, 4, 3, 2, 1, 0]) and ok
        ok = check("list start below -len", l[-100::-1] == []) and ok
        ok = check("list forward start below -len", l[-100:2] == [0, 1]) and ok
        ok = check("list stop at -len", l[4:-6:-1] == [4, 3, 2, 1]) and ok
        s = "abcdef"
        ok = check("str stop below -len", s[4:-100:-2] == "eca") and ok
        ok = check("str start below -len", s[-100::-1] == "") and ok
        b = b"abcdef"
        ok = check("bytes stop below -len", b[4:-100:-2] == b"eca") and ok
        ba = bytearray(b"abcdef")
        del ba[4:-100:-2]
        ok = check("bytearray del with stop below -len", ba == bytearray(b"bdf")) and ok
        ba2 = bytearray(b"abcdef")
        del ba2[-100::-1]
        ok = check("bytearray del with start below -len", ba2 == bytearray(b"abcdef")) and ok
        l2 = [0, 1, 2, 3, 4, 5]
        del l2[4:-100:-2]
        ok = check("list del with stop below -len", l2 == [1, 3, 5]) and ok
        l3 = [0, 1, 2, 3, 4, 5]
        del l3[::-2]
        ok = check("list del with a negative step", l3 == [0, 2, 4]) and ok
        l4 = [0, 1, 2, 3, 4, 5]
        del l4[::-1]
        ok = check("list del of all with a negative step", l4 == []) and ok
        if ok:
            print("All slice bound checks OK")
            env.exit(0)
        else:
            env.exit(1)
    except Exception as e:
        print("Unexpected exception: {e}")
        env.exit(1)
