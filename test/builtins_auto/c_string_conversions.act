def check_strings() -> bool:
    NotImplemented

def check_bytes() -> bool:
    NotImplemented

def from_c(data: bytes, mode: int) -> str:
    NotImplemented

def check():
    assert check_strings()
    assert check_bytes()

    # Every entry point validates UTF-8, including truncated codepoints.
    for wire in [b"\xff", b"\xc3", b"\xf0\x9f", b"\xc0\x80",
                 b"\xed\xa0\x80", b"\xf4\x90\x80\x80"]:
        for mode in range(4):
            rejected = False
            try:
                from_c(wire, mode)
            except ValueError as e:
                assert e.error_message == "Unicode decode error"
                rejected = True
            assert rejected

    # Explicit lengths preserve NUL and validate the bytes after it.
    for mode in [2, 3]:
        text = from_c(b"A\xc3\xa5\x00B", mode)
        assert len(text) == 4
        assert text.encode() == b"A\xc3\xa5\x00B"
        rejected = False
        try:
            from_c(b"\x00\xff", mode)
        except ValueError:
            rejected = True
        assert rejected

    # C-string entry points stop at the first NUL.
    for mode in [0, 1]:
        assert from_c(b"before\x00\xff", mode) == "before"

actor main(env):
    try:
        check()
        env.exit(0)
    except Exception as e:
        print(e)
        env.exit(1)
