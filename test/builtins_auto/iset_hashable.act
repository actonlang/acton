class CollidingKey:
    value: int

    def __init__(self, value: int):
        self.value = value

extension CollidingKey(Hashable):
    def __eq__(self, other):
        return self.value == other.value

    def hash(self, h):
        h.update(b"collision")

def test_equal_hashes():
    a = iset(range(100))
    b = iset(list(range(99, -1, -1)) + [42])
    return a == b and hash(a) == hash(b) and seed_hash(u64(17), a) == seed_hash(u64(17), b)

def test_hash_after_resize_and_delete():
    a = iset(range(256)) - iset(range(4, 256)) - iset([0])
    b = iset([3, 2, 1])
    return a == b and hash(a) == hash(b) and hash(iset(a)) == hash(b)

def test_empty_hash():
    a: iset[int] = iset()
    b = iset(range(100)) - iset(range(100))
    d = {a: "empty"}
    return hash(a) == hash(b) and d[b] == "empty" and hash(a) != hash(iset([1]))

def test_hash_contents():
    return hash(iset([1, 2])) != hash(iset([1, 3])) and hash(iset(["ab", "c"])) != hash(iset(["a", "bc"]))

def test_dict_keys():
    d = {iset([1, 2]): "first", iset([3]): "other"}
    if d[iset([2, 1])] != "first" or iset([1, 3]) in d:
        return False
    d[iset([2, 1])] = "updated"
    if len(d) != 2 or d[iset([1, 2])] != "updated":
        return False
    del d[iset([2, 1])]
    return len(d) == 1 and iset([1, 2]) not in d and d[iset([3])] == "other"

def test_set_elements():
    s = {iset([1, 2]), iset([2, 1]), iset([3])}
    if len(s) != 2 or iset([2, 1]) not in s or iset([1, 3]) in s:
        return False
    s.discard(iset([2, 1]))
    s.add(iset([4, 5]))
    return s == {iset([3]), iset([5, 4])}

def test_nested_keys():
    d = {iset([iset([1, 2]), iset([3])]): "nested"}
    t = {(iset([1, 2]), "tag"): 42}
    return d[iset([iset([3]), iset([2, 1])])] == "nested" and t[(iset([2, 1]), "tag")] == 42

def test_source_mutation():
    s = {1, 2}
    a = iset(s)
    before = hash(a)
    s.add(3)
    if a != iset([1, 2]) or hash(a) != before:
        return False
    b = iset(s)
    s.discard(1)
    return b == iset([1, 2, 3]) and hash(b) == hash(iset([3, 2, 1])) and hash(a) == before

def test_seed_and_stream():
    a = iset([1, 2, 3])
    b = iset([3, 2, 1])
    if seed_hash(u64(0), a) != hash(a) or seed_hash(u64(17), a) == hash(a):
        return False
    h1 = hasher(u64(17))
    h2 = hasher(u64(17))
    "prefix".hash(h1)
    "prefix".hash(h2)
    a.hash(h1)
    b.hash(h2)
    "suffix".hash(h1)
    "suffix".hash(h2)
    return h1.finalize() == h2.finalize() and h1.finalize() != seed_hash(u64(17), a)

def test_colliding_elements():
    a = iset([CollidingKey(1), CollidingKey(2)])
    b = iset([CollidingKey(2), CollidingKey(1)])
    c = iset([CollidingKey(3), CollidingKey(4)])
    d = {a: "first", c: "other"}
    s = {a, b, c}
    return a == b and a != c and hash(a) == hash(b) and len(s) == 2 and d[b] == "first" and d[c] == "other"

tests = {
    "test_equal_hashes": test_equal_hashes,
    "test_hash_after_resize_and_delete": test_hash_after_resize_and_delete,
    "test_empty_hash": test_empty_hash,
    "test_hash_contents": test_hash_contents,
    "test_dict_keys": test_dict_keys,
    "test_set_elements": test_set_elements,
    "test_nested_keys": test_nested_keys,
    "test_source_mutation": test_source_mutation,
    "test_seed_and_stream": test_seed_and_stream,
    "test_colliding_elements": test_colliding_elements,
}

actor main(env):
    failed = []
    for name, t in tests.items():
        print("== test: " + name)
        if not t():
            print("-- FAILED test: " + name)
            failed.append(name)
        print()
    if len(failed) == 0:
        print("All {len(tests)} tests OK!")
        env.exit(0)
    else:
        print("\n{len(failed)} of {len(tests)} tests failed:")
        for name in failed:
            print(" - {name}")
        env.exit(1)
