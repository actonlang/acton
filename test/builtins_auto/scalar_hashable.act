def check_hash[A(Hashable)](a: A, b: A, different: A):
    assert a == b
    assert hash(a) == hash(b)
    assert seed_hash(u64(17), a) == seed_hash(u64(17), b)
    assert hash(a) != hash(different)
    # More than four entries exercise lookup through cached hashes.
    d = {(a, i): "found" for i in range(8)}
    for i in range(8):
        assert d[(b, i)] == "found"
    assert len({a, b, different}) == 2

def check_fast_hash[A(Hashable)](value: A):
    # B_hash has allocation-free specializations for several builtins.  Their
    # results must be identical to the general streaming path used by
    # seed_hash.
    assert hash(value) == seed_hash(u64(0), value)

actor main(env):
    try:
        check_fast_hash(-9223372036854775807 - 1)
        check_fast_hash(-42)
        check_fast_hash(0)
        check_fast_hash(42)
        check_fast_hash(9223372036854775807)
        check_fast_hash(u64(0))
        check_fast_hash(u64(42))
        check_fast_hash(u64("18446744073709551615"))
        check_fast_hash(i32("-2147483648"))
        check_fast_hash(i32(0))
        check_fast_hash(i32("2147483647"))
        check_fast_hash(i16("-32768"))
        check_fast_hash(i16(0))
        check_fast_hash(i16("32767"))
        check_fast_hash(i8("-128"))
        check_fast_hash(i8(0))
        check_fast_hash(i8("127"))
        check_fast_hash(u32(0))
        check_fast_hash(u32("4294967295"))
        check_fast_hash(u16(0))
        check_fast_hash(u16("65535"))
        check_fast_hash(u8(0))
        check_fast_hash(u8("255"))
        check_fast_hash(u1(0))
        check_fast_hash(u1(1))
        check_fast_hash(False)
        check_fast_hash(True)
        check_fast_hash(float("-0.0"))
        check_fast_hash(float("0.0"))
        check_fast_hash(float("1.25"))
        check_fast_hash("")
        check_fast_hash("a\x00Å🌍")
        check_fast_hash(b"")
        check_fast_hash(b"a\x00\xff")
        check_hash(int("-42"), int("-42"), int(43))
        check_hash(u64("18446744073709551615"),
                   u64("18446744073709551615"), u64(43))
        check_hash("a\x00Å🌍", "a\x00Å🌍", "different")
        check_hash(b"a\x00\xff", b"a\x00\xff", b"different")
        check_hash(i32("-42"), i32("-42"), i32(43))
        check_hash(i16("-42"), i16("-42"), i16(43))
        check_hash(i8("-42"), i8("-42"), i8(43))
        check_hash(u32("42"), u32("42"), u32(43))
        check_hash(u16("42"), u16("42"), u16(43))
        check_hash(u8("42"), u8("42"), u8(43))
        check_hash(u1(1), u1(1), u1(0))
        check_hash(True, bool(1), False)
        check_hash(float("1.25"), float("1.25"), float("1.5"))
        check_hash(float("0.0"), float("-0.0"), float("1.0"))
        env.exit(0)
    except Exception as e:
        print(e)
        env.exit(1)
