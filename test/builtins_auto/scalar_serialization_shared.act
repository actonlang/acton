def shared[A](x: A) -> list[A]:
    NotImplemented


def check[A](x: A):
    data = shared(x)
    restored = deserialize(serialize(data))
    assert serialize(restored) == serialize(data)


actor main(env):
    try:
        check(-5)
        check(0)
        check(1)
        check(256)
        check(257)
        check(i8(-42))
        check(i16(-42))
        check(i32(-42))
        check(u1(1))
        check(u8(42))
        check(u16(42))
        check(u32(42))
        check(u64(42))
        env.exit(0)
    except Exception as e:
        print(e)
        env.exit(1)
