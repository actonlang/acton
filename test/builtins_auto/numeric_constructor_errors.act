class OtherAtom(atom):
    def __init__(self):
        pass

def expect_value_error[A](convert: () -> A):
    try:
        convert()
    except ValueError:
        return
    except:
        raise AssertionError("Expected ValueError for an unsupported numeric conversion, got another exception")
    raise AssertionError("Expected ValueError for an unsupported numeric conversion")

def check_unsupported(a: atom):
    expect_value_error(lambda: int(a))
    expect_value_error(lambda: i32(a))
    expect_value_error(lambda: i16(a))
    expect_value_error(lambda: i8(a))
    expect_value_error(lambda: u64(a))
    expect_value_error(lambda: u32(a))
    expect_value_error(lambda: u16(a))
    expect_value_error(lambda: u8(a))
    expect_value_error(lambda: u1(a))
    expect_value_error(lambda: bigint(a))
    expect_value_error(lambda: float(a))

def check_invalid_int_str(s: str):
    expect_value_error(lambda: int(s))
    expect_value_error(lambda: i32(s))
    expect_value_error(lambda: u64(s))
    expect_value_error(lambda: bigint(s))

def check_invalid_float_str(s: str):
    expect_value_error(lambda: float(s))

def check_base_requires_str(a: atom):
    expect_value_error(lambda: int(a, 16))
    expect_value_error(lambda: i32(a, 16))
    expect_value_error(lambda: i16(a, 16))
    expect_value_error(lambda: i8(a, 16))
    expect_value_error(lambda: u64(a, 16))
    expect_value_error(lambda: u32(a, 16))
    expect_value_error(lambda: u16(a, 16))
    expect_value_error(lambda: u8(a, 16))
    expect_value_error(lambda: u1(a, 16))
    expect_value_error(lambda: bigint(a, 16))

actor main(env):
    try:
        check_unsupported(OtherAtom())
        check_unsupported(b"1")
        check_unsupported(complex(1))
        # The digits must run to the end of the str, a NUL does not end them
        check_invalid_int_str("12" + chr(0) + "34")
        check_invalid_int_str("12" + chr(0))
        check_invalid_int_str("")
        check_invalid_float_str("")
        check_invalid_float_str("abc")
        check_invalid_float_str("1.5" + chr(0) + "5")
        check_base_requires_str(5.0)
        check_base_requires_str(5)
        expect_value_error(lambda: int(5.0, 16))
        expect_value_error(lambda: u8(5, 16))
        # A negative str padded to a full parse chunk (18 digits) must keep
        # its sign, so unsigned types reject it
        padded = "-" + "0" * 17 + "5"
        expect_value_error(lambda: u64(padded))
        expect_value_error(lambda: u32(padded))
        expect_value_error(lambda: u16(padded))
        expect_value_error(lambda: u8(padded))
        assert int("123") == 123
        assert int("10", 2) == 2
        assert bigint("123") == bigint(123)
        assert float("1.5") == 1.5
        env.exit(0)
    except Exception as e:
        print(e)
        env.exit(1)
