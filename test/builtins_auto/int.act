# int() and bigint() parse a digit string in chunks of POWINWORD[base] digits:
# 18 in base 10, 15 in base 16 and 62 in base 2. A digit count that is an exact
# multiple of the chunk size takes its own path, which used to drop the sign.
def check_int_str(s: str, base: ?int, expected: int):
    got = int(s, base)
    if got != expected:
        b = str(base) if base is not None else "None"
        raise ValueError("int(" + repr(s) + ", " + b + ") gives " + str(got) + ", expected " + str(expected))

def check_bigint_str(s: str, base: ?int, expected: bigint):
    got = bigint(s, base)
    if got != expected:
        b = str(base) if base is not None else "None"
        raise ValueError("bigint(" + repr(s) + ", " + b + ") gives " + str(got) + ", expected " + str(expected))

def test_int_str_chunks():
    for base, prefix, top, chunk in [(10, "", "9", 18), (16, "0x", "f", 15), (2, "0b", "1", 62)]:
        for n in [chunk - 1, chunk, chunk + 1]:
            # Only strings whose value fits in an int
            cases = [("1" + "0" * (n - 1), base ** (n - 1))]
            if n <= chunk:
                cases.append((top * n, base ** n - 1))
            for digits, value in cases:
                check_int_str(digits, base, value)
                check_int_str("-" + digits, base, -value)
                check_int_str("+" + digits, base, value)
                check_int_str("-" + prefix + digits, None, -value)
                check_int_str("-" + prefix + digits, base, -value)
    if int("-100000000000000000") != -100000000000000000:
        raise ValueError('int("-100000000000000000") gives wrong result')
    if int("-999999999999999999") != -999999999999999999:
        raise ValueError('int("-999999999999999999") gives wrong result')
    # Leading zeros pad a small value to a full chunk, for every signed type
    padded = "-" + "0" * 17 + "5"
    if int(padded) != -5 or i32(padded) != -5 or i16(padded) != -5 or i8(padded) != -5:
        raise ValueError("negative str padded to 18 digits gives wrong result")
    if int("-0x" + "0" * 14 + "5") != -5 or int("-0b" + "0" * 61 + "1") != -1:
        raise ValueError("negative str padded to a full chunk gives wrong result")

def test_bigint_str_chunks():
    for base, prefix, top, chunk in [(10, "", "9", 18), (16, "0x", "f", 15), (2, "0b", "1", 62)]:
        b = bigint(base)
        for n in [chunk - 1, chunk, chunk + 1, 2 * chunk - 1, 2 * chunk, 2 * chunk + 1, 3 * chunk, 4 * chunk]:
            bn = bigint(n)
            cases = [
                ("1" + "0" * (n - 1), b ** (bn - 1)),
                ("1" * n, (b ** bn - 1) // (b - 1)),
                (top * n, b ** bn - 1),
            ]
            for digits, value in cases:
                check_bigint_str(digits, base, value)
                check_bigint_str("-" + digits, base, -value)
                check_bigint_str("+" + digits, base, value)
                check_bigint_str("-" + prefix + digits, None, -value)
                check_bigint_str("-" + prefix + digits, base, -value)
    if bigint("-" + "1" * 36) != -111111111111111111111111111111111111:
        raise ValueError('bigint("-" + "1" * 36) gives wrong result')

def test_int():
    test_int_divzero()
    test_int_str_chunks()
    x: int = 0
    if (bool(x != 0)):
       raise ValueError("unexpected: bool(x) != 0")
    if x != 0:
       raise ValueError("unexpected: x != 0")
    if int("1234") != 1234:
        raise ValueError('int("1234") gives wrong result')
    if int("0x1234") != 4660:
        raise ValueError('int("0x1234") gives wrong result')
    if int("0o1234") != 668:
        raise ValueError('int("0o1234") gives wrong result')
    if int("0b1111") != 15:
        raise ValueError('int("0b1111") gives wrong result')
    if int("1234", 7) != 466:
        raise ValueError('int("1234",7) gives wrong result')
    if int(x) != 0:
        raise ValueError("unexpected: int(x) != 0")
    if int(2**63-1) + 1 != -2**63:
        raise ValueError("int wraparound failed")
    shift_value: int = 9000000000000000000
    if shift_value << 8 != -1843009213693952000:
        raise ValueError("int left shift wraparound failed")
    return True

def test_u1():
    test_u1_divzero()
    x: u1 = 0
    if (bool(x != 0)):
       raise ValueError("unexpected: bool(x) != 0")
    if x != 0:
       raise ValueError("unexpected: x != 0")
    if u1("1") != 1:
        raise ValueError('u1("1") gives wrong result')
    if u1("0", 2) != 0:
        raise ValueError('u1("0", 2) gives wrong result')
    if u1(1) + u1(1) != 0:
        raise ValueError("u1 addition should wrap modulo 2")
    if int(x) != 0:
        raise ValueError("unexpected: int(x) != 0")
    return True

