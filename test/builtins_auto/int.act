import testing

# Test all integer types:
# - i8
# - i16
# - i32
# - i64
# - u1
# - u8
# - int
# - u16
# - u32
# - u64
# - bigint

# TODO: test that division by zero raises ZeroDivisionError

def test_i8_divzero():
    n = i8(0)
    try:
        i8(3) / n
    except ZeroDivisionError:
        try:
            i8(3) // n
        except ZeroDivisionError:
            return
    raise testing.NotRaisesError("expected ZeroDivisionError for i8")

def test_i16_divzero():
    n = i16(0)
    try:
        i16(3) / n
    except ZeroDivisionError:
        try:
            i16(3) // n
        except ZeroDivisionError:
            return
    raise testing.NotRaisesError("expected ZeroDivisionError for i16")

def test_i32_divzero():
