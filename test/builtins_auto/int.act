def test_int_divzero():
    n = int(0)
    try:
        int(3) / n
    except ZeroDivisionError:
        try:
            int(3) // n
        except ZeroDivisionError:
            return
    raise testing.NotRaisesError("expected ZeroDivisionError for int")

