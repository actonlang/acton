    raise testing.NotRaisesError("expected ZeroDivisionError for u64")

def test_bigint_modzero():
    try:
        bigint(3) % bigint(0)
    except ZeroDivisionError:
        return
    raise testing.NotRaisesError("expected ZeroDivisionError for bigint modulo")


def test_i8():
    test_i8_divzero()
    x: i8 = 0
    if (bool(x != 0)):
       raise ValueError("unexpected: bool(x) != 0")
    if x != 0:
       raise ValueError("unexpected: x != 0")
    if i8("123") != 123:
        raise ValueError('i8("123") gives wrong result')
    if i8("0x7f") != 127:
        raise ValueError('i8("0x7f") gives wrong result')
    if i8("0o177") != 127:
        raise ValueError('i8("0o177") gives wrong result')
    if i8("0b1111111") != 127:
        raise ValueError('i8("0b1111111") gives wrong result')
    if i8("123",7) != 66:
        raise ValueError('i8("123",7) gives wrong result')
    if int(x) != 0:
        raise ValueError("unexpected: int(x) != 0")
    if i8(2**7 - 1) + 1 != -2**7:
        raise ValueError("i8 wraparound failed")
    return True

def test_i16():
    test_i16_divzero()
    x: i16 = 0
    if (bool(x != 0)):
       raise ValueError("unexpected: bool(x) != 0")
    if x != 0:
       raise ValueError("unexpected: x != 0")
    if i16("1234") != 1234:
        raise ValueError('i16("1234") gives wrong result')
    if i16("0x1234") != 4660:
        raise ValueError('i16("0x1234") gives wrong result')
    if i16("0o1234") != 668:
        raise ValueError('i16("0o1234") gives wrong result')
    if i16("0b1111") != 15:
        raise ValueError('i16("0b1111") gives wrong result')
    if i16("1234",7) != 466:
        raise ValueError('i16("1234",7) gives wrong result')
    if i16(2**15-1) + 1 != -2**15:
        raise ValueError("i16 wraparound failed")
    return True

