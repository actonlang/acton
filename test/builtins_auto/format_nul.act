# % formatting and interpolated strings keep NUL bytes, both in the format
# string and in the values put into it. The expected values are built with
# chr() and +, which do not go through formatting.

def check_nul():
    nul = chr(0)
    x = 7
    assert "a\x00{x}" == "a" + nul + "7" and len("a\x00{x}") == 3
    assert f"{nul}ab" == nul + "ab" and len(f"{nul}ab") == 3
    assert "%s|" % nul == nul + "|" and len("%s|" % nul) == 2
    assert "a{nul}b" == "a" + nul + "b" and len("a{nul}b") == 3
    assert "%d\x00%d" % (1, 2) == "1" + nul + "2"
    assert "%s%s" % ("a" + nul, nul + "b") == "a" + nul + nul + "b"
    assert "\x00%s\x00" % "" == nul + nul

def check_width():
    # Width and precision of a string count characters, not bytes.
    nul = chr(0)
    assert "[%4s]" % ("a" + nul) == "[  a" + nul + "]"
    assert "[%-4s]" % ("a" + nul) == "[a" + nul + "  ]"
    assert "[%.2s]" % ("a" + nul + "b") == "[a" + nul + "]"
    assert "[%*s]" % (3, nul) == "[  " + nul + "]"
    assert "[{nul:>3}]" == "[  " + nul + "]"
    assert "[{nul:<3}]" == "[" + nul + "  ]"
    assert "[{nul:^3}]" == "[ " + nul + " ]"
    assert "[%5s]" % "é" == "[    é]"
    assert "[%-*s]" % (3, "é") == "[é  ]"
    assert "[%.1s]" % "éa" == "[é]"
    assert "[%5s][%.3s]" % ("abcdefg", "abcdefg") == "[abcdefg][abc]"

def check_other_conversions():
    nul = chr(0)
    x = 7
    f = 3.14159
    assert "%r" % ("a" + nul) == repr("a" + nul)
    assert "%a" % "é" == ascii("é")
    assert "[%5d][%-5d][%05d][%+d][%x][%#o][%c]" % (x, x, x, x, 255, 8, 65) == "[    7][7    ][00007][+7][ff][010][A]"
    assert "[%.2f][%8.3f][%-8.1f][%e]" % (f, f, f, f) == "[3.14][   3.142][3.1     ][3.141590e+00]"
    assert "[%*d][%.*f]" % (4, x, 1, f) == "[   7][3.1]"
    assert "[{f:.2f}][{x:05}][{f:08.3f}]" == "[3.14][00007][0003.142]"
    assert "%d%%" % 50 == "50%"

actor main(env):
    try:
        check_nul()
        check_width()
        check_other_conversions()
    except AssertionError:
        print("formatting with NUL produced the wrong value")
        await async env.exit(1)
    await async env.exit(0)
