def check(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)

def expect_index_error(xs: bitarray, index: int) -> None:
    try:
        value = xs[index]
    except IndexError:
        return
    raise AssertionError("expected IndexError")

def get_bit(xs: bitarray, index: int) -> bool:
    return xs[index]

def set_bit(xs: bitarray, index: int, value: bool) -> None:
    xs[index] = value

actor main(env):
    try:
        empty: bitarray = bitarray(0)
        check(len(empty) == 0 and not empty, "empty bitarray is invalid")

        zeros: bitarray = bitarray(130)
        check(len(zeros) == 130, "wrong bitarray length")
        check(not zeros[0] and not zeros[63] and not zeros[64] and not zeros[129],
              "bitarray is not false initialized")

        ones: bitarray = bitarray(130, True)
        check(ones[0] and ones[63] and ones[64] and ones[129],
              "bitarray is not true initialized")

        ones[0] = False
        ones[63] = False
        set_bit(ones, 64, False)
        ones[129] = False
        check(not ones[0] and not ones[63] and not get_bit(ones, 64) and not ones[129],
              "clearing bits failed")
        check(ones[1] and ones[62] and ones[65] and ones[128],
              "clearing a bit damaged its neighbours")

        zeros[0] = True
        zeros[63] = True
        set_bit(zeros, 64, True)
        zeros[129] = True
        check(zeros[0] and zeros[63] and get_bit(zeros, 64) and zeros[129],
              "setting bits failed")
        check(not zeros[1] and not zeros[62] and not zeros[65] and not zeros[128],
              "setting a bit damaged its neighbours")

        expect_index_error(zeros, -1)
        expect_index_error(zeros, 130)

        try:
            bad: bitarray = bitarray(-1)
            raise AssertionError("expected ValueError")
        except ValueError:
            pass

        payload = serialize(zeros)
        check(serialize(deserialize(payload)) == payload,
              "bitarray serialization failed")
        check(serialize(deserialize(serialize(ones))) == serialize(ones),
              "true-initialized bitarray serialization failed")
        shared = [zeros, zeros]
        check(serialize(deserialize(serialize(shared))) == serialize(shared),
              "shared bitarray serialization failed")

        env.exit(0)
    except Exception as e:
        print(e)
        env.exit(1)
