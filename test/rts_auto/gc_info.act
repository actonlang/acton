actor main(env):
    proc def __startup__():
        before = env.rts.gc_info()
        assert before.mode in ["ordinary", "generational"]
        assert before.page_hash_table_log2 > 0
        assert before.block_size >= 4096
        assert (before.block_size & (before.block_size - 1)) == 0
        assert before.thread_local_size_limit <= before.block_size // 2
        if before.thread_local_size_limit > 0:
            assert before.thread_local_refill_blocks >= 1
            assert before.thread_local_refill_blocks <= 32
        else:
            assert before.thread_local_refill_blocks == 0
        assert before.markers >= 1
        assert before.initial_mark_stack_size >= 4096
        assert before.free_space_divisor > 0
        # The physical memory size is known on every supported platform.
        assert before.memory_limit > 0
        if before.mode == "ordinary":
            assert before.backend == "none"
            assert before.pause_target_ms is None
        else:
            assert before.backend in before.supported_backends
            # None with one stop per collection
            if before.pause_target_ms is not None:
                assert before.pause_target_ms! >= 0.0

        retained = [[i, i + 1] for i in range(2048)]
        for iteration in range(4):
            garbage = [[i, iteration] for i in range(2048)]
            env.rts.gc()
            info = env.rts.gc_info()
            assert info.mode == before.mode
            assert info.backend == before.backend
            assert info.supported_backends == before.supported_backends
            assert info.page_hash_table_log2 == before.page_hash_table_log2
            assert info.block_size == before.block_size
            assert info.end_padding == before.end_padding
            assert info.thread_local_size_limit == before.thread_local_size_limit
            assert info.no_thread_local_warmup == before.no_thread_local_warmup
            assert info.thread_local_refill_blocks == before.thread_local_refill_blocks
            assert info.realloc_no_free == before.realloc_no_free
            assert info.mark_range_stealing == before.mark_range_stealing
            assert info.mark_bits == before.mark_bits
            assert info.bytes_per_marker == before.bytes_per_marker
            assert info.initial_mark_stack_size == before.initial_mark_stack_size
            assert info.heap_growth_divisor == before.heap_growth_divisor
            assert info.alloc_budget_percent == before.alloc_budget_percent
            assert info.memory_limit == before.memory_limit
            assert info.heap_ceiling_percent == before.heap_ceiling_percent
            stats = env.rts.gc_stats()
            assert stats.heap_size > 0
            assert stats.heap_size >= stats.free_bytes
            assert stats.free_bytes >= stats.unmapped_bytes
            assert len(garbage) == 2048
            for i, pair in enumerate(retained):
                assert pair == [i, i + 1]
        env.exit(0)
