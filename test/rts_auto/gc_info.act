import acton.rts


actor main(env):
    before = acton.rts.get_gc_info(env.syscap)
    assert before.mode in ["ordinary", "generational", "incremental"]
    assert before.configured_backend in ["auto", "soft_dirty", "userfaultfd"]
    assert before.page_hash_table_log2 > 0
    assert before.markers >= 1
    assert before.free_space_divisor > 0
    if before.mode == "ordinary":
        assert before.backend == "none"
        assert before.pause_target_ms is None
    else:
        assert before.backend in before.supported_backends
        if before.mode == "generational":
            assert before.pause_target_ms is None
        else:
            assert before.pause_target_ms is not None
            assert before.pause_target_ms! >= 0.0

    retained = [[i, i + 1] for i in range(2048)]
    for iteration in range(4):
        garbage = [[i, iteration] for i in range(2048)]
        acton.rts.gc(env.syscap)
        info = acton.rts.get_gc_info(env.syscap)
        assert info.mode == before.mode
        assert info.configured_backend == before.configured_backend
        assert info.backend == before.backend
        assert info.supported_backends == before.supported_backends
        assert info.page_hash_table_log2 == before.page_hash_table_log2
        assert info.heap_size > 0
        assert info.heap_size >= info.free_bytes
        assert info.free_bytes >= info.unmapped_bytes
        assert len(garbage) == 2048
        for i, pair in enumerate(retained):
            assert pair == [i, i + 1]
    env.exit(0)
