# The solver tries Eq candidates in the order that the witness queries give
# them. The __builtin__ witnesses must come before the Eq[atom] witness of the
# imported module. If not, the solver selects atom for a comparison of an
# integer with a literal, because atom is above u64 and int.

import atomeq

def check() -> bool:
    a: u64 = u64(5)
    i: int = 5
    o: ?u64 = u64(5)
    if a != 5 or 5 != a or a != u64(5):
        print("FAIL: u64 compared with a literal through Eq[atom]")
        return False
    if i != 5:
        print("FAIL: int compared with a literal through Eq[atom]")
        return False
    if o != 5:
        print("FAIL: ?u64 compared with a literal through Eq[atom]")
        return False
    n = u64(5)
    m = 5
    if n != 5 or u64(5) != 5 or 5 != u64(5):
        print("FAIL: u64 without a declared type compared with a literal through Eq[atom]")
        return False
    if m != 5 or 5 != 5:
        print("FAIL: int without a declared type compared with a literal through Eq[atom]")
        return False
    x: atom = u64(5)
    y: atom = u64(5)
    if x == y:
        print("FAIL: atom compared without the imported Eq[atom]")
        return False
    return True

actor main(env):
    if check():
        env.exit(0)
    else:
        env.exit(1)
