protocol NeedA:
    a : () -> int

protocol NeedB:
    b : () -> int

protocol Pick:
    pick : () -> int

protocol PickA (Pick):
    xa : () -> int

protocol PickB (Pick):
    xb : () -> int

class Box[X](object):
    item: X
    def __init__(self, item: X):
        self.item = item

class Both(object):
    def __init__(self):
        pass

extension Both (NeedA):
    def a(self) -> int:
        return 1

extension Both (NeedB):
    def b(self) -> int:
        return 2
