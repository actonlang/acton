class Item:
    def __init__(self, n: int):
        self.n = n

extension Item(Show):
    def __str__(self) -> str:
        return "item " + str(self.n)
    def __repr__(self) -> str:
        return "Item(" + str(self.n) + ")"

extension Item(Bool):
    def __bool__(self) -> bool:
        return self.n != 0

def render[A(Show)](x: A) -> (str, str):
    return (str(x), repr(x))

def truth[A(Bool)](x: A) -> bool:
    if x:
        return True
    return False

def derived_string() -> str:
    NotImplemented

def base_string(x: str) -> bool:
    NotImplemented

class DerivedShow:
    def __init__(self):
        pass

extension DerivedShow(Show):
    def __str__(self) -> str:
        return derived_string()
    def __repr__(self) -> str:
        return derived_string()

class Plain:
    def __init__(self):
        pass

# Supplied generic evidence must survive ordinary conversion and all truth
# contexts. Widening to value instead selects the root default policy.
def disjunction[A(Bool)](x: A, y: A) -> A:
    return x or y

def conjunction[A(Bool)](x: A, y: A) -> A:
    return x and y

def value_truth(x: value) -> bool:
    return bool(x)

def value_conjunction(x: value, y: value) -> value:
    return x and y

def value_disjunction(x: value, y: value) -> value:
    return x or y

def format_with_callable[A(Show)](x: A) -> str:
    f: (A)->str = str
    return f(x)

def truth_with_callable[A(Bool)](x: A) -> bool:
    f: (A)->bool = bool
    return f(x)

mut def produce(log: list[int], n: int) -> Item:
    log.append(n)
    return Item(n)

mut def fail() -> Item:
    raise ValueError("short-circuited operand was evaluated")

def raw_int(x: int) -> bool:
    return bool(x)

def raw_str(x: str) -> str:
    return str(x)

mut def produce_int(log: list[int]) -> int:
    log.append(9)
    return 7

def raw_float(x: float) -> bool:
    return not x

def raw_tuple(x: (int, str)) -> bool:
    return bool(x)

def raw_dict[A(Hashable)](x: dict[A, int]) -> bool:
    return bool(x)

def inherited_display(x: Plain) -> str:
    return str(x)

def increment(x: int) -> int:
    return x + 1

actor main(env):
    proc def __startup__():
        try:
            assert str() == "None"
            assert str(None) == "None"
            assert str(7) == "7"
            assert repr((7, None)) == "(7, None)"
            assert render(Item(7)) == ("item 7", "Item(7)")
            assert not truth(Item(0))
            assert truth(Item(7))
            assert not bool(Item(0))
            assert bool(Item(7))
            assert not Item(0)
            assert Item(7)
            assert not (Item(0) and Item(7))
            assert (Item(0) or Item(7)).n == 7
            assert (Item(7) and Item(2)).n == 2
            assert (Item(7) or Item(2)).n == 7
            assert all(Item(x) for x in [1, 2])
            assert not all(Item(x) for x in [1, 0])
            assert any(Item(x) for x in [0, 1])
            assert not any(Item(x) for x in [0, 0])
            derived = derived_string()
            assert not base_string(derived)
            assert base_string(raw_str(derived))
            assert raw_str(derived) == "derived"
            assert base_string(str(DerivedShow()))
            assert str(DerivedShow()) == "derived"
            assert not base_string(repr(DerivedShow()))
            assert str((Item(7), None)) == "(Item(7), None)"
            assert repr([Item(7)]) == "[Item(7)]"
            assert ascii(Item(7)) == "'item 7'"
            assert format_with_callable(Item(7)) == "item 7"
            assert not truth_with_callable(Item(0))
            assert truth_with_callable(Item(7))
            assert disjunction(Item(0), Item(7)).n == 7
            assert conjunction(Item(0), Item(7)).n == 0
            assert conjunction(Item(7), Item(2)).n == 2
            # value has its own default Bool policy; concrete evidence is lost.
            assert value_truth(0)
            assert value_truth("")
            erased_left = Item(0)
            erased_right = Item(7)
            assert value_truth(erased_left)
            chosen_value = value_conjunction(erased_left, erased_right)
            if isinstance(chosen_value, Item):
                assert chosen_value.n == 7
            else:
                assert False
            chosen_value = value_disjunction(erased_left, erased_right)
            if isinstance(chosen_value, Item):
                assert chosen_value.n == 0
            else:
                assert False
            assert not raw_int(0)
            assert raw_int(-1)
            assert raw_float(0.0)
            assert not raw_float(1.5)
            assert raw_tuple((0, ""))
            assert not raw_dict({})
            assert raw_dict({"x": 0})
            assert inherited_display(Plain()).startswith("<")
            assert bool(increment)
            assert str(increment).startswith("<")
            absent: ?int = None
            zero: ?int = 0
            nonzero: ?int = 7
            assert not bool(absent)
            assert not zero
            assert nonzero
            assert str(absent) == "None"
            assert str(zero) == "0"
            assert (absent or 7) == 7
            assert (zero or 7) == 7
            assert (nonzero or 2) == 7
            assert not (absent and 7)
            assert not (zero and 7)
            log: list[int] = []
            assert str(produce_int(log)) == "7"
            assert log == [9]
            log.clear()
            chosen = produce(log, 0) and fail()
            assert chosen.n == 0
            assert log == [0]
            log.clear()
            chosen = produce(log, 1) or fail()
            assert chosen.n == 1
            assert log == [1]
            log.clear()
            chosen = produce(log, 0) or produce(log, 2)
            assert chosen.n == 2
            assert log == [0, 2]
            log.clear()
            chosen = produce(log, 1) and produce(log, 2)
            assert chosen.n == 2
            assert log == [1, 2]
            log.clear()
            if produce(log, 0) and fail():
                assert False
            assert log == [0]
            # Optional narrowing is retained through a boolean conjunction.
            optional_item: ?Item = Item(7)
            assert optional_item is not None and optional_item.n == 7
            assert all([Item(1), Item(2)])
            assert not any([Item(0), Item(0)])
            assert all(Item(x) for x in [1, 2] if Item(x))
            # Native conversion failures use static exception instances.
            try:
                int("invalid")
                assert False
            except ValueError as error:
                assert "ValueError" in str(error)
            env.exit(0)
        except Exception as error:
            print(error)
            env.exit(1)
