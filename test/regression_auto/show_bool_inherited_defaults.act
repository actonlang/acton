# First migration checkpoint: explicit Show/Bool calls use protocol witnesses;
# public str/repr and truth operators still use their legacy class methods.

class Plain:
    def __init__(self):
        pass

class Mutable(object):
    def __init__(self):
        pass

class Custom:
    def __init__(self):
        pass

extension Custom(Show):
    def __str__(self) -> str:
        return "custom"
    def __repr__(self) -> str:
        return "Custom()"

extension Custom(Bool):
    def __bool__(self) -> bool:
        return False

class InheritedCustom(Custom):
    pass

class Overridden(Custom):
    pass

extension Overridden(Show):
    def __str__(self) -> str:
        return "overridden"
    def __repr__(self) -> str:
        return "Overridden()"

extension Overridden(Bool):
    def __bool__(self) -> bool:
        return True

class Box[A]:
    def __init__(self, item: A):
        self.item = item

class ChildBox[A](Box[A]):
    pass

extension Box[A(Show)](Show):
    def __str__(self) -> str:
        return "Box(" + Show.__str__(self.item) + ")"
    def __repr__(self) -> str:
        return "Box(" + Show.__repr__(self.item) + ")"

# Capture both inherited witnesses as object state and exercise serialization.
class View[A(Show, Bool)]:
    def __init__(self, item: A):
        self.item = item
    def display(self) -> str:
        return Show.__str__(self.item)
    def truth(self) -> bool:
        return Bool.__bool__(self.item)

def display[A(Show)](x: A) -> str:
    return Show.__str__(x)

def truth[A(Bool)](x: A) -> bool:
    return Bool.__bool__(x)

def keep[A(Show, Bool)](x: A) -> A:
    return x

def keep_plain(x: Plain) -> Plain:
    return keep(x)

def keep_mutable(x: Mutable) -> Mutable:
    return keep(x)

def keep_inherited(x: InheritedCustom) -> InheritedCustom:
    return keep(x)

def keep_box(x: ChildBox[Plain]) -> ChildBox[Plain]:
    return keep(x)

def bound_display[A(InheritedCustom)](x: A) -> str:
    return Show.__str__(x)

mut def make_plain(log: list[int]) -> Plain:
    log.append(1)
    return Plain()

actor main(env):
    plain = Plain()
    mutable = Mutable()
    assert display(keep_plain(plain)) == display(plain)
    assert display(keep_mutable(mutable)) == display(mutable)
    assert display(plain) == str(plain)
    assert Show.__repr__(plain) == repr(plain)
    assert display(mutable) == str(mutable)
    assert Show.__repr__(mutable) == repr(mutable)
    assert truth(plain)
    assert truth(mutable)
    custom = Custom()
    child = InheritedCustom()
    overridden = Overridden()
    assert display(custom) == "custom"
    assert display(child) == "custom"
    assert Show.__repr__(child) == "Custom()"
    assert not truth(custom)
    assert not truth(child)
    assert display(keep_inherited(child)) == display(child)
    assert bound_display(child) == "custom"
    assert display(overridden) == "overridden"
    assert Show.__repr__(overridden) == "Overridden()"
    assert truth(overridden)
    box = ChildBox(plain)
    assert display(keep_box(box)) == display(box)
    assert display(box) == "Box(" + display(plain) + ")"
    assert Show.__repr__(box) == "Box(" + Show.__repr__(plain) + ")"
    custom_box = ChildBox(custom)
    assert display(custom_box) == "Box(custom)"
    view: View[InheritedCustom] = View(child)
    restored = deserialize(serialize(view))
    if isinstance(restored, View):
        assert restored.display() == "custom"
        assert not restored.truth()
    else:
        assert False
    default_view: View[Plain] = View(plain)
    default_restored = deserialize(serialize(default_view))
    if isinstance(default_restored, View):
        assert default_restored.truth()
        assert len(default_restored.display()) > 0
    else:
        assert False
    log: list[int] = []
    assert truth(make_plain(log))
    assert log == [1]
    # Retain representative legacy behavior until the later ABI cutover.
    assert not 0
    assert not ""
    assert not []
    assert str(None) == "None"
    pair = (1, None)
    assert pair.__repr__() == "(1, None)"
    env.exit(0)
