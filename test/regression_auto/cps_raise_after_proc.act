proc def describe(text: str) -> str:
    return repr(text)

proc def parse_float(text: str) -> float:
    try:
        parsed_value = float(text)
    except ValueError:
        raise ValueError(describe(text))
    if parsed_value != parsed_value:
        raise ValueError(describe(text))
    return parsed_value

actor main(env):
    assert parse_float("1.25") == 1.25
    try:
        parse_float("invalid")
        assert False
    except ValueError:
        pass
    try:
        parse_float("nan")
        assert False
    except ValueError:
        pass
    env.exit(0)
