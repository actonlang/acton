pure def make_adder(delta: int) -> pure(int) -> int:
    return pure lambda n: n + delta

class Holder(object):
    def __init__(self, callback: action(int) -> int):
        self.callback = callback

actor main(env):
    holder = Holder(make_adder(7))
    payload = serialize(holder)
    restored = deserialize(payload)
    assert isinstance(restored, Holder)
    if isinstance(restored, Holder):
        assert serialize(restored) == payload
        assert restored.callback(5) == 12
        assert await async restored.callback(6) == 13
    env.exit(0)
