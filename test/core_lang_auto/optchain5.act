actor main(env):
   d = {"a":[1,3,5,8], "b":list(range(30))}
   a = d ?. get("b") ?. __reversed__() . __next__()
   if isinstance(a,just):
       av = a.val
       if av != 29:
           print("av is wrong")
           env.exit(1)
   else:
       print("unexpected loop termination")
       env.exit(1)
   b =  d ?. get("b") ?[1::3] ?[2]
   if b != 7:
       print("b is wrong")
       env.exit(1)
       
   env.exit(0)
