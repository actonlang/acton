## Collection protocols ############################################################################

protocol IIndexed[A (Eq),B]:
    __getitem__  : (A) -> B

protocol MutIndexed[A (Eq),B] (IIndexed[A,B]):
    __setitem__  : mut(A,B) -> None

protocol Indexed[A (Eq),B] (MutIndexed[A,B]):
    __delitem__  : mut(A) -> None

protocol ISliceable[A] (IIndexed[int,A]):
    __getslice__ : (slice) -> Self

protocol Sliceable[A](ISliceable[A], Indexed[int,A]):
    __setslice__ : mut(slice,Iterable[A]) -> None
    __delslice__ : mut(slice) -> None

protocol Collection[A] (Iterable[A]):
    @staticmethod
    __fromiter__ : (Iterable[A]) -> Self
    __len__      : () -> int

protocol Container[A(Eq)] (Collection[A]):
    __contains__    : (A) -> bool
    __containsnot__ : (A) -> bool



#   IIndexed               Iterable       Plus
#     |      \                |            |
#     |       MutIndexed      |            |
#     |           |           |            |
#     |        Indexed        |            |
#     |           |           |            |
#   ISliceable    |        Collection     Times
#     |       \   |           |            |
#     |        Sliceable      |            |
#     |           |           |            |
#   ISequence <-- + <--------- <------------
#             \   |
#              Sequence

protocol ISequence[A] (ISliceable[A], Collection[A], Times[int]):
    __reversed__ : () -> Iterator[A]

protocol Sequence[A] (ISequence[A], Sliceable[A]):
    insert      : mut(int,A) -> None
    append      : mut(A) -> None
    reverse     : mut() -> None



#   Iterable
#    |
#    |
#   Collection
#    |
#    |
#   Container       IIndexed
#    |                |     \
#    |                |     MutIndexed
#   IMapping <---------        |
#    |                         Indexed
#    |                         |
#   Mapping <-------------------

protocol IMapping[A(Eq),B] (Container[A], IIndexed[A,B]):
    get         : (A) -> ?B
    get_def     : (A,B) -> B
    keys        : () -> Iterator[A]
    values      : () -> Iterator[B]
    items       : () -> Iterator[(A,B)]

protocol Mapping[A(Eq), B] (IMapping[A,B], Indexed[A,B]):
    pop         : mut(A) -> ?B
    pop_def     : mut(A,B) -> B
    update      : mut(Iterable[(A,B)]) -> None
    popitem     : mut() -> (A,B)
    setdefault  : mut(A,B) -> ?B


#   Iterable
#    |
#    |
#   Collection      Eq
#    |               |
#    |               |
#   Container       Ord             Logical         Minus
#    |               |               |               |
#    |               |               |               |
#  ISet <------------- <-------------- <--------------
#    |
#    |
#   Set

    
protocol ISet[A (Eq)] (Container[A], Ord, Logical, Minus):
    @staticmethod
    isdisjoint  : (Self,Self) -> bool
    @staticmethod
    union       :  (Self,Self) -> Self
    @staticmethod
    intersection:  (Self,Self) -> Self
    @staticmethod
    difference  :  (Self,Self) -> Self
    @staticmethod
    symmetric_difference:  (Self,Self) -> Self

    def union(a,b):
        return a | b
    def intersection(a,b):
        return a & b
    def difference(a,b):
        return a - b
    def symmetric_difference(a,b):
        return a ^ b



protocol Set[A (Eq)] (ISet[A]):
    add         : mut(A) -> None
    discard     : mut(A) -> None
    pop         : mut() -> A
    update      : mut(Iterable[A]) -> None


