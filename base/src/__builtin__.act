## Exceptions ##################################################################################

# All exceptions should have a human readable error in the error_message field.
# It is generally set by the constructor for each exception class that inherits
# from BaseException to something appropriate for that particular exception. It
# is also a common convention to accept a message as an argument to the
# constructor, which can be used to override the default message.
class BaseException (value):
    error_message: str
    def __init__(self, msg: ?str=None) -> None:
        self.error_message = msg if msg is not None else ""

    def __str__(self) -> str:
        NotImplemented

    def __repr__(self) -> str:
        NotImplemented

    def _name(self) -> str:
        NotImplemented

class SystemExit (BaseException):
    pass

class KeyboardInterrupt (BaseException):
    pass

class Exception (BaseException):
    pass

class StopIteration (Exception):
    pass

class AssertionError (Exception):
    pass

class LookupError (Exception):
    pass

class IndexError (LookupError):
    def __init__(self, index: int, msg: ?str=None):
        self.index = index
        self.error_message = msg if msg is not None else "List index out of range"

    def __str__(self) -> str:
        NotImplemented

    def __repr__(self) -> str:
        NotImplemented

class KeyError(LookupError):
    def __init__(self, key: value, msg: ?str=None):
        self.key = key
        self.error_message = msg if msg is not None else "Key not found"

    def __str__(self) -> str:
        NotImplemented

    def __repr__(self) -> str:
        NotImplemented

class MemoryError (Exception):
    pass

class OSError (Exception):
    pass

class FileNotFoundError (OSError):
    def __init__(self, filename: str):
        self.error_message = ""
        self.filename = filename

    def __str__(self) -> str:
        NotImplemented

    def __repr__(self) -> str:
        NotImplemented

class RuntimeError (Exception):
    pass

class NotImplementedError (RuntimeError):
    pass

class ValueError (Exception):
    pass

class ArithmeticError (Exception):
    pass

class ZeroDivisionError (ArithmeticError):
    pass


## General protocols ###############################################################################

protocol Freeze[A]:
    freeze        : mut() -> A

protocol Identity:
    @staticmethod
    __is__        : (Self,Self) -> bool
    @staticmethod
    __isnot__     : (Self,Self) -> bool

protocol Eq:
    @staticmethod
    __eq__       : (Self,Self) -> bool
    @staticmethod
    __ne__       : (Self,Self) -> bool
    def __ne__(a,b):
        return not (a == b)

protocol Ord (Eq):
    @staticmethod
    __lt__       : (Self,Self) -> bool
    @staticmethod
    __le__       : (Self,Self) -> bool
    @staticmethod
    __gt__       : (Self,Self) -> bool
    @staticmethod
    __ge__       : (Self,Self) -> bool

    def __le__(a,b):
        return a < b or a == b
    def __gt__(a,b):
        return b < a
    def __ge__(a,b):
        return b <= a

protocol Logical:
    @staticmethod
    __and__     : (Self,Self) -> Self
    @staticmethod
    __or__      : (Self,Self) -> Self
    @staticmethod
    __xor__     : (Self,Self) -> Self

    # An in-place form can change its first operand and return it.
    @staticmethod
    __iand__    : mut(Self,Self) -> Self
    @staticmethod
    __ior__     : mut(Self,Self) -> Self
    @staticmethod
    __ixor__    : mut(Self,Self) -> Self

    def __iand__(a,b):
        return a & b
    def __ior__(a,b):
        return a | b
    def __ixor__(a,b):
        return a ^ b

protocol Plus:
    @staticmethod
    __add__      : (Self,Self) -> Self
    # The in-place form can change its first operand and return it.
    @staticmethod
    __iadd__     : mut(Self,Self) -> Self
    @staticmethod
    __zero__     : () -> Self

    def __iadd__(a,b):
        return a + b

protocol Minus:
    @staticmethod
    __sub__      : (Self,Self) -> Self
    # The in-place form can change its first operand and return it.
    @staticmethod
    __isub__     : mut(Self,Self) -> Self

    def __isub__(a,b):
        return a - b

protocol Times[A] (Plus):
    @staticmethod
    __mul__      : (Self,A) -> Self
    # The in-place form can change its first operand and return it.
    @staticmethod
    __imul__     : mut(Self,A) -> Self

    def __imul__(a,b):
        return a * b

protocol Div[A]:
    @staticmethod
    __truediv__  : (Self,Self) -> A
    @staticmethod
    __itruediv__ : (Self,Self) -> A

    def __itruediv__(a,b):
        return a / b

class hasher(object):
    def __init__(self, seed : u64 = 0) -> None:
        NotImplemented 

    def update(self, b : bytes) -> None:
        NotImplemented  

    def finalize(self) -> u64:
        NotImplemented  

protocol Hashable (Eq):
    # Consume h only during this call. It must not be returned, stored, captured
    # by a closure or otherwise retained after hash returns.
    hash : (hasher) -> None

# Element types with a fixed, pointer-free runtime representation suitable for
# array storage.  The initial implementation deliberately supports only the
# two primary Acton numeric types, int and float.
protocol ArrayElement:
    pass

class array[A(ArrayElement)] (object):
    def __init__(self, length: int, initial: ?A=None) -> None:
        NotImplemented

# Fixed-size packed storage for Boolean values.  Unlike sequence indexing,
# negative indices are deliberately rejected rather than counted from the end.
# Logical operations zero-extend the shorter operand: intersection takes the
# shorter length, while union and symmetric difference take the longer length.
# The in-place forms &=, |= and ^= change the bitarray on the left, its length
# included, and keep the right operand.
class bitarray (object):
    def __init__(self, length: int, initial: bool=False) -> None:
        NotImplemented

# A fixed-universe set of non-negative integers backed by packed bits.
# Capacity constrains mutation but is not part of extensional set equality.
# Intersection takes the smaller capacity, difference the capacity of the left
# operand, and union and symmetric difference the larger capacity. The in-place
# forms &=, |=, -= and ^= change the bitset on the left, its capacity included.
class bitset (object):
    def __init__(self, capacity: int, iterable: ?Iterable[int]=None) -> None:
        NotImplemented
    @staticmethod
    def full(capacity: int) -> bitset:
        NotImplemented
    def capacity(self) -> int:
        NotImplemented

class complex (atom):
    def __init__(self, val: Number) -> None:
        NotImplemented

    @staticmethod
    def from_real_imag(real: Real, imag: Real) -> complex:
        NotImplemented

class idict[A(Hashable),B] (object):
    def __init__(self, iterable: ?Iterable[(A,B)]=None) -> None:
        NotImplemented

class dict[A(Hashable),B] (object):
    def __init__(self, iterable: ?Iterable[(A,B)]=None) -> None:
        NotImplemented
# Code generation for calls to copy and clear becomes wrong, so we omit them for now
#    def clear(self) -> None:
#        NotImplemented
#    def copy(self) -> dict[A,B]:
#        NotImplemented

class set[A(Hashable)] (object):
    def __init__(self, iterable: ?Iterable[A]=None) -> None:
        NotImplemented

class iset[A(Hashable)] (object):
    def __init__(self, iterable: ?Iterable[A]=None) -> None:
        NotImplemented

## Number protocols ################################################################################

#   Plus
#    |
#    |
#   Times           Minus
#    |               |
#    |               |
#   Number <----------
#    |
#    |
#   Real
#    |
#    |
#   Rational        Logical
#    |               |
#    |               |
#   Integral <--------

protocol Number (Times[Self],Minus):
    @staticmethod
    __fromatom__ : (atom) -> Self

    __complex__  : () -> complex

    @staticmethod
    __pow__      : (Self,Self) -> Self

    @staticmethod
    __ipow__     : (Self,Self) -> Self

    def __ipow__(a,b):
        return a ** b

    __neg__      : () -> Self
    __pos__      : () -> Self

    real         : () -> Real
    imag         : () -> Real
    __abs__      : () -> Real  # What about arg?

    conjugate    : () -> Self

protocol Real (Number):
    __float__    : () -> float

    __trunc__    : () -> Integral
    __floor__    : () -> Integral
    __ceil__     : () -> Integral

    __round__    : (?int) -> Self

protocol RealFloat (Real):
    pass

protocol Rational (Real):
    numerator    : () -> Integral
    denominator  : () -> Integral

protocol Integral (Rational,Logical):
    __int__      : () -> int
    __index__    : () -> int

    @staticmethod
    __divmod__   : (Self,Self) -> (Self,Self)
    @staticmethod
    __floordiv__ : (Self,Self) -> Self
    @staticmethod
    __mod__      : (Self,Self) -> Self

    @staticmethod
    __ifloordiv__ : (Self,Self) -> Self
    @staticmethod
    __imod__     : (Self,Self) -> Self

    @staticmethod
    __lshift__   : (Self,int) -> Self
    @staticmethod
    __rshift__   : (Self,int) -> Self

    @staticmethod
    __ilshift__  : (Self,int) -> Self
    @staticmethod
    __irshift__  : (Self,int) -> Self

    def __ifloordiv__(a,b):
        return a // b
    def __imod__(a,b):
        return a % b
    def __ilshift__(a,b):
        return a << b
    def __irshift__(a,b):
        return a >> b

    __invert__   : () -> Self

# Root defaults are ordinary extensions, inherited by subclasses. More
# specific builtin and user extensions override them through normal resolution.
extension value (Show):
    NotImplemented
extension value (Bool):
    NotImplemented
extension object (Show):
    NotImplemented
extension object (Bool):
    NotImplemented

## Builtin Show and Bool implementations ############################################################

# Container Show witnesses retain the formatting witnesses of their elements;
# Bool only tests the container itself and adds no Show constraints.
extension int (Show):
    NotImplemented
extension int (Bool):
    NotImplemented

extension i32 (Show):
    NotImplemented
extension i32 (Bool):
    NotImplemented

extension i16 (Show):
    NotImplemented
extension i16 (Bool):
    NotImplemented

extension i8 (Show):
    NotImplemented
extension i8 (Bool):
    NotImplemented

extension u64 (Show):
    NotImplemented
extension u64 (Bool):
    NotImplemented

extension u32 (Show):
    NotImplemented
extension u32 (Bool):
    NotImplemented

extension u16 (Show):
    NotImplemented
extension u16 (Bool):
    NotImplemented

extension u8 (Show):
    NotImplemented
extension u8 (Bool):
    NotImplemented

extension u1 (Show):
    NotImplemented
extension u1 (Bool):
    NotImplemented

extension bigint (Show):
