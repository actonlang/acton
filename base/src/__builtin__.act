# During the staged migration, value retains the legacy slots as well.
protocol Show:
    __str__: () -> str
    __repr__: () -> str

protocol Bool:
    __bool__: () -> bool

## Built-in types ##################################################################################

class value:
    __init__ : () -> None
    def __bool__(self) -> bool:
        NotImplemented
    def __str__(self) -> str:
        NotImplemented
    def __repr__(self) -> str:
        NotImplemented

