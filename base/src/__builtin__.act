## Builtin functions #####################################################

def abs(x : Number) -> Real:
    return x.__abs__()

def all[A(Bool)](it: Iterable[A]) -> bool:
    for x in it:
        if bool(x) == False:
            return False
    return True

def any[A(Bool)](it: Iterable[A]) -> bool:
    for x in it:
        if bool(x) == True:
            return True
    return False

def ascii[A(Show)](x: A) -> str:
    NotImplemented

def bin(x: Integral) -> str:
    NotImplemented

def chr(i: Integral) -> str:
    NotImplemented

def divmod [A(Integral)] (a : A, b : A) -> (A, A): 
    return Integral.__divmod__(a,b)

#def enumerate[A](it: Iterable[A], start: ?int) -> Iterator[(int,A)]:
#     NotImplemented
    
class enumerate[A](Iterator[(int,A)]):
    def __init__(self, it: Iterable[A], start: ?int=None):
        self.itr = iter(it)
        if start is not None:
            self.start = start
        else:
            self.start = 0

    mut def __next__(self):
        nxt = self.itr.__next__()
        if isinstance(nxt,just):
            res = (self.start,nxt.val)
            self.start += 1
            return just(res)
        else:
            return nothing()

class filter[A](Iterator[A]):
    def __init__(self, p: (A)->bool, it: Iterable[A]):
        self.p = p
        self.itr = iter(it)

    def __next__(self):
        nxt = self.itr.__next__()
        if isinstance(nxt,just):
            x = nxt.val
            while not (self.p(x)):
                nxt2 = self.itr.__next__()

                if isinstance(nxt2,just):
                    x = nxt2.val
                else:
                    return nothing()
            return just(x)
        return nothing()

mut def freeze[A](x: Freeze[A]) -> A:
    """Consume an exclusively owned value and return its immutable form.

    The caller must stop using x and any aliases after freezing it.
    The compiler does not yet enforce this ownership requirement.
    """
    return x.freeze()

def hash(x: Hashable) -> u64:
    # Implemented in C, with allocation-free specializations for builtins that
    # hash one contiguous buffer.
    NotImplemented

def seed_hash(seed: u64, x: Hashable) -> u64:
    h = hasher(seed)
    x.hash(h)
    return h.finalize()

def hex(i: Integral) -> str:
    NotImplemented

def iter(x : Iterable[A]) -> Iterator[A]:
    return x.__iter__()

def len(x : Collection[A]) -> int:
    return x.__len__()

class map[A,B](Iterator[B]):
    def __init__(self, f: (A) -> B, it: Iterable[A]):
        self.f = f
        self.itr = iter(it)

    def __next__(self) -> maybe[B]:
        x = self.itr.__next__()
        if isinstance(x,just):
            return just(self.f(x.val))
        return nothing()

class flatmap[A,B](Iterator[B]):
    """Lazily flatten the iterators returned by a pure callback.

    flatmap(f, it) accepts an Iterable[A] and a function from A to
    Iterator[B]. It constructs the outer iterator immediately, then calls
    f as iteration advances. Each inner iterator is exhausted before the
    next input is consumed; empty inner iterators are skipped.

    Use iter() inside f to turn a collection into an iterator. The result
    is a single-pass Iterator[B].
    """
    @property
    _f: (A) -> Iterator[B]
    _outer: Iterator[A]
    _inner: ?Iterator[B]

    def __init__(self, f: (A) -> Iterator[B], it: Iterable[A]):
        self._f = f
        self._outer = iter(it)
        self._inner = None

    mut def __next__(self) -> maybe[B]:
        while True:
            inner = self._inner
            if inner is not None:
                x = inner.__next__()
                if isinstance(x, just):
                    return x
                self._inner = None

            x = self._outer.__next__()
            if isinstance(x, just):
                self._inner = self._f(x.val)
            else:
                return nothing()
        return nothing()

def max [A(Ord)] (it: Iterable[A], dflt: ?A=None) -> A:
    res: ?A = dflt
    for x in it:
        if res is not None:
            res = x if x > res else res
        else:
            res = x
    if res is not None:
        return res
    else:
        raise _empty_max_error

def min [A(Ord)] (it: Iterable[A], dflt: ?A=None) -> A:
    res: ?A = dflt
    for x in it:
        if res is not None:
            res = x if x < res else res
        else:
            res = x
    if res is not None:
        return res
    else:
        raise _empty_min_error


def max_def [A(Ord)] (it: Iterable[A], dflt: A) -> A:
    res = dflt
    for x in it:
        res = x if x > res else res
    return res

def min_def [A(Ord)] (it: Iterable[A], dflt: A) -> A:
    res = dflt
    for x in it:
        res = x if x < res else res
    return res


def next(x : Iterator[A]) -> maybe[A]:
    return x.__next__()

def ord(c: str) -> int:
    NotImplemented

def pow [A(Number)] (a : A, b : A) -> A:
    return Number.__pow__(a,b)

# Show on the positional row carries one renderer for each argument.
print: [P(Show)] => (*P, sep: str, end: str, err: bool, flush: bool) -> None
def print(*args, sep: str=" ", end: str="\n", err: bool=False, flush: bool=False) -> None:
    """Prints values

    Values are printed per default to stdout, but can be printed to stderr by
    setting err=True. Multiple values are separated by the sep argument, a
    space per default. Each invocation will per default add a new line character
    at the end, which can be overridden through the end argument. Output can be
    flushed by setting flush=True.

    It is not possible to write to arbitrary file descriptors. Use the file IO
    functionality to write to files.
    """
    NotImplemented

def repr[A(Show)](x: A) -> str:
    return Show.__repr__(x)

def reversed[A](seq : Sequence[A]) -> Iterator[A]:
    return seq.__reversed__()

def round [A(Real)] (x: A, n: ?int=None) -> A:
    return x.__round__(n)

def serialize(obj: value) -> bytes:
    """Serialize an object graph into a compact binary representation.

    The result can be turned back into an equivalent graph with deserialize().
    Shared and cyclic references within the graph are preserved.
    """
    NotImplemented

def deserialize(data: bytes) -> value:
    """Reconstruct an object graph previously produced by serialize().
    """
    NotImplemented

def sorted [A(Ord)] (iter: Iterable[A]) -> list[A]:
    NotImplemented

def sum [A(Plus)] (it: Iterable[A], start: ?A=None) -> A:
    if start is not None:
        res = start
    else:
        res = Plus.__zero__()
    first = True
    for i in iter(it):
        if first:
            # + makes a new value, which the in-place additions after it can
            # change without changing start
            res = res + i
            first = False
        else:
            res += i
    return res

class zip[A,B](Iterator[(A,B)]):
    def __init__(self, a: Iterable[A], b: Iterable[B]):
        self.a = iter(a)
        self.b = iter(b)
        
    def __next__(self):
        nxta = self.a.__next__()
        if isinstance(nxta,just):
            nxtb = self.b.__next__()
            if isinstance(nxtb,just):
               return just((nxta.val,nxtb.val))
        return nothing()

def gcd(a : bigint, b :bigint) -> bigint:
    NotImplemented

def xgcd(a : bigint, b : bigint) -> (bigint, bigint, bigint):
    NotImplemented

def type(a: ?value) -> str:
    """Get the name of the type of something as a string

    Do not use this for meta-programming. Use isinstance().

    This is only meant for development use as an alternative to letting acton
    print inferred types and similar. It will be removed in a future version
    when there are better ways to debug types.
    """
    NotImplemented

def actorid() -> str:
    NotImplemented

actor StringDecoder(cb_out: action(str) -> None, encoding: ?str="utf-8", on_error: ?action(str, bytes) -> None=None):
    """Bytes to string decoder

    Decodes bytes to string using the provided encoding. If no encoding is given
    UTF-8 is used. The decoder is stateful in order to buffer incomplete multi-
    byte characters.
    """
    MAX_UNICODE_CHAR_SIZE: int = 4
    var buf: bytes = (
        (b"" if encoding.lower() == "utf-8" else raise _unsupported_encoding_error)
        if encoding is not None else b""
    )

    def decode(input: bytes) -> None:
        buf += input
        # Attempt to decode all of buf. If it fails we are likely in the middle
        # of a multi-byte character so we try again by removing the last bytes
        # iteratively until we succeed. UTF-8 has up to 4 bytes per character.
        for i in range(len(buf), len(buf)-MAX_UNICODE_CHAR_SIZE, -1):
            try:
                s = buf[:i].decode()
                buf = buf[i:]
                cb_out(s)
                return
            except ValueError:
                pass
        if on_error is not None:
            on_error("Invalid UTF-8", buf)
        else:
            raise ValueError(f"Invalid UTF-8: {str(buf)}")

## Environment ################################################

class WorldCap():
    """WorldCap has the capability to access the entire world outside of Acton.
    It is the root of the capability hierarchy.

    In an actor world, access to actors (like being able to call their methods)
    requires a reference to the relevant actor. Anyone with a reference can
    access the actor in question. It is not possible to forge a reference.

    In Acton, things outside the actor world are represented as actors with the
    associated capabilities. For example, with a reference to the TCPConnectCap
    actor, we have the capability of using a POSIX socket to connect to a remote
    host over the network. TCPConnectCap is part of a capability hierarchy,
    starting with the generic WorldCap and becoming further and further refined:

      WorldCap > NetCap > TCPCap > TCPConnectCap

    There are other more refined Caps that each have a a subset of the
    capabilities of the world.

    Capability based privilege restriction prevent some deeply nested part of a
    program, perhaps in a dependency to a dependency, to perform operations
    unknown to the application author. Access to capabilities must be explicitly
    handed out and a program can only perform operations based on the
    capabilities it has access to.
    """
    pass

class _EnvCap():
    """_EnvCap authorizes construction of Env and its services.

    Only the RTS creates one, when it bootstraps Env, with the constructor
    the compiler generates from this __init__. The name is private to
    __builtin__, so user code can neither construct nor subclass it.
    """
    def __init__(self):
        pass

class EnvRTS:
    """Runtime information and controls, reached as env.rts.

    Each query returns fresh values. Worker counters are independent
    observations and can change while a query is being read.
    """
    def __init__(self, envcap: _EnvCap, wthreads: int):
        self._wthreads = wthreads

    def gc(self) -> None:
        """Run a full collection, retaining free memory for reuse."""
        NotImplemented

    def enable_gc(self) -> None:
        """Enable garbage collection."""
        NotImplemented

    def disable_gc(self) -> None:
        """Disable garbage collection until enable_gc is called."""
        NotImplemented

    def start_gc_performance_measurement(self) -> None:
        """Enable measurement of time spent collecting garbage."""
        NotImplemented

    def gc_info(self) -> (mode: str, backend: str, supported_backends: list[str], page_hash_table_log2: u64, block_size: u64, end_padding: bool, thread_local_size_limit: u64, no_thread_local_warmup: bool, thread_local_refill_blocks: u64, realloc_no_free: bool, markers: u64, bytes_per_marker: u64, mark_range_stealing: bool, mark_bits: bool, initial_mark_stack_size: u64, pause_target_ms: ?float, free_space_divisor: u64, full_frequency: u64, heap_growth_divisor: u64, alloc_budget_percent: u64, memory_limit: u64, heap_ceiling_percent: u64):
        """Read the collector's build configuration and current policy.

        mode is ordinary or generational. backend is the active dirty-tracking
        backend, or none in ordinary mode. supported_backends lists the mechanisms
        the collector is built with.

        page_hash_table_log2 describes 2**n page-hash bits per table, used by dirty
        tracking and blacklisting. block_size is the heap block size in bytes.
        end_padding tells whether objects are padded by a byte, so that a pointer
        just past the end of an object keeps it alive. thread_local_size_limit is
        the largest object size, including any padding, that threads allocate
        from their own free lists, or 0 without thread-local allocation.
        no_thread_local_warmup tells whether a new thread takes its own free
        list of a size at its first allocation of that size, instead of after
        allocating about a heap block of that size under the allocator lock. It
        includes the effect of the GC_NO_THREAD_LOCAL_WARMUP environment
        variable, and is False without thread-local allocation.
        thread_local_refill_blocks is the largest number of heap blocks that one
        refill of a thread's free list takes under the allocator lock, including
        the effect of the GC_TL_REFILL_MAX environment variable, or 0 without
        thread-local allocation.
        realloc_no_free tells whether GC_realloc leaves a small collectable
        object it has moved to the collector instead of freeing it, including
        the effect of the GC_REALLOC_NO_FREE environment variable.
        markers includes the initiating thread and is the available marking
        parallelism, not the number active in every slice. bytes_per_marker,
        when nonzero, gives a mark phase one marker per that many bytes it is
        estimated to scan, so that a small phase is marked by fewer threads, or
        by the initiating thread alone; 0 gives every phase all the markers.
        mark_range_stealing tells whether markers claim ranges of the global
        mark stack. mark_bits tells whether the collector keeps its marks as
        bits instead of bytes.
        initial_mark_stack_size is the number of entries the global mark stack
        starts with; it grows when marking overflows it.
        pause_target_ms is a best-effort marking time target, including any
        fractional millisecond, or None in ordinary mode and in generational mode
        with one stop per collection.
        full_frequency is the number of partial collections between full ones;
        other conditions can trigger full collections sooner. heap_growth_divisor
        limits one automatic heap expansion to the heap size divided by it, or to
        the collector's fixed increment if that is larger; 0 means the fixed
        increment. alloc_budget_percent, when nonzero, starts a collection after
        allocating that percentage of the data live at the previous collection
        instead of using the free space divisor.
        memory_limit is the memory limit of the process in bytes: the smallest of
        the physical memory, on Linux the cgroup memory limit, and the limit set
        with gc_memory_limit or the GC_MEMORY_LIMIT environment variable, or 0 if
        none is known. heap_ceiling_percent is the heap ceiling as a percentage
        of memory_limit, including the effect of the GC_HEAP_CEILING_PERCENT
        environment variable. When it, alloc_budget_percent and memory_limit are
        nonzero, the allocation between collections is at most half the distance
        from the live data to the ceiling, but at least 10% of the live data, and
        in ordinary mode the heap grows to the live data plus that allocation at
        once instead of by heap_growth_divisor.

        """
        NotImplemented

    def gc_stats(self) -> (heap_size: u64, free_bytes: u64, unmapped_bytes: u64, mem_usage: u64, total_bytes: u64, bytes_since_gc: u64, total_ms: u64, mark_ms: u64, sweep_ms: u64):
        """Read collector memory and cumulative collection time.

        Memory values are bytes. heap_size and free_bytes both include
        unmapped_bytes. mem_usage is their difference: approximate occupied
        heap, rather than resident memory. total_bytes counts allocations
        since startup, and bytes_since_gc since the latest collection.
        Time values are milliseconds, after performance measurement starts.
        """
        NotImplemented

    def process_stats(self) -> (rss: ?u64, peak_rss: ?u64, user_ns: ?u64, system_ns: ?u64):
        """Read process resident memory in bytes and CPU time in nanoseconds.

        Includes startup and all threads. Unavailable values are None.
        """
        NotImplemented

    def fd_stats(self) -> (open: ?u64, limit: ?u64):
        """Read the number of open file descriptors and how many may be open.

        open counts every descriptor of the process: files, sockets, pipes,
        stdin, stdout and stderr, and those of the RTS itself. Other actors
        can open and close descriptors while it is counted. It is None when
        the descriptors cannot be listed, as when the process has as many
        open as limit. On Windows, open counts the handles of the process,
        of every kind, threads and events included.

        limit is the most descriptors the process may have open. The RTS
        raises it to the hard limit at startup. On macOS it is at most
        kern.maxfilesperproc. On Windows it is None, since Windows sets no
        such limit.
        """
        NotImplemented

    def perf_info(self) -> dict[str, str]:
        """Describe the performance counter backend, scope and machine."""
        NotImplemented

    def perf_stats(self) -> (user_ns: ?u64, system_ns: ?u64, instructions: ?u64, cycles: ?u64, instructions_enabled: u64, instructions_running: u64, cycles_enabled: u64, cycles_running: u64):
        """Read cumulative process CPU and hardware counters.

        CPU times are nanoseconds. Hardware counts require --rts-perf
        at process start. Unavailable measurements are None. Coverage values
        detect intervals with uncounted work. Subtract integers before
        converting to float, and reject incomplete counter coverage.
        """
        NotImplemented

    def worker_info(self) -> dict[int, (name: str, stack_size: ?u64)]:
        """Describe the main thread (ID 0) and worker threads.

        stack_size is the actual stack size in bytes captured at startup,
        or None before that worker finishes initializing or when unavailable.
        """
        NotImplemented

    def worker_stats(self) -> dict[int, (state: str, waits_enabled: bool, sleeps: u64, conts_count: u64, conts_sum: u64, conts_100ns: u64, conts_1us: u64, conts_10us: u64, conts_100us: u64, conts_1ms: u64, conts_10ms: u64, conts_100ms: u64, conts_1s: u64, conts_10s: u64, conts_100s: u64, conts_inf: u64, bkeep_count: u64, bkeep_sum: u64, bkeep_100ns: u64, bkeep_1us: u64, bkeep_10us: u64, bkeep_100us: u64, bkeep_1ms: u64, bkeep_10ms: u64, bkeep_100ms: u64, bkeep_1s: u64, bkeep_10s: u64, bkeep_100s: u64, bkeep_inf: u64, wait_count: u64, wait_sum: u64, wait_max: u64, wait_1us: u64, wait_10us: u64, wait_100us: u64, wait_1ms: u64, wait_10ms: u64, wait_100ms: u64, wait_1s: u64, wait_inf: u64, steal_ops: u64, steal_actors: u64, balance_ops: u64, balance_actors: u64, balance_looks: u64, balance_young: u64, balance_stale: u64)]:
        """Read worker states, cumulative counters and duration histograms.

        state is poof, work, idle or sleep. ID 0 is the main thread.
        conts measures actor continuations; bkeep measures bookkeeping
        between continuations. Sums and wait_max are nanoseconds. Each
        histogram bucket counts durations below its named upper bound
        and above the preceding bound; inf holds the remaining durations.
        Queue waits are collected only when RTS monitoring is enabled,
        as indicated by waits_enabled. steal and balance count operations
        and actors taken from other workers' queues.
        """
        NotImplemented

    proc def io_handles(self) -> dict[int, dict[u64, (typ: str, act: u64)]]:
        """Inspect I/O handles on each worker's event loop.

        Keys are worker IDs, then handle addresses. act is the actor
        address for TCP handles, or 0 for other handles.
        """
        monitors = {i: _RTSWorkerMonitor(i) for i in range(self._wthreads + 1)}
        return {i: monitor.io_handles() for i, monitor in monitors.items()}

    def sleep(self, duration: float) -> None:
        """Put the calling worker thread to sleep for duration seconds.

        Used to simulate work in tests and benchmarks. Other actors on
        that worker also wait while it sleeps.
        """
        NotImplemented

actor _RTSWorkerMonitor(wthread_id: int):
    def io_handles():
        return _rts_io_handles()

    proc def _init():
        NotImplemented
    proc def __startup__():
        _init()

def _rts_io_handles() -> dict[u64, (typ: str, act: u64)]:
    NotImplemented

actor Env (wc: WorldCap, args: list[str], wthreads: int, envcap: _EnvCap):
    cap = wc
    auth = wc
    argv = args
    nr_wthreads = wthreads
    vars = EnvVar(envcap)
    stdio = Stdio(envcap, vars)
    process = EnvProcess(envcap, vars)
    rts = EnvRTS(envcap, wthreads)
    random = EnvRandom(envcap)

    action def exit(n: int):
        NotImplemented

protocol Random:
    """A source of uniformly distributed random numbers

    A source implements rand_u64, and the protocol builds the other methods on
    it. A source may override them with a faster equivalent, but must then
    return exactly what the default would for the same rand_u64 values, so that
    seeded sequences do not change.

    env.random is a source of secure random numbers from the operating system.
    The std.random module has seeded generators, and shuffle and shuffled,
    which reorder a sequence using any source.
    """
    rand_u64 : mut() -> u64
    rand_int : mut() -> int
    rand_float : mut() -> float
    rand_bytes : mut(int) -> bytes
    below : mut(int) -> int
    between : mut(int, int) -> int

    mut def rand_int(self) -> int:
        """Return a random int x with x >= 0

        Every non-negative int is equally likely. For an int in a range, use
        below or between.
        """
        return int(self.rand_u64() >> 1)

    mut def rand_float(self) -> float:
        """Return a random float x with 0.0 <= x < 1.0

        x is a multiple of 2**-53, and each of the 2**53 multiples in the range
        is equally likely.
        """
        return float(self.rand_u64() >> 11) * 1.1102230246251565e-16 # 2**-53

    mut def rand_bytes(self, n: int) -> bytes:
        """Return n random bytes

        Each rand_u64 value supplies 8 bytes, least significant first. Raises
        ValueError if n < 0.
        """
        if n < 0:
            raise ValueError(f"rand_bytes: n must not be negative, got {n}")
        res: list[int] = []
        x: u64 = 0
        for i in range(n):
            if i % 8 == 0:
                x = self.rand_u64()
            res.append(int(x & 255))
            x = x >> 8
        return bytes(res)

    mut def below(self, n: int) -> int:
        """Return a random int x with 0 <= x < n

        Every such x is equally likely. Raises ValueError if n <= 0.
        """
        if n <= 0:
            raise ValueError(f"below: n must be positive, got {n}")
        return int(_random_uniform(self, u64(n)))

    mut def between(self, lo: int, hi: int) -> int:
        """Return a random int x with lo <= x < hi

        hi itself is never returned, so a die roll is between(1, 7). Every such
        x is equally likely, even when hi - lo does not fit in an int. Raises
        ValueError if lo >= hi.
        """
        if lo >= hi:
            raise ValueError(f"between: lo must be less than hi, got {lo} and {hi}")
        # The arithmetic is done in u64, where it wraps, so the span and the
        # offset from lo are exact whatever lo and hi are.
        ulo = _random_as_u64(lo)
        return _random_as_int(ulo + _random_uniform(self, _random_as_u64(hi) - ulo))

mut def _random_uniform[R(Random)](r: R, n: u64) -> u64:
    """Return a random u64 x with 0 <= x < n, for n > 0"""
    # Reject the 2**64 % n smallest values, leaving a multiple of n values to
    # reduce mod n, so that no remainder is more likely than another. At least
    # half of all values are kept, whatever n is.
    threshold = (18446744073709551615 - n + 1) % n
    x = r.rand_u64()
    while x < threshold:
        x = r.rand_u64()
    return x % n

def _random_as_u64(x: int) -> u64:
    """The u64 with the same 64 bits as x, as two's complement"""
    if x >= 0:
        return u64(x)
    return u64(x + 9223372036854775807 + 1) + 9223372036854775808

def _random_as_int(x: u64) -> int:
    """The int with the same 64 bits as x, as two's complement"""
    if x < 9223372036854775808:
        return int(x)
    return int(x - 9223372036854775808) - 9223372036854775807 - 1

class EnvRandom():
    """Secure random numbers from the operating system, reached as env.random

    Use it for keys, nonces, tokens and anything else that must not be
    guessable. Each thread draws from its own ChaCha8 generator with forward
    secrecy, seeded from the operating system's entropy source the first time
    that thread asks for random data. If the operating system cannot provide
    entropy, the methods raise OSError rather than fall back to something
    weaker.

    EnvRandom is a class, so its methods run directly in the calling actor and
    return their result at once, without a message to Env.

    EnvRandom implements the Random protocol, which adds rand_int, rand_float,
    below and between. The seeded generators in std.random can take their seed
    from here.
    """
    def __init__(self, envcap: _EnvCap):
        pass

    mut def rand_u64(self) -> u64:
        """Return a random u64"""
        NotImplemented

    mut def rand_bytes(self, n: int) -> bytes:
        """Return n random bytes"""
        NotImplemented

# The methods of EnvRandom itself are written in C, and its rand_bytes fills
# the result straight from the generator rather than 8 bytes at a time.
extension EnvRandom(Random):
    mut def rand_u64(self) -> u64:
        return self.rand_u64()

    mut def rand_bytes(self, n: int) -> bytes:
        return self.rand_bytes(n)

actor EnvVar(envcap: _EnvCap):
    """Environment variables of the process, reached as env.vars"""
    action def getenv(name: str) -> ?str:
        """Get the value of an environment variable"""
        res = getenvb(name.encode())
        if res is not None:
            return res.decode()
        return None

    action def getenvb(name: bytes) -> ?bytes:
        """Get the value of an environment variable"""
        NotImplemented

    action def setenv(n: str, v: str) -> None:
        """Set the value of an environment variable"""
        setenvb(n.encode(), v.encode())

    action def setenvb(n: bytes, v: bytes) -> None:
        """Set the value of an environment variable"""
        NotImplemented

    action def unsetenv(n: str) -> None:
        """Unset an environment variable"""
        unsetenvb(n.encode())

    action def unsetenvb(n: bytes) -> None:
        """Unset an environment variable"""
        NotImplemented

actor Stdio(envcap: _EnvCap, vars: EnvVar):
    """Standard input, output and error of the process, reached as env.stdio"""
    action def out(s: str) -> None:
        """Write s to stdout"""
        NotImplemented

    action def err(s: str) -> None:
        """Write s to stderr"""
        NotImplemented

    action def outb(b: bytes) -> None:
        """Write b to stdout"""
        NotImplemented

    action def errb(b: bytes) -> None:
        """Write b to stderr"""
        NotImplemented

    action def stdin_install(on_stdin: ?action(str) -> None=None, encoding: ?str=None, on_error: ?action(str, bytes) -> None=None, on_stdin_bytes: ?action(bytes) -> None=None) -> None:
        """Install a handler for stdin

        The process has one reader of stdin. Installing a handler again
        replaces the handler before it, and the data that arrives after that
        goes to the new handler only.
        """
        if on_stdin is None and on_stdin_bytes is None:
            raise _missing_stdin_callback_error
        elif on_stdin_bytes is not None:
            if encoding is not None:
                raise _stdin_bytes_encoding_error
            if on_error is not None:
                raise _stdin_bytes_on_error_error
            _on_stdin_bytes(on_stdin_bytes)
        elif on_stdin is not None:
            if encoding is None:
                # If no encoding is given, attempt to discover the encoding used
                # Default to utf-8 if we're unable to discover the encoding
                encoding = "utf-8"
                # Read encoding from the LANG environment variable
                lang_env = vars.getenv("LANG")
                if lang_env is not None:
                    try:
                        encoding = lang_env.split(".")[1].lower()
                    except:
                        pass
            # If stdin is attached to a terminal, attempt to discover the
            # encoding used by the terminal by inspecting the LANG environment
            # variable.
            sd = StringDecoder(on_stdin, encoding, on_error)
            _on_stdin_bytes(sd.decode)

    action def set_stdin(canonical: ?bool=None, echo: ?bool=None, raw: ?bool=None) -> None:
        """Set terminal options of stdin

        raw=True puts stdin in raw mode, for programs that handle every key
        themselves, like a line editor. Each key press arrives as its bytes
        when it is pressed and is not echoed. The keys that the terminal
        otherwise acts on arrive as bytes too: Ctrl-C, Ctrl-Z and Ctrl-Backslash
        send no signal, Ctrl-S and Ctrl-Q do not stop and start output,
        Ctrl-V and Ctrl-Y arrive as typed, and Enter arrives as a carriage
        return. Output is not changed, so a newline written to stdout still
        starts a new line. canonical and echo are set after raw, so
        set_stdin(raw=True, echo=True) gives raw mode with echo.
        raw=False puts back all the settings from before raw=True, which
        undoes a change to canonical or echo made in raw mode.

        Does nothing when stdin is not a terminal. When the program exits,
        the terminal gets back the settings it had when the program started.
        """
        NotImplemented

    action def stdin_is_tty() -> bool:
        """Check if stdin is a terminal"""
        NotImplemented

    action def stdout_is_tty() -> bool:
        """Check if stdout is a terminal"""
        NotImplemented

    action def stderr_is_tty() -> bool:
        """Check if stderr is a terminal"""
        NotImplemented

    action def term_size() -> ?(columns: int, rows: int):
        """Read the size of the terminal on stdout

        None when stdout is not a terminal or when the terminal reports no
        size. The size changes when the user resizes the terminal window, so
        read it again before laying out output that depends on it.
        """
        NotImplemented

    action def _on_stdin_bytes(cb: action(bytes) -> None) -> None:
        NotImplemented

actor Process(envcap: _EnvCap,
              vars: EnvVar,
              cmd: list[str],
              on_stdout: action(Process, ?bytes) -> None,
              on_stderr: action(Process, ?bytes) -> None,
              on_exit: action(Process, int, int) -> None,
              on_error: action(Process, str) -> None,
              workdir: ?str=None,
              env: ?dict[str, str]=None,
              timeout: ?float=None):
    """A child process, started through env.process"""
    var _p: int = 0
    var new_env = env

    action def aid() -> int:
        """Actor ID of process actor

        Workaround for lack of working repr on actors.
        """
        NotImplemented

    proc def _create_process():
        """Do the C magic to actually create a process and talk to it
        """
        NotImplemented

    action def done_writing() -> None:
        """Close stdin of process

        Closing stdin allows cat to terminate
        """
        NotImplemented

    action def pid() -> ?int:
        """Get PID of process or None if the process is not running
        """
        NotImplemented

    action def signal(signal: int) -> None:
        """Send signal to process

        Sends the provided signal to the process.
        """
        NotImplemented

    action def write(data: bytes) -> None:
        """Write data to stdin of process
        """
        NotImplemented

    action def kill():
        """Abruptly kill process by sending SIGKILL
        """
        signal(9)

    action def terminate():
        """Stop process by sending SIGTERM
        """
        signal(15)

    def stop():
        """Stop process

        Attempts to stop process using normal means, which means SIGTERM on a
        Unix system. After 1 second, SIGKILL is sent to ensure the process is
        stopped.
        """
        terminate()
        after 1.0: kill()

    proc def __startup__():
        # Handle PATH inheritance for custom environments
        # When PATH is not explicitly set in the provided environment, inherit it
        # from the current environment (if set in the current environment).
        if env is not None and "PATH" not in env:
            parent_path = vars.getenv("PATH")
            if parent_path is not None:
                new = dict(env.items())
                new["PATH"] = parent_path
                new_env = new

        _create_process()

        if timeout is not None:
            after timeout: stop()


actor RunProcess(envcap: _EnvCap,
                 vars: EnvVar,
                 cmd: list[str],
                 on_exit: action(Process, int, int, bytes, bytes) -> None,
                 on_error: action(Process, str) -> None,
                 workdir: ?str=None,
                 env: ?dict[str, str]=None,
                 timeout: ?float=None):
    """Run a process and wait for it to finish
    """
    var out_buf = b""
    var err_buf = b""
    var _out_done = False
    var _err_done = False
    var _exited = False
    var _exit_code = 0
    var _signal = 0
    var _process: ?Process = None


    def _on_stdout(p: Process, data: ?bytes):
        if data is not None:
            out_buf += data
        else:
            _out_done = True
            _check_done()

    def _on_stderr(p: Process, data: ?bytes):
        if data is not None:
            err_buf += data
        else:
            _err_done = True
            _check_done()

    def _on_exit(p: Process, exit_code: int, signal: int):
        _exited = True
        _exit_code = exit_code
        _signal = signal
        _check_done()

    def _check_done():
        if _process is not None:
            if _out_done and _err_done and _exited:
                on_exit(_process, _exit_code, _signal, out_buf, err_buf)

    _p = Process(envcap, vars, cmd, _on_stdout, _on_stderr, _on_exit, on_error, workdir, env, timeout)

    def signal(sig: int):
        """Send signal to process"""
        _p.signal(sig)

    def kill():
        """Abruptly kill process by sending SIGKILL
        """
        _p.kill()

    def terminate():
        """Stop process by sending SIGTERM
        """
        _p.terminate()

    def stop():
        """Stop process

        Attempts to stop process using normal means, which means SIGTERM on a
        Unix system. After 1 second, SIGKILL is sent to ensure the process is
        stopped.
        """
        _p.stop()

    proc def __startup__():
        _process = _p


actor EnvProcess(envcap: _EnvCap, vars: EnvVar):
    """Spawning of child processes, reached as env.process"""

    def spawn(cmd: list[str],
              on_stdout: action(Process, ?bytes) -> None,
              on_stderr: action(Process, ?bytes) -> None,
              on_exit: action(Process, int, int) -> None,
              on_error: action(Process, str) -> None,
              workdir: ?str=None,
              env: ?dict[str, str]=None,
              timeout: ?float=None) -> Process:
        """Start a child process

        - cmd: the command to run
        - on_stdout: stdout callback actor method
        - on_stderr: stderr callback actor method
        - on_exit: exit callback
          - process
          - exit code
          - signal that caused program to exit
        - on_error: error callback
        - workdir: working directory, use None for current directory
        - env: environment for process, use None to inherit current environment
          When a new env is provided and it does not have PATH set, PATH is
          inherited from the current env. The PATH variable in the new env,
          regardless if the new env is inherited or provided, is used to find the
          executable specified by cmd (unless cmd is a path).
        - timeout: time in seconds before process is stopped
        """
        return Process(envcap, vars, cmd, on_stdout, on_stderr, on_exit, on_error, workdir, env, timeout)

    def run(cmd: list[str],
            on_exit: action(Process, int, int, bytes, bytes) -> None,
            on_error: action(Process, str) -> None,
            workdir: ?str=None,
            env: ?dict[str, str]=None,
            timeout: ?float=None) -> RunProcess:
        """Start a child process and report when it has finished

        The arguments are as for spawn, except that there are no on_stdout and
        on_stderr callbacks. Instead on_exit gets everything the process wrote
        to stdout and stderr, once the process has exited and both streams are
        closed.
        """
        return RunProcess(envcap, vars, cmd, on_exit, on_error, workdir, env, timeout)
