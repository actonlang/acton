        """Add the elements of b to a. Return a.

        a gets the larger capacity of the two.
        """
        NotImplemented

    def __ixor__(a, b):
        """Remove the elements of b that are in a and add the others. Return a.

        a gets the larger capacity of the two.
        """
        NotImplemented

    def __isub__(a, b):
        """Remove the elements of b from a. Return a."""
        NotImplemented

