"""Network IO
"""

class NetCap():
    """Capability to access network"""
    def __init__(self, cap: WorldCap):
        pass

class DNSCap():
    """Capability to perform DNS queries"""
    def __init__(self, cap: NetCap):
        pass

class TCPCap():
    """Capability to connect or listen with TCP"""
    def __init__(self, cap: NetCap):
        pass

class UDPCap():
    """Capability to connect or listen with UDP"""
    def __init__(self, cap: NetCap):
        pass

class TCPConnectCap():
    """Capability to connect using TCP to a remote host"""
    def __init__(self, cap: TCPCap):
        pass

class TCPListenCap():
    """Capability to listen with TCP"""
    def __init__(self, cap: TCPCap):
        pass

class UDPConnectCap():
    """Capability to connect using UDP to a remote host"""
    def __init__(self, cap: UDPCap):
        pass

class UDPListenCap():
    """Capability to listen with UDP"""
    def __init__(self, cap: UDPCap):
        pass

class _TCPListenConnectCap():
    """Internal use only"""
    pass

def is_ipv4(address: str) -> bool:
    NotImplemented

def is_ipv6(address: str) -> bool:
    NotImplemented

def _lookup_a(name: str, on_resolve: action(list[str]) -> None, on_error: action(str, str) -> None) -> None:
    """Perform DNS lookup for name of record type A
    """
    NotImplemented

def _lookup_aaaa(name: str, on_resolve: action(list[str]) -> None, on_error: action(str, str) -> None) -> None:
    """Perform DNS lookup for name of record type AAAA
    """
    NotImplemented

def _lookup_udp_a(name: str, on_resolve: action(list[str]) -> None, on_error: action(str, str) -> None) -> None:
    """Perform UDP DNS lookup for name of record type A
    """
    NotImplemented

def _lookup_udp_aaaa(name: str, on_resolve: action(list[str]) -> None, on_error: action(str, str) -> None) -> None:
    """Perform UDP DNS lookup for name of record type AAAA
    """
    NotImplemented


def lookup_a(cap: DNSCap, name: str, on_resolve: action(list[str]) -> None, on_error: action(str, str) -> None) -> None:
    """Perform DNS lookup for name of record type A
    """
    _lookup_a(name, on_resolve, on_error)

def lookup_aaaa(cap: DNSCap, name: str, on_resolve: action(list[str]) -> None, on_error: action(str, str) -> None) -> None:
    """Perform DNS lookup for name of record type AAAA
    """
    _lookup_aaaa(name, on_resolve, on_error)


actor UDPConnection(cap: UDPConnectCap, address: str, port: int, on_connect: action(UDPConnection) -> None, on_receive: action(UDPConnection, bytes, str, int) -> None, on_error: action(UDPConnection, str) -> None, connect_timeout: float=10.0):
    """UDP IP connection to a fixed remote address"""
    var _sock = -1
    var _state = 0
    var _dns_errors = 0
    var _dns_error = ""
    var _remote_address = ""
    var _ip_version = 0

    STATE_NONE = 0
    STATE_RESOLVING = 1
    STATE_CONNECTING = 2
    STATE_CONNECTED = 3
    STATE_CLOSED = 4

    var _connections = 0
    var _consecutive_connect_errors = 0
    var _bytes_in: u64 = 0
    var _bytes_out: u64 = 0
    var _datagrams_in: u64 = 0
    var _datagrams_out: u64 = 0

    proc def _pin_affinity() -> None:
        NotImplemented
    _pin_affinity()

    def _on_dns_resolve(ip_version: int, result: list[str]):
        if _state != STATE_RESOLVING:
            return
        if len(result) == 0:
            _on_dns_error(address, "DNS lookup returned no UDP addresses")
            return
        _state = STATE_CONNECTING
        if ip_version == 4:
            _connect4(result[0])
        else:
            _connect6(result[0])

    def _on_dns_a_resolve(result: list[str]):
        _on_dns_resolve(4, result)

    def _on_dns_aaaa_resolve(result: list[str]):
        _on_dns_resolve(6, result)

    def _on_dns_error(name: str, msg: str):
        if _state != STATE_RESOLVING:
            return
        _dns_errors += 1
        if _dns_error == "":
            _dns_error = msg
        else:
            _dns_error = _dns_error + "  " + msg
        if _dns_errors >= 2:
            _state = STATE_CLOSED
            _consecutive_connect_errors += 1
            on_error(self, _dns_error)

    action def _on_udp_ready():
        if _state == STATE_CONNECTING:
            _state = STATE_CONNECTED
            _connections += 1
            _consecutive_connect_errors = 0
            on_connect(self)

    action def _on_udp_error(err: int, errmsg: str):
        _state = STATE_CLOSED
        _consecutive_connect_errors += 1
        on_error(self, errmsg)

    proc def _connect4(ip_address: str) -> None:
        NotImplemented

    proc def _connect6(ip_address: str) -> None:
        NotImplemented

    action def write(data: bytes) -> None:
        """Write a datagram to the configured remote"""
        NotImplemented

    action def close() -> None:
        """Close the UDP socket"""
        NotImplemented

    def _connect_timeout():
        if _state == STATE_RESOLVING or _state == STATE_CONNECTING:
            _state = STATE_CLOSED
            _consecutive_connect_errors += 1
            close()
            on_error(self, "UDP setup failed due to timeout")

    def _connect(c):
        after connect_timeout: _connect_timeout()
        if is_ipv4(address):
            _state = STATE_CONNECTING
            _connect4(address)
        elif is_ipv6(address):
            _state = STATE_CONNECTING
            _connect6(address)
        else:
            _state = STATE_RESOLVING
            _lookup_udp_aaaa(address, _on_dns_aaaa_resolve, _on_dns_error)
            _lookup_udp_a(address, _on_dns_a_resolve, _on_dns_error)

    mut def __resume__() -> None:
        NotImplemented

    action def ip_version() -> ?int:
        if _ip_version == 0:
            return None
        return _ip_version

    action def local_address() -> str:
        NotImplemented

    action def local_port() -> int:
        NotImplemented

    action def remote_address() -> str:
        return _remote_address

    action def metrics():
        return (connections=_connections,
                consecutive_connect_errors=_consecutive_connect_errors,
                bytes_in=_bytes_in,
                bytes_out=_bytes_out,
                datagrams_in=_datagrams_in,
                datagrams_out=_datagrams_out)

    _connect(self)


actor UDPListener(cap: UDPListenCap, address: str, port: int, on_listen: action(UDPListener, ?str) -> None, on_receive: action(UDPListener, bytes, str, int) -> None, on_error: action(UDPListener, str) -> None):
    """UDP Listener"""
    var _sock = -1
    var _bytes_in: u64 = 0
    var _bytes_out: u64 = 0
    var _datagrams_in: u64 = 0
    var _datagrams_out: u64 = 0

    action def send(data: bytes, address: str, port: int) -> None:
        """Send a datagram to a remote address"""
        NotImplemented

    action def close() -> None:
        """Close listener"""
        NotImplemented

    action def local_address() -> str:
        NotImplemented

    action def local_port() -> int:
        NotImplemented

    action def metrics():
        return (bytes_in=_bytes_in,
                bytes_out=_bytes_out,
                datagrams_in=_datagrams_in,
                datagrams_out=_datagrams_out)

    mut def __resume__() -> None:
        NotImplemented

    proc def _init() -> None:
        """Implementation internal"""
        NotImplemented
    _init()


actor TCPConnection(cap: TCPConnectCap, address: str, port: int, on_connect: action(TCPConnection) -> None, on_receive: action(TCPConnection, bytes) -> None, on_error: action(TCPConnection, str) -> None, on_remote_close: ?action(TCPConnection) -> None=None, connect_timeout: float=10.0):
    """TCP IP Connection

    The connection is set up when the actor is created. A host name is
    resolved to IPv4 and IPv6 addresses and the two address families race
    (Happy Eyeballs): the first to connect wins and the other attempt is
    abandoned. Each connection attempt ends with exactly one call to either
    on_connect or on_error, unless close() or abort() cancels it first.
    connect_timeout limits the whole attempt, name resolution included.

    Once connected, on_error reports read and write errors, such as a
    connection reset by the peer, after which the connection is closed.
    on_remote_close reports that the peer closed the connection.
    """
    var _a_res: list[str] = []
    var _aaaa_res: list[str] = []
    var _sock = -1
    var _sock4 = -1
    var _sock4_state = 0
    var _sock4_error = ""
    var _sock6 = -1
    var _sock6_state = 0
    var _sock6_error = ""
    var _dns_error = ""
    # Identifies the current connection attempt, so that DNS results and
    # timeouts of an abandoned attempt are ignored
    var _attempt = 0

    STATE_NONE = 0
    STATE_RESOLVING  = 1 # Resolving DNS
    STATE_CONNECTING = 2 # Got DNS response or input was IP address so now doing TCP connect
    STATE_CONNECTED  = 3 # TCP Connected
    STATE_CLOSED     = 4 # TCP Connection disconnected / closed (it might never have been connected)
    var _state = STATE_NONE

    var _connections = 0
    var _consecutive_connect_errors = 0
    var _bytes_in: u64 = 0
    var _bytes_out: u64 = 0

    proc def _pin_affinity() -> None:
        NotImplemented
    _pin_affinity()

    # TODO: we should not just connect to the first IPv4 and first IPv6 result
    # but rather arrange them in order of preference and try them in that order,
    # more details in Happy Eye Balls v2 https://tools.ietf.org/html/rfc8305

    def _on_dns_resolve(attempt: int, family: int, result: list[str]):
        if attempt != _attempt:
            return
        if family == 4:
            if _sock4_state != STATE_RESOLVING:
                return
            if len(result) == 0:
                _on_dns_error(attempt, 4, "DNS lookup returned no IPv4 addresses")
                return
            _a_res = result
            _sock4_state = STATE_CONNECTING
            _state = STATE_CONNECTING
            _connect4(result[0])
        else:
            if _sock6_state != STATE_RESOLVING:
                return
            if len(result) == 0:
                _on_dns_error(attempt, 6, "DNS lookup returned no IPv6 addresses")
                return
            _aaaa_res = result
            _sock6_state = STATE_CONNECTING
            _state = STATE_CONNECTING
            _connect6(result[0])

    def _on_dns_error(attempt: int, family: int, msg: str):
        if attempt != _attempt:
            return
        if family == 4 and _sock4_state != STATE_RESOLVING:
            return
        if family == 6 and _sock6_state != STATE_RESOLVING:
            return
        if _dns_error == "" or _dns_error == msg:
            _dns_error = msg
        else:
            _dns_error = _dns_error + "  " + msg
        _on_family_failed(family)

    action def _on_tcp_error(sockfamily: int, sock: int, err: int, errmsg: str):
        if sockfamily == 4:
            if sock != _sock4 or _sock4_state != STATE_CONNECTING:
                return
            _sock4_error = errmsg
        else:
            if sock != _sock6 or _sock6_state != STATE_CONNECTING:
                return
            _sock6_error = errmsg
        _on_family_failed(sockfamily)

    # An address family failed to resolve or connect, report the attempt as
    # failed unless the other family may still connect
    proc def _on_family_failed(family: int):
        if family == 4:
            _sock4 = -1
            _sock4_state = STATE_CLOSED
        else:
            _sock6 = -1
            _sock6_state = STATE_CLOSED
        if _sock4_state == STATE_RESOLVING or _sock4_state == STATE_CONNECTING:
            return
        if _sock6_state == STATE_RESOLVING or _sock6_state == STATE_CONNECTING:
            return
        # Prefer connect errors, a failed AAAA lookup is normal for a host
        # with only IPv4 addresses
        errmsg = _dns_error
        if _sock4_error != "" and _sock6_error != "":
            errmsg = _sock4_error + "  " + _sock6_error
        elif _sock4_error != "":
            errmsg = _sock4_error
        elif _sock6_error != "":
            errmsg = _sock6_error
        _attempt += 1
        _state = STATE_CLOSED
        _consecutive_connect_errors += 1
        on_error(self, errmsg)

    # TCP connect over IPv4
    proc def _connect4(ip_address: str):
        NotImplemented

    # TCP connect over IPv6
    proc def _connect6(ip_address: str):
        NotImplemented

    # Close the sockets of connection attempts in progress
    proc def _close_attempts():
        NotImplemented

    # Abandon the connection attempt in progress, if any
    proc def _abandon_attempt():
        _attempt += 1
        if _sock4_state != STATE_CONNECTED:
            _sock4_state = STATE_NONE
        if _sock6_state != STATE_CONNECTED:
            _sock6_state = STATE_NONE
        _close_attempts()

    action def _on_connect4(sock: int):
        if sock != _sock4 or _sock4_state != STATE_CONNECTING:
            # The attempt was abandoned and the socket closed
            return
        _sock4 = -1
        _sock4_state = STATE_CONNECTED
        _sock4_error = ""
        _on_connect(sock)

    action def _on_connect6(sock: int):
        if sock != _sock6 or _sock6_state != STATE_CONNECTING:
            # The attempt was abandoned and the socket closed
            return
        _sock6 = -1
        _sock6_state = STATE_CONNECTED
        _sock6_error = ""
        _on_connect(sock)

    # Handle on_connect event, the first address family to connect wins
    proc def _on_connect(sock: int):
        _abandon_attempt()
        _state = STATE_CONNECTED
        _sock = sock
        _read_start()
        _connections += 1
        _consecutive_connect_errors = 0
        on_connect(self)

    proc def _read_start():
        NotImplemented

    action def write(data: bytes) -> None:
        """Write data to remote"""
        NotImplemented

    action def close(on_close: action(TCPConnection) -> None) -> None:
        """Close the connection

        Data already written is sent before the connection is closed.
        Closing while the connection is being set up cancels the attempt,
        so neither on_connect nor on_error is called for it. on_close is
        called once the connection is closed.
        """
        _abandon_attempt()
        _state = STATE_CLOSED
        _close(on_close)

    proc def _close(on_close: action(TCPConnection) -> None) -> None:
        NotImplemented

    action def abort() -> None:
        """Close the connection with a TCP reset (RST)

        Unsent data is discarded and the peer sees the connection reset
        instead of an orderly close. Like close(), abort() cancels a
        connection attempt in progress.
        """
        _abandon_attempt()
        _state = STATE_CLOSED
        _abort()

    proc def _abort() -> None:
        NotImplemented

    def _connect_timeout(attempt: int):
        if attempt != _attempt:
            return
        if _state == STATE_RESOLVING or _state == STATE_CONNECTING:
            _abandon_attempt()
            _state = STATE_CLOSED
            _consecutive_connect_errors += 1
            on_error(self, "Connection attempt failed due to timeout")

    def reconnect():
        close(_connect)

    def _connect(c):
        _abandon_attempt()
        attempt = _attempt
        _a_res = []
        _aaaa_res = []
        _sock4_state = STATE_NONE
        _sock4_error = ""
        _sock6_state = STATE_NONE
        _sock6_error = ""
        _dns_error = ""
        after connect_timeout: _connect_timeout(attempt)
        if is_ipv4(address):
            _sock4_state = STATE_CONNECTING
            _state = STATE_CONNECTING
            _connect4(address)
        elif is_ipv6(address):
            _sock6_state = STATE_CONNECTING
            _state = STATE_CONNECTING
            _connect6(address)
        else:
            _state = STATE_RESOLVING
            _sock4_state = STATE_RESOLVING
            _sock6_state = STATE_RESOLVING
            def on_a_resolve(result: list[str]):
                _on_dns_resolve(attempt, 4, result)
            def on_a_error(name: str, msg: str):
                _on_dns_error(attempt, 4, msg)
            def on_aaaa_resolve(result: list[str]):
                _on_dns_resolve(attempt, 6, result)
            def on_aaaa_error(name: str, msg: str):
                _on_dns_error(attempt, 6, msg)
            _lookup_aaaa(address, on_aaaa_resolve, on_aaaa_error)
            # TODO: delay this by a few milliseconds to give IPv6 a slight preference
            _lookup_a(address, on_a_resolve, on_a_error)

    mut def __resume__() -> None:
        NotImplemented

    action def ip_version() -> ?int:
        NotImplemented

    action def local_address() -> str:
        NotImplemented

    action def remote_address() -> str:
        NotImplemented

    action def metrics():
        return (connections=_connections,
                consecutive_connect_errors=_consecutive_connect_errors,
                bytes_in=_bytes_in,
                bytes_out=_bytes_out)

    _connect(self)


actor TCPListenConnection(cap: _TCPListenConnectCap, server_client: int):
    """TCP Listener Connection

    A connection accepted by a TCPListener. Reading starts once callbacks are
    installed with cb_install(). on_error reports read and write errors, such
    as a connection reset by the peer, after which the connection is closed.
    on_remote_close reports that the peer closed the connection.
    """
    var client: int = -1
    var on_receive: ?action(TCPListenConnection, bytes) -> None = None
    var on_error: ?action(TCPListenConnection, str) -> None = None
    var on_remote_close: ?action(TCPListenConnection) -> None = None
    var _initialized = False

    proc def _read_start():
        """Implementation internal"""
        NotImplemented

    action def cb_install(new_on_receive: action(TCPListenConnection, bytes) -> None, new_on_error: action(TCPListenConnection, str) -> None, new_on_remote_close: ?action(TCPListenConnection) -> None=None) -> None:
        """Install callback handlers"""
        on_receive = new_on_receive
        on_error = new_on_error
        on_remote_close = new_on_remote_close
        if not _initialized:
            _read_start()
            _initialized = True

    action def close() -> None:
        """Close connection"""
        NotImplemented

    action def abort() -> None:
        """Close the connection with a TCP reset (RST)

        Unsent data is discarded and the peer sees the connection reset
        instead of an orderly close.
        """
        NotImplemented

    action def write(data: bytes) -> None:
        """Write data to remote"""
        NotImplemented

    mut def __resume__() -> None:
        NotImplemented

    proc def _init() -> None:
        """Implementation internal"""
        NotImplemented
    _init()

actor TCPListener(cap: TCPListenCap, address: str, port: int, on_listen: action(TCPListener, ?str) -> None, on_accept: action(TCPListenConnection) -> None):
    """TCP Listener

    Listens on address and port, where port 0 picks a free port, see
    local_port(). on_listen is called with None once listening, or with an
    error. Each accepted connection is passed to on_accept. close() stops
    listening, connections already accepted stay open.
    """
    var _stream = -1
    def create_tcp_listen_connection(cap: _TCPListenConnectCap, client: int):
        """Implementation internal"""
        c = TCPListenConnection(cap, client)
        if _stream == -1:
            # Accepted just before the listener was closed
            c.close()
            return
        on_accept(c)

    action def close() -> None:
        """Stop listening"""
        NotImplemented

    action def local_address() -> str:
        """Local address of the listening socket, "" when closed"""
        NotImplemented

    action def local_port() -> int:
        """Local port of the listening socket, 0 when closed"""
        NotImplemented

    mut def __resume__() -> None:
        NotImplemented

    proc def _init():
        """Implementation internal"""
        NotImplemented
    _init()

actor TLSListenConnection(cap: _TCPListenConnectCap, server_stream: int, tls_owner: int, worker_id: int):
    """TLS Listener Connection"""
    var _stream = -1
