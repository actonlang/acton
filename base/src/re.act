_empty_pattern_error = ValueError("empty pattern")


class Match:
    def __init__(self, pattern: str, string: str, start_pos: int, end_pos: int, group: list[?str], named_group: dict[str, ?str]) -> None:
        self.pattern = pattern
        self.string = string
        self.start_pos = start_pos
        self.end_pos = end_pos
        self.group = group
        self.named = named_group

def _compile(pattern: str) -> u64:
    """Compile pattern and return the address of its native code
    """
    NotImplemented

class Pattern(object):
    """A compiled regular expression

    The pattern is compiled once, when the Pattern is created, and each match
    uses the compiled code. A Pattern does not change after it is created, so
    it can be shared between actors.
    """
    pattern: str
    # TODO: A Pattern restored from the database keeps the address the code
    # had in the process that stored it. It needs a field type whose value is
    # serialized as NULL, so that _recompile can compile the code again.
    _code: u64

    def __init__(self, pattern: str) -> None:
        code = _compile(pattern)
        self.pattern = pattern
        self._code = code
        self._register_finalizer()

    def _recompile(self) -> None:
        """Compile the pattern again and replace the compiled code

        The previous code is released, so recompile a Pattern only before it
        is shared with other actors.
        """
        self._code = _compile(self.pattern)
        self._register_finalizer()

    def _register_finalizer(self) -> None:
        NotImplemented

    def _match(self, string: str, start_pos: int) -> ?Match:
        NotImplemented

    def match(self, string: str, start_pos: int=0) -> ?Match:
        """Scan through string looking for a match to the pattern, returning
        a match object, or None if no match was found. start_pos sets the
        index to begin scanning at.
        """
        return self._match(string, start_pos)

    def matches(self, string: str) -> list[Match]:
        """Find all non-overlapping matches in string
        """
        # TODO: implement as a generator instead
        res = []
        pos = 0
        str_len = len(string)
        while True:
            if pos >= str_len:
                break
            m = self._match(string, pos)
            if m is None:
                break
            if m is not None:
                res.append(m)
                if m.end_pos == m.start_pos:
                    # Zero-width match: move forward one character if possible
                    if m.end_pos < str_len:
                        pos = m.end_pos + 1
                    else:
                        # At the very end, just break
                        break
                else:
                    pos = m.end_pos
        return res

    def count(self, string: str) -> int:
        """Count non-overlapping matches.

        Uses the same matches as matches(), including its zero-width behavior.
        """
        NotImplemented

    def replace(self, string: str, replacement: str) -> str:
        """Replace each non-overlapping match with literal replacement text.

        Uses the same matches as matches(). Backslashes and group references
        in replacement are ordinary text.
        """
        NotImplemented

    def split(self, subject: str, max_split: int=0) -> list[str]:
        if self.pattern == "":
            raise _empty_pattern_error

        result = []
        splits_done = 0
        pos = 0
        str_len = len(subject)

        while True:
            if max_split != 0 and splits_done >= max_split:
                # Reached maximum number of splits
                break

            m = self._match(subject, pos)
            if m is not None:
                # Append substring before match (normal match)
                if m.end_pos > pos:
                    result.append(subject[pos:m.start_pos])
                    if len(m.group) > 1:
                        for g in m.group[1:]:
                            result.append(g if g is not None else "")
                    pos = m.end_pos
                    splits_done += 1
                else:
                    # Zero-width match
                    if pos == 0:
                        # At the start: append empty substring to indicate a split at the start
                        result.append(subject[pos:m.start_pos])
                    else:
                        # Not at the start: do not append empty substring
                        # If there are capturing groups, append them (if any)
                        if len(m.group) > 1:
                            for g in m.group[1:]:
                                result.append(g if g is not None else "")

                    # After handling zero-width match, break to avoid infinite loops
                    break
            else:
                # No match found
                break

        # Append remainder
        result.append(subject[pos:])
        return result

def compile(pattern: str) -> Pattern:
    """Compile pattern, to match it many times without compiling it again
    """
    return Pattern(pattern)

def _match(pattern: str, string: str, start_pos: int) -> ?Match:
    NotImplemented

def match(pattern: str, string: str, start_pos: int=0) -> ?Match:
    """Scan through string looking for a match to the pattern, returning
    a match object, or None if no match was found. start_pos sets the
    index to begin scanning at.
    """
    return _match(pattern, string, start_pos)

def matches(pattern: str, string: str) -> list[Match]:
    """Find all non-overlapping matches in string
    """
    return Pattern(pattern).matches(string)

def split(pattern: str, subject: str, max_split: int=0) -> list[str]:
    return Pattern(pattern).split(subject, max_split)

def count(pattern: str, string: str) -> int:
    """Count non-overlapping matches.
    """
    return Pattern(pattern).count(string)

def replace(pattern: str, string: str, replacement: str) -> str:
    """Replace each non-overlapping match with literal replacement text.
    """
    return Pattern(pattern).replace(string, replacement)
