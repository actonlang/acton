    507: b"Insufficient Storage",
    508: b"Loop Detected",
    510: b"Not Extended (OBSOLETED)",
    511: b"Network Authentication Required"
}


def build_request(host: str, method: bytes, path: bytes, version: bytes, headers: dict[str, str], body: bytes) -> bytes:
    r = [ method + b" " + path + b" HTTP/" + version ]
    lheaders: dict[str, str] = {}
    for k in headers:
        lheaders[k.lower()] = k

    if "host" not in lheaders:
        headers["Host"] = host
    if "user-agent" not in lheaders:
        headers["User-Agent"] = "Acton HTTP Client"
    if "accept" not in lheaders:
        headers["Accept"] = "*/*"
#    if "accept-encoding" not in lheaders:
#        headers["Accept-Encoding"] = "gzip, deflate"
    if "connection" not in lheaders:
        headers["Connection"] = "keep-alive"
    if "content-length" not in lheaders:
        headers["Content-Length"] = str(len(body))

    for k, v in headers.items():
        r.append(k.encode() + b": " + v.encode())

    r.append(b"\r\n")
    res = b"\r\n".join(r)
    if len(body) > 0:
        res += body
    return res


def build_response(version: bytes, status: int, headers: dict[str, str], body: str):
    b = body.encode()
    # TODO: Add Connection?
    status_line: bytes = b"HTTP/" + version + b" " + str(status).encode()
    if status in responses:
        status_line += b" " + responses[status]

    r = [ status_line ]
    header_keys = [k.lower() for k in headers.keys()]
    if "server" not in header_keys:
        headers["Server"] = "Acton HTTP Server"
    if "content-type" not in header_keys:
        headers["Content-Type"] = "text/html; charset=utf-8"
    if "date" not in header_keys:
        headers["Date"] = time.now().str_rfc1123()

    for k, v in headers.items():
        if k.lower() == "content-length":
            # Disregard content-length, we'll compute it from body length
            continue
        r.append(k.encode() + b": " + v.encode())

    r.append(b"Content-Length: " + str(len(b)).encode())
    r.append(b"\r\n")
    res = b"\r\n".join(r)
    if len(b) > 0:
       res += b

    return res


class Message(object):
    def __init__(self, start_line: bytes, headers: dict[str, str], body: bytes):
        self.start_line = start_line
        self.headers = headers
        self.body = body


class Request(object):
    @property
    method: str
    @property
    path: str
    @property
    version: bytes
    @property
    headers: dict[str, str]
    @property
    body: bytes

    def __init__(self, method: str, path: str, version: bytes, headers: dict[str, str], body: bytes):
        self.method = method
        self.path = path
        self.version = version
        self.headers = headers
        self.body = body

    def __str__(self):
        return f"<http.Request {self.method} {self.path} {str(self.version)} {self.headers.__str__()} {str(self.body)}>"

extension Request(Eq):
    def __eq__(self, other):
        return self.method == other.method and self.path == other.path and self.version == other.version and self.headers == other.headers and self.body == other.body


class Response(object):
    @property
    version: bytes
    @property
    status: int
    @property
    headers: dict[str, str]
    @property
    body: bytes

    def __init__(self, version: bytes, status: int, headers: dict[str, str], body: bytes) -> None:
        self.version = version
        self.status = status
        self.headers = headers
        self.body = body

    def __str__(self) -> str:
        return f"<http.Response {self.status}>"

    def decode_json(self):
        return json.decode(self.body.decode())

extension Response(Eq):
    def __eq__(self, other):
        return self.version == other.version and self.status == other.status and self.headers == other.headers and self.body == other.body


# MessageParser states
_ST_HEADERS    = 0  # waiting for the end of a header block
_ST_BODY       = 1  # inside a Content-Length body, _remaining bytes still to come
_ST_CHUNK_SIZE = 2  # waiting for the end of a chunk-size line
_ST_CHUNK_DATA = 3  # inside chunk data, _remaining bytes still to come
_ST_CHUNK_END  = 4  # waiting for the CRLF that ends a chunk
_ST_TRAILER    = 5  # after the last chunk, waiting for the end of a trailer line

class MessageParser(object):
    """Incremental HTTP/1.1 message parser

    feed(data) consumes the bytes of a connection as they arrive and returns
    the messages they complete, in order. Between calls the parser remembers
    where it is: inside a header block, inside a body of known length or
    inside a chunked body. Bytes are not searched or copied again when more
    data arrives, so a message costs time linear in its size, however many
    reads deliver it and however many chunks it consists of.

    When the input is not a valid HTTP/1.1 message, error is set to a
    description of the problem. feed() still returns the messages completed
    before the malformed one. From then on it returns no messages, because
    where the following messages begin is unknown.
    """
    error: ?str
    _state: int
    _remaining: int              # bytes left of the body or of the current chunk
    _partial: list[bytes]        # the incomplete header block or line, in pieces
    _partial_len: int
    _start_line: bytes
    _headers: dict[str, str]
    _body_parts: list[bytes]     # body of the message under construction, joined once at the end

    def __init__(self):
        self.error = None
        self._state = _ST_HEADERS
        self._remaining = 0
        self._partial = []
        self._partial_len = 0
        self._start_line = b""
        self._headers = {}
        self._body_parts = []

    def feed(self, data: bytes) -> list[Message]:
        """Consume data and return the messages completed by it"""
        msgs: list[Message] = []
        if self.error is not None:
            return msgs
        try:
            self._parse(data, msgs)
        except ValueError as e:
            self.error = e.error_message
            self._partial = []
            self._partial_len = 0
            self._body_parts = []
        return msgs

    def _parse(self, data: bytes, msgs: list[Message]) -> None:
        n = len(data)
        pos = 0
        while True:
            if self._state == _ST_HEADERS:
                if self._partial_len == 0:
                    # Empty lines before a start line are ignored
                    while data[pos:pos + 2] == b"\r\n":
                        pos += 2
                if pos >= n:
                    break
                head, pos = self._take(data, pos, b"\r\n\r\n")
                if head is not None:
                    while head.startswith(b"\r\n"):
                        head = head[2:]
                    if len(head) > 0:
                        self._begin_message(head)
                else:
                    break
            elif self._state == _ST_BODY or self._state == _ST_CHUNK_DATA:
                avail = n - pos
                if avail < self._remaining:
                    # Take what is here and wait for the rest
                    if avail > 0:
                        self._body_parts.append(data if pos == 0 else data[pos:])
                        self._remaining -= avail
                    break
                if self._remaining > 0:
                    self._body_parts.append(data[pos:pos + self._remaining])
                    pos += self._remaining
                    self._remaining = 0
                if self._state == _ST_BODY:
                    msgs.append(self._finish())
                else:
                    self._state = _ST_CHUNK_END
            elif self._state == _ST_CHUNK_SIZE:
                line, pos = self._take(data, pos, b"\r\n")
                if line is not None:
                    size = parse_chunk_size(line)
                    if size == 0:
                        self._state = _ST_TRAILER
                    else:
                        self._remaining = size
                        self._state = _ST_CHUNK_DATA
                else:
                    break
            elif self._state == _ST_CHUNK_END:
                line, pos = self._take(data, pos, b"\r\n")
                if line is not None:
                    if len(line) > 0:
                        raise _chunk_end_error
                    self._state = _ST_CHUNK_SIZE
                else:
                    break
            elif self._state == _ST_TRAILER:
                line, pos = self._take(data, pos, b"\r\n")
                if line is not None:
                    # Trailer fields are ignored, the empty line ends the message
                    if len(line) == 0:
                        msgs.append(self._finish())
                else:
                    break
            else:
                raise _unreachable_error

    def _take(self, data: bytes, pos: int, delim: bytes) -> (?bytes, int):
        # Return the element that ends at the next delim, which may have
        # started in earlier reads, and the position after delim. Without a
        # delim, keep the rest of data as part of the element and return
        # None. Only data is searched, plus a window of len(delim) - 1 bytes
        # on either side of the boundary with the bytes kept from before.
        k = len(delim)
        if self._partial_len > 0:
            tail = self._partial_tail(k - 1)
            i = (tail + data[pos:pos + k - 1]).find(delim)
            if i >= 0:
                elem = b"".join(self._partial)[:self._partial_len - len(tail) + i]
                self._partial = []
                self._partial_len = 0
                return elem, pos + i + k - len(tail)
        end = data.find(delim, pos)
        if end < 0:
            if pos < len(data):
                piece = data if pos == 0 else data[pos:]
                self._partial.append(piece)
                self._partial_len += len(piece)
            return None, len(data)
        elem = data[pos:end]
        if self._partial_len > 0:
            self._partial.append(elem)
            elem = b"".join(self._partial)
            self._partial = []
            self._partial_len = 0
        return elem, end + k

    def _partial_tail(self, m: int) -> bytes:
        # The last m bytes kept of the incomplete element, or all of them
        tail = b""
        i = len(self._partial) - 1
        while len(tail) < m and i >= 0:
            piece = self._partial[i]
            need = m - len(tail)
            if len(piece) > need:
                piece = piece[len(piece) - need:]
            tail = piece + tail
            i -= 1
        return tail

    def _begin_message(self, head: bytes) -> None:
        # head is the header block without the terminating empty line
        lines = head.split(b"\r\n", None)
        self._start_line = lines[0]
        values: dict[str, list[str]] = {}
        for line in lines[1:]:
            colon = line.find(b":")
            if colon <= 0:
                raise _header_field_error
            name = line[:colon]
            # A field name is a token. This also rejects whitespace before
            # the colon and lines folded onto the previous one.
            for c in name:
                if c not in _TOKEN_CHARS:
                    raise _header_field_error
            hname = name.lower().decode()
            hvalue = ""
            try:
                hvalue = line[colon + 1:].decode().strip(" \t")
            except ValueError:
                raise _header_field_error
            if hname in values:
                values[hname].append(hvalue)
            else:
                values[hname] = [hvalue]
        # A field repeated on several lines means the same as one line with
        # the values joined by commas, except Set-Cookie, which cannot be
        # joined and keeps its last value
        headers: dict[str, str] = {}
        for hname, hvalues in values.items():
            headers[hname] = hvalues[-1] if hname == "set-cookie" else ", ".join(hvalues)
        self._headers = headers
        self._body_parts = []
        self._remaining = 0

        tenc = headers.get("transfer-encoding")
        clen = headers.get("content-length")
        if tenc is not None:
            if clen is not None:
                raise _framing_conflict_error
            # The version is the first word of a status line and the last
            # word of a request line
            words = self._start_line.split(b" ", None)
            version = words[0] if words[0].startswith(b"HTTP/") else words[-1]
            if version == b"HTTP/1.0":
                raise _http10_transfer_encoding_error
            codings = tenc.split(",", None)
            if len(codings) != 1 or codings[0].strip(" \t").encode().lower() != b"chunked":
                raise _transfer_encoding_error
            self._state = _ST_CHUNK_SIZE
        else:
            if clen is not None:
                self._remaining = parse_content_length(clen)
            # Without framing fields there is no body, and _ST_BODY with
            # nothing remaining completes the message right away
            self._state = _ST_BODY

    def _finish(self) -> Message:
        parts = self._body_parts
        body = parts[0] if len(parts) == 1 else b"".join(parts)
        msg = Message(self._start_line, self._headers, body)
        self._state = _ST_HEADERS
        self._remaining = 0
        self._start_line = b""
        self._headers = {}
        self._body_parts = []
        return msg


def parse_content_length(value: str) -> int:
    """The body length given by a Content-Length field value

    The value is a decimal number, or a comma-separated list of the same
    number when the field was repeated. Raises ValueError for anything else.
    """
    length = -1
    for item in value.split(",", None):
        item = item.strip(" \t")
        if len(item) == 0:
            raise _content_length_error
        for c in item:
            if c not in "0123456789":
                raise _content_length_error
        n = int(item)
        if length >= 0 and n != length:
            raise _content_length_error
        length = n
    return length


def parse_chunk_size(line: bytes) -> int:
    """The chunk size given by a chunk-size line without its CRLF

    The size is a hexadecimal number. A chunk extension after it is ignored.
    Raises ValueError for anything else.
    """
    semi = line.find(b";")
    if semi >= 0:
        line = line[:semi].rstrip(b" \t")
    if len(line) == 0:
        raise _chunk_size_error
    for c in line:
        if not ((c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)):
            raise _chunk_size_error
    return int(line.decode(), 16)


def request_from_message(msg: Message) -> Request:
    """The request a parsed message carries

    Raises ValueError when the start line is not a valid HTTP/1.0 or HTTP/1.1
    request line.
    """
    slparts = msg.start_line.split(b" ", None)
    if len(slparts) != 3:
        # HTTP request must have exactly 3 parts: METHOD PATH HTTP/VERSION
        raise _request_line_error
    method = ""
    path = ""
    try:
        method = slparts[0].decode()
        path = slparts[1].decode()
    except ValueError:
        raise _request_line_error
    verparts = slparts[2].split(b"/", 1)
    if len(verparts) != 2:
        # TODO: actually HTTP 0.9 might only have 2 parts, but we don't support that
        raise _request_line_error
    version = verparts[1]
    if version != b"1.1" and version != b"1.0":
        raise _http_version_error
    return Request(method, path, version, msg.headers, msg.body)


def response_from_message(msg: Message) -> Response:
    """The response a parsed message carries

    Raises ValueError when the start line is not a valid HTTP/1.0 or HTTP/1.1
    status line.
    """
    slparts = msg.start_line.split(b" ", None)
    if len(slparts) < 2:
        # HTTP response must have at least 2 parts: HTTP/VERSION STATUS_CODE [REASON_PHRASE]
        raise _status_line_error
    verparts = slparts[0].split(b"/", 1)
    if len(verparts) != 2:
        raise _status_line_error
    version = verparts[1]
    if version != b"1.1" and version != b"1.0":
        raise _http_version_error
    status = 0
    try:
        status = int(slparts[1].decode())
    except ValueError:
        raise _status_line_error
    return Response(version, status, msg.headers, msg.body)


def connection_options(headers: dict[str, str]) -> list[str]:
    """The options listed in the Connection header field, in lower case"""
    value = headers.get("connection")
    if value is not None:
        # Options are tokens, so only ASCII letters are folded
        return [o.strip(" \t").encode().lower().decode() for o in value.split(",", None)]
    return []



actor Server(conn: net.TCPListenConnection, on_accept: action(Server) -> None, log_handler: ?logging.Handler=None):
    """Server serves a single client connection

    User callbacks are invoked asynchronously and the server does not wait
    for them, so a callback is free to call back into this actor. Responses
    are sent on the connection in request order. A response to a
    later request is held back until the responses to all earlier requests
    have been sent.
    """
    _log = logging.Logger(log_handler)
    var on_request_cb: ?action(Server, Request, action(int, dict[str, str], str) -> None) -> None = None
    var on_error_cb: ?action(Server, str) -> None = None
    var version: ?bytes = None
    var query_count: u64 = 0
    var response_count: u64 = 0
    var outstanding_responses: dict[u64, (int, dict[str, str], str)] = {}
    # Id of the request whose response ends the connection, 0 while there is none
    var close_after: u64 = 0
    _parser = MessageParser()
    # Set when the client sent something that is not a valid request
    var _bad_input: bool = False
    # Requests received but not yet handed to the request handler
    var _requests: list[Request] = []

    def cb_install(new_on_request: action(Server, Request, action(int, dict[str, str], str) -> None) -> None, new_on_error: action(Server, str) -> None):
        on_request_cb = new_on_request
        on_error_cb = new_on_error
        # Dispatch any requests that arrived before the callbacks were installed
        _dispatch()

    def on_conn_receive(conn_obj, data: bytes) -> None:
        if close_after != 0 or _bad_input:
            # No further requests are processed on a connection that is closing
            return
        msgs = _parser.feed(data)
        failure = _parser.error
        for msg in msgs:
            try:
                _requests.append(request_from_message(msg))
            except ValueError as e:
                failure = e.error_message
                break
        if failure is not None:
            _log.notice("Malformed HTTP request, closing the connection", {"error": failure})
            _bad_input = True
        _dispatch()

    def _dispatch() -> None:
        while on_request_cb is not None and close_after == 0 and len(_requests) > 0:
            req = _requests[0]
            del _requests[0]
            _handle_request(req)
        if _bad_input and close_after == 0 and len(_requests) == 0:
            # Answer the requests received before the malformed input, then close
            if response_count == query_count:
                conn.close()
            else:
                close_after = query_count

    def _handle_request(req: Request):
        if version is None:
            version = req.version
        elif version is not None and version != req.version:
            _log.debug("Version mismatch", None)
            conn.close()

        query_count += 1
        req_id = query_count
        # The server does not keep HTTP/1.0 connections alive
        if req.version == b"1.0" or "close" in connection_options(req.headers):
            _log.debug("Closing the connection after responding to this request", None)
            close_after = req_id
            _requests = []

        def respond(status_code: int, headers: dict[str, str], body: str):
            _log.trace("Going to respond to query", {"query_id": req_id})
            if req_id == response_count + 1:
                # In order, send response immediately
                _log.trace("Sending response immediately", None)
                send_response(status_code, headers, body)
                response_count += 1
                # Send buffered responses that are next in line
                while response_count + 1 in outstanding_responses:
                    nxt = outstanding_responses[response_count + 1]
                    del outstanding_responses[response_count + 1]
                    send_response(nxt.0, nxt.1, nxt.2)
                    response_count += 1
                if response_count == close_after:
                    conn.close()
            elif req_id > response_count + 1 and req_id not in outstanding_responses:
                # Responses must go out in request order, so buffer this one
                # until responses to all earlier requests have been sent
                _log.trace("Buffering response", None)
                outstanding_responses[req_id] = (status_code, headers, body)
            else:
                _log.notice("Duplicate response to query, ignoring", None)

        if on_request_cb is not None:
            on_request_cb(self, req, respond)
        else:
            _log.notice("No on_request callback set", None)

    def on_conn_error(conn, error):
        # TODO: the conn should really be in here, but type error!?
        _log.trace(f"There was an error: {str(error)} from: {str("")}", None)

    def close():
        conn.close()

    def send_response(status_code: int, headers: dict[str, str], data: str):
        if version is not None:
            res = build_response(version, status_code, headers, data)
            conn.write(res)


actor TLSServer(conn: net.TLSListenConnection, on_accept: action(TLSServer) -> None, log_handler: ?logging.Handler=None):
    """Server serves a single TLS client connection

    User callbacks are invoked asynchronously and the server does not wait
    for them, so a callback is free to call back into this actor. Responses
    are sent on the connection in request order. A response to a
    later request is held back until the responses to all earlier requests
    have been sent.
    """
    _log = logging.Logger(log_handler)
    var on_request_cb: ?action(TLSServer, Request, action(int, dict[str, str], str) -> None) -> None = None
    var on_error_cb: ?action(TLSServer, str) -> None = None
    var version: ?bytes = None
    var query_count: u64 = 0
    var response_count: u64 = 0
    var outstanding_responses: dict[u64, (int, dict[str, str], str)] = {}
    # Id of the request whose response ends the connection, 0 while there is none
    var close_after: u64 = 0
    _parser = MessageParser()
    # Set when the client sent something that is not a valid request
    var _bad_input: bool = False
    # Requests received but not yet handed to the request handler
    var _requests: list[Request] = []

    def cb_install(new_on_request: action(TLSServer, Request, action(int, dict[str, str], str) -> None) -> None, new_on_error: action(TLSServer, str) -> None):
        on_request_cb = new_on_request
        on_error_cb = new_on_error
        # Dispatch any requests that arrived before the callbacks were installed
        _dispatch()

    def on_conn_receive(conn_obj, data: bytes) -> None:
        if close_after != 0 or _bad_input:
            # No further requests are processed on a connection that is closing
            return
        msgs = _parser.feed(data)
        failure = _parser.error
        for msg in msgs:
            try:
                _requests.append(request_from_message(msg))
            except ValueError as e:
                failure = e.error_message
                break
        if failure is not None:
            _log.notice("Malformed HTTP request, closing the connection", {"error": failure})
            _bad_input = True
        _dispatch()

    def _dispatch() -> None:
        while on_request_cb is not None and close_after == 0 and len(_requests) > 0:
            req = _requests[0]
            del _requests[0]
            _handle_request(req)
        if _bad_input and close_after == 0 and len(_requests) == 0:
            # Answer the requests received before the malformed input, then close
            if response_count == query_count:
                conn.close()
            else:
                close_after = query_count

    def _handle_request(req: Request):
        if version is None:
            version = req.version
        elif version is not None and version != req.version:
            _log.debug("Version mismatch", None)
            conn.close()

        query_count += 1
        req_id = query_count
        # The server does not keep HTTP/1.0 connections alive
        if req.version == b"1.0" or "close" in connection_options(req.headers):
            _log.debug("Closing the connection after responding to this request", None)
            close_after = req_id
            _requests = []

        def respond(status_code: int, headers: dict[str, str], body: str):
            _log.trace("Going to respond to query", {"query_id": req_id})
            if req_id == response_count + 1:
                # In order, send response immediately
                _log.trace("Sending response immediately", None)
                send_response(status_code, headers, body)
                response_count += 1
                # Send buffered responses that are next in line
                while response_count + 1 in outstanding_responses:
                    nxt = outstanding_responses[response_count + 1]
                    del outstanding_responses[response_count + 1]
                    send_response(nxt.0, nxt.1, nxt.2)
                    response_count += 1
                if response_count == close_after:
                    conn.close()
            elif req_id > response_count + 1 and req_id not in outstanding_responses:
                # Responses must go out in request order, so buffer this one
                # until responses to all earlier requests have been sent
                _log.trace("Buffering response", None)
                outstanding_responses[req_id] = (status_code, headers, body)
            else:
                _log.notice("Duplicate response to query, ignoring", None)

        if on_request_cb is not None:
            on_request_cb(self, req, respond)
        else:
            _log.notice("No on_request callback set", None)

    def on_conn_error(conn, error):
        # TODO: the conn should really be in here, but type error!?
        _log.trace(f"There was an error: {str(error)} from: {str("")}", None)

    def close():
        conn.close()

    def send_response(status_code: int, headers: dict[str, str], data: str):
        if version is not None:
            res = build_response(version, status_code, headers, data)
            conn.write(res)


# TODO: change port to u16, when u16 has a sub-type relationship to int
# TODO: the on_listen_error default should be some action that just automatically retries with a backoff
# TODO: add restart method to restart the listener
actor Listener(cap: net.TCPListenCap, address: str, port: int, on_accept: action(Server) -> None, on_listen_error: ?action(net.TCPListener, str) -> None = None, log_handler: ?logging.Handler = None):
    """HTTP Server Listener"""
    _log = logging.Logger(log_handler)
    var bufs = []

    def on_conn_listen(listener, error):
        if error is not None:
            _log.notice("There was an error with the listener socket", {"error": error})
            if on_listen_error is not None:
                on_listen_error(listener, error)

    def on_listener_accept(conn):
        s = Server(conn, on_accept, log_handler)
        on_accept(s)
        conn.cb_install(s.on_conn_receive, s.on_conn_error, None)

    var _listener = net.TCPListener(cap, address, port, on_conn_listen, on_listener_accept)


# TODO: change port to u16, when u16 has a sub-type relationship to int
# TODO: the on_listen_error default should be some action that just automatically retries with a backoff
# TODO: add restart method to restart the listener
actor TLSListener(cap: net.TCPListenCap, address: str, port: int, cert_pem: bytes, key_pem: bytes, on_accept: action(TLSServer) -> None, on_listen_error: ?action(net.TLSListener, str) -> None = None, log_handler: ?logging.Handler = None):
    """HTTPS Server Listener"""
    _log = logging.Logger(log_handler)
    var bufs = []

    def on_conn_listen(listener, error):
        if error is not None:
            _log.notice("There was an error with the listener socket", {"error": error})
            if on_listen_error is not None:
                on_listen_error(listener, error)

    def on_listener_accept(conn):
        s = TLSServer(conn, on_accept, log_handler)
        on_accept(s)
        conn.cb_install(s.on_conn_receive, s.on_conn_error, None)

    var _listener = net.TLSListener(cap, address, port, cert_pem, key_pem, on_conn_listen, on_listener_accept)


# TODO: change port to u16, when u16 has a sub-type relationship to int
actor Client(cap: net.TCPConnectCap, address: str, on_connect: action(Client) -> None, on_error: action(Client, str) -> None, scheme: str="https", port: ?int=None, tls_verify: bool=True, log_handler: ?logging.Handler=None):
    """HTTP(S) Client

    scheme is either 'http' or 'https', the default is 'https'
    port is optional, if not provided, it will be inferred from the scheme where http=80 and https=443

    User callbacks (on_connect, on_error and the per-request on_response) are
    invoked asynchronously and the client does not wait for them, so a
    callback is free to call back into this actor, e.g. to issue the next
    request. The on_response callbacks are invoked in request order.
    Callbacks of one actor run in that order, while callbacks of different
    actors may run concurrently.
    """
    _log = logging.Logger(log_handler)
    # Outstanding requests, oldest first: request bytes and callback
    var _on_response: list[(bytes, action(Client, Response) -> None)] = []
    var version: ?bytes = None
    var _parser = MessageParser()
    var _connected: bool = False
    var tcp_conn: ?net.TCPConnection = None
    var tls_conn: ?net.TLSConnection = None

    def _connect():
        _connected = False
        if scheme == "http":
            _log.verbose("Using http scheme and port 80", None)
            tcp_port = port if port is not None else 80
            tcp_conn = net.TCPConnection(cap, address, tcp_port, _on_tcp_connect, _on_tcp_receive, _on_tcp_error, None, connect_timeout=10.0)
        elif scheme == "https":
            _log.verbose("Using https scheme and port 443", None)
            tls_port = port if port is not None else 443
            tls_conn = net.TLSConnection(cap, address, tls_port, _on_tls_connect, _on_tls_receive, _on_tls_error, None, tls_verify)
        else:
            raise ValueError(f"Only http and https schemes are supported. Unsupported scheme: {scheme}")

    def _on_conn_connect():
        # Requests issued while there was no connection, or that were not
        # answered before a reconnect, are sent now, in order. A new
        # connection starts a new byte stream.
        _parser = MessageParser()
        _connected = True
        for r in _on_response:
            _conn_write(r.0)
        on_connect(self)

    def _on_tcp_connect(conn: net.TCPConnection) -> None:
        _on_conn_connect()

    def _on_tls_connect(conn: net.TLSConnection) -> None:
        _on_conn_connect()

    def _on_tcp_receive(conn: net.TCPConnection, data: bytes) -> None:
        _on_con_receive(data)

    def _on_tls_receive(conn: net.TLSConnection, data: bytes) -> None:
        _on_con_receive(data)

    def _on_con_receive(data: bytes) -> None:
        if not _connected:
            # Data that arrives after the client gave up on the connection
            return
        _log.debug("Received data", {"bytes": len(data)})
        msgs = _parser.feed(data)
        failure = _parser.error
        for msg in msgs:
            r = None
            try:
                r = response_from_message(msg)
            except ValueError as e:
                failure = e.error_message
                break
            if r is not None:
                if len(_on_response) == 0:
                    _log.notice("Data received with no on_response callback set", None)
                    break
                outreq = _on_response[0]
                del _on_response[0]
                cb = outreq.1

                cb(self, r)
                if "close" in connection_options(r.headers):
                    # The server closes the connection after this response,
                    # so whatever else this read holds is not a response
                    _log.debug("Closing TCP connection due to header: Connection: close", None)
                    _conn_close()
                    _connect()
                    return
        if failure is not None:
            _log.notice("Malformed HTTP response, closing connection", {"error": failure})
            _conn_close()
            _on_con_error("Malformed HTTP response: " + failure)

    def _on_tcp_error(conn: net.TCPConnection, error: str) -> None:
        _on_con_error(error)

    def _on_tls_error(conn: net.TLSConnection, error: str) -> None:
        _on_con_error(error)

    def _on_con_error(error: str) -> None:
        _connected = False
        on_error(self, error)

    def _conn_close() -> None:
        _connected = False
        if tcp_conn is not None:
            def _noop(c):
                pass
            tcp_conn.close(_noop)
        elif tls_conn is not None:
            def _noop(c):
                pass
            tls_conn.close(_noop)

    def _conn_write(data: bytes) -> None:
        _log.trace("Sending data", {"bytes": len(data)})
        if tcp_conn is not None:
            tcp_conn.write(data)
        elif tls_conn is not None:
            tls_conn.write(data)

    def close():
        _conn_close()

    def _send_request(req: bytes, on_response: action(Client, Response) -> None) -> None:
        _on_response.append((req, on_response))
        if _connected:
            _conn_write(req)

    # HTTP methods
    def get(path: str, on_response: action(Client, Response) -> None, headers: dict[str, str] = {}):
        req = build_request(address, b"GET", path.encode(), b"1.1", headers, b"")
        _log.debug("Sending request", {"method": "GET", "path": path})
        _send_request(req, on_response)

    def head(path: str, on_response: action(Client, Response) -> None, headers: dict[str, str] = {}):
        req = build_request(address, b"HEAD", path.encode(), b"1.1", headers, b"")
        _log.debug("Sending request", {"method": "HEAD", "path": path})
        _send_request(req, on_response)

    def post(path: str, body: bytes, on_response: action(Client, Response) -> None, headers: dict[str, str] = {}):
        if "Content-Type" not in headers:
            headers["Content-Type"] = "application/x-www-form-urlencoded"
        req = build_request(address, b"POST", path.encode(), b"1.1", headers, body)
        _log.debug("Sending request", {"method": "POST", "path": path})
        _send_request(req, on_response)

    def put(path: str, body: bytes, on_response: action(Client, Response) -> None, headers: dict[str, str] = {}):
        req = build_request(address, b"PUT", path.encode(), b"1.1", headers, body)
        _log.debug("Sending request", {"method": "PUT", "path": path})
        _send_request(req, on_response)

    def delete(path: str, on_response: action(Client, Response) -> None, headers: dict[str, str] = {}):
        req = build_request(address, b"DELETE", path.encode(), b"1.1", headers, b"")
        _log.debug("Sending request", {"method": "DELETE", "path": path})
        _send_request(req, on_response)

    _connect()
