import logging

import testing

import std.testing.runner
actor MathTester ():
    T_17w def add (a : T_5w, b : T_9w) -> T_13w:
        return a + b

T_21w def _test_foo () -> None:
    pass

# recursive group:
actor _test_SimpleSyncTester ():
    proc def __startup__ () -> T_25w:
        m = MathTester()
        print("SimpleSyncTester.test()")
        testing.assertEqual(m.add(1, 2), 3, "1 + 2 = 3")
actor _SyncTester (t : testing.SyncT):
    proc def __startup__ () -> T_31w:
        log = logging.Logger(t.log_handler)
        m = MathTester()
        log.info("SyncTester.test()")
        print("SyncTester.test()")
        testing.assertEqual(m.add(1, 2), 3, "1 + 2 = 3")
actor _SyncTesterCore ():
    proc def __startup__ () -> T_39w:
        m = MathTester()
        print("SimpleSyncTester.test()")
        testing.assertEqual(m.add(1, 2), 3, "1 + 2 = 3")
# (recursive group)

T_49w def _test_simple_sync () -> T_45w:
    s = _SyncTesterCore()

T_59w def _test_sync (t : testing.SyncT) -> T_55w:
    m = MathTester()
    return str(m.add(1, 2))

# recursive group:
actor AsyncTester (t : testing.AsyncT):
    proc def __startup__ () -> T_65w:
        log = logging.Logger(t.log_handler)
        T_75w def test () -> T_71w:
            log.info("AsyncTester.test()", {"data": "test"})
            t.success()
        after 0: test()
actor EnvTester (t : testing.EnvT):
    proc def __startup__ () -> T_79w:
        log = logging.Logger(t.log_handler)
        T_89w def test () -> T_85w:
            log.info("EnvTester.test() wthreads:", {"nr_wthreads": t.env.nr_wthreads})
            print("EnvTester.test() wthreads:", t.env.nr_wthreads)
            t.success()
        after 0: test()
# (recursive group)