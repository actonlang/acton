# CodeGen regression fixture for allocation-free explicit iteration.
def first(items: list[str]) -> ?str:
    it = iter(items)
    item = next(it)
    if isinstance(item, just):
        return item.val
    return None

# Production and consumption need not be adjacent, and the tag test may be
# part of a larger condition.  The iterator expression is also evaluated once
# into a generated C temporary rather than requiring a source-level binding.
def separated(items: list[str], wanted: str) -> ?str:
    item = next(iter(items))
    same = True
    if isinstance(item, just) and same:
        if item.val == wanted:
            return item.val
    return None

def identity_maybe(x: maybe[str]) -> maybe[str]:
    return x

# An otherwise unsupported use materializes an ordinary value-semantic maybe.
def materialized(items: list[str]) -> maybe[str]:
    item = next(iter(items))
    return identity_maybe(item)

def range_value(stop: int) -> int:
    it = iter(range(stop))
    item = next(it)
    same = True
    if isinstance(item, just) and same:
        return item.val + 1
    return -1

def identity_maybe_int(x: maybe[int]) -> maybe[int]:
    return x

def identity_iterator_int(x: Iterator[int]) -> Iterator[int]:
    return x

# A range-backed local casts back to its declared iterator representation when
# it crosses an ordinary call boundary.
def escaped_range(stop: int) -> ?int:
    it = iter(range(stop))
    generic = identity_iterator_int(it)
    item = next(generic)
    if isinstance(item, just):
        return item.val
    return None

# Direct range iteration keeps its payload raw until a boxed maybe is needed.
def materialized_range(stop: int) -> maybe[int]:
    item = next(iter(range(stop)))
    return identity_maybe_int(item)

# Definite range arguments use the raw runtime constructor.  The three loops
# also exercise stack storage for Normalizer's private for-loop iterators.
def raw_ranges(start: int, stop: int, step: int) -> int:
    total = 0
    heap1 = range(stop)
    heap2 = range(start, stop)
    heap3 = range(start, stop, step)
    for i in range(stop):
        total += i
    for i in range(start, stop):
        total += i
    for i in range(start, stop, step):
        total += i
    return total

# An inner for-loop has its iterator declaration hoisted ahead of the branch
# that initializes it.  It should still use automatic range storage rather
# than allocate a new range for every outer-loop iteration.
def nested_ranges(rows: int, width: int) -> int:
    total = 0
    for row in range(rows):
        for column in range(width + row):
            total += column
    return total

# Returning a tagged maybe local from __next__ forwards its tag and payload
# through the iterator bool/out ABI without materializing just or nothing.
class forwarding_iterator(Iterator[int]):
    def __init__(self, inner: Iterator[int]):
        self.inner = inner

    def __next__(self) -> maybe[int]:
        item = self.inner.__next__()
        if isinstance(item, just):
            return item
        return nothing()

class direct_forwarding_iterator(Iterator[int]):
    def __init__(self, inner: Iterator[int]):
        self.inner = inner

    def __next__(self) -> maybe[int]:
        return self.inner.__next__()
