# CodeGen regression fixture.
#
# A `for` loop used to be compiled with setjmp/longjmp-based StopIteration
# handling. A local that was declared before the loop, assigned inside the loop
# body and read after the loop then had to be emitted as C `volatile`; otherwise
# C11 left its value indeterminate after the longjmp and optimizing builds could
# roll it back.
#
# Non-throwing iteration now lowers the loop to a bool/out __next__ call instead,
# so the codegen test asserts the direct call shape and that the obsolete
# StopIteration longjmp scaffolding is absent.
def loop_marker(items: list[str], needle: str) -> ?str:
    marker: ?str = None
    for x in items:
        if x == needle:
            marker = x
    return marker
