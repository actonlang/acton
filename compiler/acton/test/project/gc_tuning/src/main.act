import acton.rts
import shared

def check(page_hash_log2: int, generational: bool) -> int:
    NotImplemented

actor main(env):
    log2 = int(env.argv[1])
    generational = env.argv[2] == "true"

    records = shared.make()
    assert check(log2, generational) == 0

    info = acton.rts.get_gc_info(env.syscap)
    # The collector is built with the manual dirty-bit mode only, whose bits
    # the write barrier sets
    assert info.backend == ("manual" if generational else "none")
    assert "manual" in info.supported_backends
    assert "mprotect" not in info.supported_backends
    assert "soft_dirty" not in info.supported_backends
    assert "userfaultfd" not in info.supported_backends
    assert info.page_hash_table_log2 == u64(log2 if log2 else 21)
    assert info.markers == 2
    assert info.free_space_divisor == 5
    assert info.full_frequency == 7
    assert info.heap_size > 0
    assert info.heap_size >= info.free_bytes
    assert info.free_bytes >= info.unmapped_bytes

    if generational:
        # Steps of the default 50 ms
        assert info.mode == "generational"
        assert info.pause_target_ms is not None
        assert info.pause_target_ms! == 50.0
    else:
        assert info.mode == "ordinary"
        assert info.pause_target_ms is None

    assert shared.verify(records) == 256
    print("GC tuning OK")
    env.exit(0)
