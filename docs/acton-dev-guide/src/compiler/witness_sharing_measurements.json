    "source": "import acton.rts\n\nclass Bucket[T(Eq)](object):\n    marker: int\n    def __init__(self):\n        self.marker = 0\n    def same(self, x: T, y: T) -> bool:\n        return x == y\n\ndef take(b: Bucket[list[int]] = Bucket()) -> Bucket[list[int]]:\n    return b\n\ndef take_generic[T(Eq)](b: Bucket[list[T]] = Bucket()) -> Bucket[list[T]]:\n    return b\n\ndef compare_generic[T(Eq)](xs: list[T], ys: list[T]) -> bool:\n    return take_generic().same(xs, ys) and take_generic().same(xs, ys)\n\ndef compare(xs: list[int], ys: list[int]) -> bool:\n    return take().same(xs, ys) and take().same(xs, ys)\n\nclass Pair(object):\n    left: Bucket[list[int]]\n    right: Bucket[list[int]]\n    def __init__(self, left: Bucket[list[int]], right: Bucket[list[int]]):\n        self.left = left\n        self.right = right\n\ndef pair(flag: bool) -> Pair:\n    left = take()\n    if flag:\n        right = take()\n    else:\n        right = take()\n    return Pair(left, right)\n\nactor main(env):\n    n = int(env.argv[1]) if len(env.argv) > 1 else 1000000\n    xs = [1, 2, 3]\n    ys = [1, 2, 3]\n    assert compare_generic(xs, ys)\n    assert compare_generic([\"x\"], [\"x\"])\n    assert not compare_generic([\"x\"], [\"y\"])\n    assert not compare(xs, [9])\n    original = pair(True)\n    second = pair(False)\n    assert second.left.same(xs, ys) and second.right.same(xs, ys)\n    payload = serialize(original)\n    restored = deserialize(payload)\n    assert serialize(restored) == payload\n    assert isinstance(restored, Pair)\n    if isinstance(restored, Pair):\n        assert restored.left.same(xs, ys)\n        assert not restored.right.same(xs, [9])\n        restored.left.marker = 17\n        assert restored.right.marker == 0\n    before = acton.rts.get_gc_total_bytes(env.syscap)\n    ok = True\n    for _ in range(n):\n        ok = compare(xs, ys) and ok\n    allocated_after = acton.rts.get_gc_total_bytes(env.syscap)\n    print(ok, allocated_after - before)\n    env.exit(0)\n",
    "source_sha256": "e9e7926b92bfb0174a68451457a324073c7c42f6c63f91412c69b564572be83d"
