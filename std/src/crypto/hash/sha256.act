"""SHA-256 hashing

SHA-256 maps data of any length to a digest of 32 bytes. The same data always
gives the same digest, and no practical way is known to find two different
inputs with the same digest.

    digest = sha256.hash(b"abc")
    print(digest.hex())

A Hasher takes data that arrives in pieces. The digest depends only on the
bytes and their order, not on how they were split into pieces:

    h = sha256.Hasher()
    h.update(b"a")
    h.update(b"bc")
    digest = h.finalize()

A digest is 32 bytes. digest.hex() gives the usual text form of 64 hexadecimal
digits.

SHA-256 has no key, so anyone can compute the digest of any data. A digest
shows that data is unchanged only when the digest itself comes from a trusted
place. Do not store passwords as SHA-256 digests: SHA-256 is fast, which makes
guessing passwords fast too.
"""

DIGEST_SIZE = 32

class Hasher(object):
    """Computes the SHA-256 digest of data given in pieces"""
    _hasher: u64

    def __init__(self):
        """Start with no data"""
        self._hasher = 0
        self._init()

    def _init(self):
        """Allocate the hashing state, in C and Zig"""
        NotImplemented

    mut def update(self, data: bytes) -> None:
        """Add data after the data given so far"""
        NotImplemented

    def finalize(self) -> bytes:
        """Return the 32-byte digest of the data given so far

        The hasher is unchanged: update can add more data, and finalize then
        returns the digest of all of it.
        """
        NotImplemented

def hash(data: bytes) -> bytes:
    """Return the 32-byte SHA-256 digest of data"""
    NotImplemented
