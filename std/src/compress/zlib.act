"""Compression in the zlib format, RFC 1950"""

def compress(data: bytes) -> bytes:
    """data compressed in the zlib format, at the default level

    Raises ValueError when the data cannot be compressed.
    """
    NotImplemented


def decompress(data: bytes) -> bytes:
    """data decompressed from the zlib format

    Raises ValueError when data is not in the zlib format.
    """
    NotImplemented
